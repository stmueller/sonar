## INSTRUCTIONS
## ============================================================

define ShowBlockInstructions(blockCfg, clickLbl)
{
    instrText <- blockCfg.instructions

    ## Wider / taller box + larger base font (was 16pt — too small for HTML-lite body text).
    tbW <- Round(gVideoWidth * 0.72)
    tbH <- Round(gVideoHeight * 0.62)
    tbX <- Round((gVideoWidth - tbW) / 2)
    tbY <- Round(gVideoHeight * 0.05)
    instrFontSz <- 22

    tb <- EasyTextBox(instrText, tbX, tbY, gWin, instrFontSz, tbW, tbH)
    SetProperty(tb, "FORMATTED", 1)

    AddObject(clickLbl, gWin)
    Move(clickLbl, Round(gVideoWidth/2), Round(tbY + tbH + 28))

    Draw()
    WaitForClickOnTarget([clickLbl], [1])

    RemoveObject(tb, gWin)
    RemoveObject(clickLbl, gWin)
    Draw()
}


## Set persistent task-rule reminder at top of screen for current block.
define SetTaskRule(ruleText)
{
    gRuleHUD.text <- ruleText
    Draw()
}


## Clear task-rule reminder between blocks.
define ClearTaskRule()
{
    gRuleHUD.text <- ""
    Draw()
}


define ShowSignalCue(blockCfg)
{
    if(blockCfg.signal_cue == 1)
    {
        Show(gSignalLbl)
    }
}


define HideSignalCue()
{
    Hide(gSignalLbl)
}


define TwoAFCVessels(vessels)
{
    leftV  <- Nth(vessels, 1)
    rightV <- Nth(vessels, 1)
    if(Length(vessels) >= 2) { rightV <- Nth(vessels, 2) }
    nLeft  <- 0
    nRight <- 0
    loop(v, vessels)
    {
        if(v.response_side == "left")  { leftV <- v; nLeft <- nLeft + 1 }
        if(v.response_side == "right") { rightV <- v; nRight <- nRight + 1 }
    }
    if(nLeft != 1 or nRight != 1)
    {
        leftV  <- Nth(vessels, 1)
        rightV <- Nth(vessels, 1)
        if(Length(vessels) >= 2) { rightV <- Nth(vessels, 2) }
    }
    return([leftV, rightV])
}


define TwoAFCSideNames(vessels)
{
    pair <- TwoAFCVessels(vessels)
    leftV  <- First(pair)
    rightV <- Second(pair)
    return([leftV.name, rightV.name])
}


define SimonSideNames(vessels)
{
    return(TwoAFCSideNames(vessels))
}


## Match battery/simon: gParams.responselabels are the choice names
## (not LEFT/RIGHT), so layout targets read "LEFT-SHIFT for Mechanical".
define ApplyTwoAFCLayoutLabels(vessels)
{
    names <- TwoAFCSideNames(vessels)
    gParams.responselabels <- names
    if(gLayout2AFCReady == 1)
    {
        displayLabels <- FormatLabelsForMode(gLayout2AFC.responseMode, names)
        i <- 1
        loop(l, gLayout2AFC.responseLabels)
        {
            if(i <= Length(displayLabels))
            {
                l.text <- Nth(displayLabels, i)
            }
            i <- i + 1
        }
    }
}


## timeout 0 = wait forever. Otherwise returns vessel id or "<timeout>".
## inputMode: "mouse" | "keyboard" | "auto" | "either"
##   mouse  → click vessel thumbs/buttons
##   keyboard → number keys 1..N in vessel-list order (or 2AFC layout when ready)
##   auto   → 2AFC layout if ready, else mouse click (legacy)
##   either → same as mouse for identification (click targets)
define CollectVesselResponse(vessels, showThumbnails, timeout:0, inputMode:"auto")
{
    resp <- "<timeout>"
    useLayout <- 0
    if(Length(vessels) == 2 and gLayout2AFCReady == 1)
    {
        if(inputMode == "auto" or inputMode == "keyboard") { useLayout <- 1 }
    }

    if(useLayout == 1)
    {
        pair <- TwoAFCVessels(vessels)
        side <- WaitForLayoutResponse(gLayout2AFC, timeout)
        ClearEventLoop()
        if(side == "left")
        {
            chosen <- First(pair)
            resp <- chosen.id
        }
        if(side == "right")
        {
            chosen <- Second(pair)
            resp <- chosen.id
        }
    } else {
        if(inputMode == "keyboard")
        {
            ## Number-row 1..N maps to vessels in list order.
            keys <- []
            ids  <- []
            i <- 1
            loop(v, vessels)
            {
                PushOnEnd(keys, "" + i)
                PushOnEnd(ids, v.id)
                i <- i + 1
            }
            key <- WaitForListKeyPress(keys)
            resp <- Nth(ids, 1)
            ki <- 1
            loop(k, keys)
            {
                if(k == key) { resp <- Nth(ids, ki) }
                ki <- ki + 1
            }
        } else {
            btnData <- BuildButtons(vessels, showThumbnails)
            if(timeout > 0)
            {
                resp <- WaitForClickOnTargetWithTimeout(First(btnData), Second(btnData), timeout)
            } else {
                resp <- WaitForClickOnTarget(First(btnData), Second(btnData))
            }
        }
    }
    return(resp)
}


define BuildSimonRuleText(vessels)
{
    names <- SimonSideNames(vessels)
    return("LEFT <- " + First(names) + "   |   " + Second(names) + " -> RIGHT")
}


## ============================================================
## CONFIG LOADING
## ============================================================

## Build a default signal_params object so blocks can omit fields.
## jitter_sd: percent of narrowband row width (Hz). See JitterSdHz / MakeJitteredSig.
define DefaultSignalParams()
{
    p <- MakeCustomObject("sigparams")
    p.jitter_sd        <- 10
    p.jitter_trunc_sd  <- 1.5
    p.jitter_min_sep   <- 15
    p.n_noise_min      <- 1
    p.n_noise_max      <- 3
    p.n_mimic          <- 2
    p.p_show           <- 0.75
    return(p)
}


## Build a default payoff object.
define DefaultPayoff()
{
    p <- MakeCustomObject("payoff")
    p.hit  <- 10
    p.miss <- -5
    p.fa   <- -3
    p.cr   <- 0
    return(p)
}


## Merge JSON signal_params into a params object, using defaults for missing fields.
define MergeSignalParams(jsonParams)
{
    p <- DefaultSignalParams()
    if(IsCustomObject(jsonParams))
    {
        if(PropertyExists(jsonParams, "jitter_sd"))       { p.jitter_sd       <- jsonParams.jitter_sd }
        if(PropertyExists(jsonParams, "jitter_trunc_sd")) { p.jitter_trunc_sd <- jsonParams.jitter_trunc_sd }
        if(PropertyExists(jsonParams, "jitter_min_sep"))  { p.jitter_min_sep  <- jsonParams.jitter_min_sep }
        if(PropertyExists(jsonParams, "n_noise_min"))     { p.n_noise_min     <- jsonParams.n_noise_min }
        if(PropertyExists(jsonParams, "n_noise_max"))     { p.n_noise_max     <- jsonParams.n_noise_max }
        if(PropertyExists(jsonParams, "n_mimic"))         { p.n_mimic         <- jsonParams.n_mimic }
        if(PropertyExists(jsonParams, "p_show"))          { p.p_show          <- jsonParams.p_show }
    }
    return(p)
}


## Shallow copy of a signal_params object (field-by-field).
define CopySignalParams(src)
{
    p <- DefaultSignalParams()
    p.jitter_sd       <- src.jitter_sd
    p.jitter_trunc_sd <- src.jitter_trunc_sd
    p.jitter_min_sep  <- src.jitter_min_sep
    p.n_noise_min     <- src.n_noise_min
    p.n_noise_max     <- src.n_noise_max
    p.n_mimic         <- src.n_mimic
    p.p_show          <- src.p_show
    return(p)
}


## Start from block-level params; overlay any fields present on jsonPartial.
## Used by noise_profiles so unspecified fields inherit the block signal_params.
define OverlaySignalParams(base, jsonPartial)
{
    p <- CopySignalParams(base)
    if(IsCustomObject(jsonPartial))
    {
        if(PropertyExists(jsonPartial, "jitter_sd"))       { p.jitter_sd       <- jsonPartial.jitter_sd }
        if(PropertyExists(jsonPartial, "jitter_trunc_sd")) { p.jitter_trunc_sd <- jsonPartial.jitter_trunc_sd }
        if(PropertyExists(jsonPartial, "jitter_min_sep"))  { p.jitter_min_sep  <- jsonPartial.jitter_min_sep }
        if(PropertyExists(jsonPartial, "n_noise_min"))     { p.n_noise_min     <- jsonPartial.n_noise_min }
        if(PropertyExists(jsonPartial, "n_noise_max"))     { p.n_noise_max     <- jsonPartial.n_noise_max }
        if(PropertyExists(jsonPartial, "n_mimic"))         { p.n_mimic         <- jsonPartial.n_mimic }
        if(PropertyExists(jsonPartial, "p_show"))          { p.p_show          <- jsonPartial.p_show }
    }
    return(p)
}


## Build a block config object from a parsed JSON block entry.
## taskId passed in from top-level config.
define BuildBlockCfg(jsonBlock, taskId)
{
    b <- MakeCustomObject("blockcfg")
    b.task_id <- taskId
    b.id      <- jsonBlock.id

    if(PropertyExists(jsonBlock, "label"))
    {
        b.label <- jsonBlock.label
    } else {
        b.label <- jsonBlock.id
    }

    if(PropertyExists(jsonBlock, "instructions"))
    {
        b.instructions <- jsonBlock.instructions
    } else {
        b.instructions <- "<h3>Round: " + jsonBlock.id + "</h3>"
    }

    b.rule_text <- ""
    if(PropertyExists(jsonBlock, "rule_text"))
    {
        b.rule_text <- jsonBlock.rule_text
    }

    if(PropertyExists(jsonBlock, "trials"))
    {
        b.trials <- jsonBlock.trials
    } else {
        b.trials <- 10
    }

    if(PropertyExists(jsonBlock, "base_rate"))
    {
        b.base_rate <- jsonBlock.base_rate
    } else {
        b.base_rate <- 0.5
    }

    ## Optional multinomial class rates aligned with vessels[] order.
    ## When present and length matches n vessels, PickVessel uses these instead of base_rate.
    ## Prefer vessel_counts (exact integers + shuffle) for regularized designs; rates remain
    ## for contexts that want pure probabilistic sampling.
    b.has_vessel_rates <- 0
    b.vessel_rates <- []
    if(PropertyExists(jsonBlock, "vessel_rates"))
    {
        b.vessel_rates <- jsonBlock.vessel_rates
        b.has_vessel_rates <- 1
    }

    ## Exact per-class trial counts in vessels[] order, e.g. [5, 10, 5].
    ## When set, BuildTrialCaseList builds that multiset, Shuffles, and syncs b.trials
    ## to the sum. Takes precedence over vessel_rates for scheduling.
    b.has_vessel_counts <- 0
    b.vessel_counts <- []
    if(PropertyExists(jsonBlock, "vessel_counts"))
    {
        b.vessel_counts <- jsonBlock.vessel_counts
        b.has_vessel_counts <- 1
        sumC <- 0
        loop(c, b.vessel_counts) { sumC <- sumC + c }
        if(sumC > 0) { b.trials <- sumC }
    }

    if(PropertyExists(jsonBlock, "signal_mode"))
    {
        b.signal_mode <- jsonBlock.signal_mode
        ## Normalize spelling: "jitter" → "jittered"
        if(b.signal_mode == "jitter") { b.signal_mode <- "jittered" }
    } else {
        b.signal_mode <- "clean"
    }

    if(PropertyExists(jsonBlock, "signal_params"))
    {
        b.signal_params <- MergeSignalParams(jsonBlock.signal_params)
    } else {
        b.signal_params <- DefaultSignalParams()
    }
    ## Snapshot for restore after per-case noise_profiles overrides.
    b.default_signal_params <- CopySignalParams(b.signal_params)

    ## Optional per-case noise profiles. Each entry is a partial signal_params
    ## plus count (exact # of base cases). Overrides block signal_params fields
    ## that are present; unspecified fields inherit the block. Implies case list.
    b.has_noise_profiles <- 0
    b.noise_profiles <- []
    if(PropertyExists(jsonBlock, "noise_profiles"))
    {
        sumP <- 0
        pIdx <- 1
        loop(jp, jsonBlock.noise_profiles)
        {
            prof <- OverlaySignalParams(b.signal_params, jp)
            cnt <- 0
            if(PropertyExists(jp, "count")) { cnt <- jp.count }
            if(cnt < 1)
            {
                SignalFatalError("noise_profiles[" + pIdx + "] needs count >= 1 (block " + b.id + ")")
            }
            prof.count <- cnt
            sumP <- sumP + cnt
            PushOnEnd(b.noise_profiles, prof)
            pIdx <- pIdx + 1
        }
        if(Length(b.noise_profiles) > 0)
        {
            b.has_noise_profiles <- 1
            if(b.has_vessel_counts == 1)
            {
                if(sumP != b.trials)
                {
                    SignalFatalError("noise_profiles counts sum (" + sumP + ") != vessel_counts sum (" + b.trials + ") in block " + b.id)
                }
            } else {
                if(sumP > 0) { b.trials <- sumP }
            }
        }
    }

    if(PropertyExists(jsonBlock, "response_mode"))
    {
        b.response_mode <- jsonBlock.response_mode
    } else {
        b.response_mode <- "choice"
    }

    if(PropertyExists(jsonBlock, "display"))
    {
        b.display <- jsonBlock.display
    } else {
        b.display <- gTaskDisplay
    }

    if(PropertyExists(jsonBlock, "isi"))
    {
        b.isi <- jsonBlock.isi
    } else {
        b.isi <- 500
    }

    ## Go/no-go parameters
    if(b.response_mode == "gonogo")
    {
        if(PropertyExists(jsonBlock, "gonogo_go_vessel"))
        {
            b.gonogo_go_vessel <- jsonBlock.gonogo_go_vessel
        } else {
            b.gonogo_go_vessel <- 1
        }
        if(PropertyExists(jsonBlock, "gonogo_response_window"))
        {
            b.gonogo_response_window <- jsonBlock.gonogo_response_window
        } else {
            b.gonogo_response_window <- 1000
        }
    } else {
        b.gonogo_go_vessel       <- 1
        b.gonogo_response_window <- 1000
    }

    if(PropertyExists(jsonBlock, "feedback"))
    {
        b.feedback <- jsonBlock.feedback
    } else {
        b.feedback <- "accuracy"
    }

    ## Keep waterfall visible through feedback (compare to refs / identity label).
    b.feedback_keep_stim <- 0
    if(PropertyExists(jsonBlock, "feedback_keep_stim"))
    {
        b.feedback_keep_stim <- jsonBlock.feedback_keep_stim
    }
    ## On incorrect: wait for click-anywhere before advancing (inspect error).
    b.feedback_error_click <- 0
    if(PropertyExists(jsonBlock, "feedback_error_click"))
    {
        b.feedback_error_click <- jsonBlock.feedback_error_click
    }

    ## Scoring mode: "none" | "outcome" (hit/miss/fa/cr table) | "confidence"
    ## (points from payoff_*_by_conf after rating). Independent of feedback text.
    b.scoring <- "none"
    if(PropertyExists(jsonBlock, "scoring")) { b.scoring <- jsonBlock.scoring }

    if(PropertyExists(jsonBlock, "payoff_hit"))
    {
        b.payoff_hit  <- jsonBlock.payoff_hit
        b.payoff_miss <- jsonBlock.payoff_miss
    } else {
        b.payoff_hit  <- 10
        b.payoff_miss <- -5
    }
    if(PropertyExists(jsonBlock, "payoff_fa"))
    {
        b.payoff_fa <- jsonBlock.payoff_fa
    } else {
        b.payoff_fa <- -5
    }
    if(PropertyExists(jsonBlock, "payoff_cr"))
    {
        b.payoff_cr <- jsonBlock.payoff_cr
    } else {
        b.payoff_cr <- 0
    }

    ## Confidence payoff tables (1-indexed by confidence level). Asymmetric OK.
    ## If incorrect omitted, losses are the negation of correct (symmetric).
    b.payoff_correct_by_conf <- []
    b.payoff_incorrect_by_conf <- []
    if(PropertyExists(jsonBlock, "payoff_correct_by_conf"))
    {
        b.payoff_correct_by_conf <- jsonBlock.payoff_correct_by_conf
        if(b.scoring == "none") { b.scoring <- "confidence" }
    }
    if(PropertyExists(jsonBlock, "payoff_incorrect_by_conf"))
    {
        b.payoff_incorrect_by_conf <- jsonBlock.payoff_incorrect_by_conf
    } else {
        if(Length(b.payoff_correct_by_conf) > 0)
        {
            loop(p, b.payoff_correct_by_conf)
            {
                PushOnEnd(b.payoff_incorrect_by_conf, 0 - p)
            }
        }
    }

    ## Secretary / optimal stopping parameters
    if(PropertyExists(jsonBlock, "secretary_n_contacts"))
    {
        b.secretary_n_contacts <- jsonBlock.secretary_n_contacts
    } else {
        b.secretary_n_contacts <- 5
    }
    if(PropertyExists(jsonBlock, "secretary_target_rate"))
    {
        b.secretary_target_rate <- jsonBlock.secretary_target_rate
    } else {
        b.secretary_target_rate <- 0.33
    }
    if(PropertyExists(jsonBlock, "secretary_min_sep"))
    {
        b.secretary_min_sep <- jsonBlock.secretary_min_sep
    } else {
        b.secretary_min_sep <- 45
    }

    if(PropertyExists(jsonBlock, "allow_defer"))
    {
        b.allow_defer <- jsonBlock.allow_defer
    } else {
        b.allow_defer <- 0
    }
    if(PropertyExists(jsonBlock, "defer_cost"))
    {
        b.defer_cost <- jsonBlock.defer_cost
    } else {
        b.defer_cost <- 0
    }
    if(PropertyExists(jsonBlock, "miss_cost"))
    {
        b.miss_cost <- jsonBlock.miss_cost
    } else {
        b.miss_cost <- 0
    }

    ## Cued task parameters
    if(PropertyExists(jsonBlock, "cue_validity"))
    {
        b.cue_validity <- jsonBlock.cue_validity
    } else {
        b.cue_validity <- 0.8
    }
    if(PropertyExists(jsonBlock, "cue_duration"))
    {
        b.cue_duration <- jsonBlock.cue_duration
    } else {
        b.cue_duration <- 500
    }
    if(PropertyExists(jsonBlock, "cue_soa"))
    {
        b.cue_soa <- jsonBlock.cue_soa
    } else {
        b.cue_soa <- 500
    }

    ## Thumbnail visibility (default on; set false for probrev/blind tasks)
    if(PropertyExists(jsonBlock, "show_thumbnails"))
    {
        b.show_thumbnails <- jsonBlock.show_thumbnails
    } else {
        b.show_thumbnails <- 1
    }

    ## Reversal parameters
    if(PropertyExists(jsonBlock, "reversal_criterion"))
    {
        b.reversal_criterion <- jsonBlock.reversal_criterion
    } else {
        b.reversal_criterion <- 10
    }
    if(PropertyExists(jsonBlock, "reversal_max"))
    {
        b.reversal_max <- jsonBlock.reversal_max
    } else {
        b.reversal_max <- 0
    }
    if(PropertyExists(jsonBlock, "p_flip_feedback"))
    {
        b.p_flip_feedback <- jsonBlock.p_flip_feedback
    } else {
        b.p_flip_feedback <- 0.0
    }
    ## correct_vessel: which vessel id is currently correct (mutable during reversal)
    if(PropertyExists(jsonBlock, "correct_vessel"))
    {
        b.correct_vessel <- jsonBlock.correct_vessel
    } else {
        b.correct_vessel <- 1
    }

    ## signal_vessel_id: which vessel is the signal (target) for fa/cr scoring in 2-AFC payoff.
    ## 0 = no designation (all trials scored as hit/miss only).
    if(PropertyExists(jsonBlock, "signal_vessel_id"))
    {
        b.signal_vessel_id <- jsonBlock.signal_vessel_id
    } else {
        b.signal_vessel_id <- 0
    }

    ## Secretary signal noise params
    b.p_show        <- 0.9
    b.p_leak        <- 0.0
    b.p_alpha_leak  <- 0.0
    b.sig_jitter    <- 30
    b.p_close_foil  <- 0.5
    b.close_foil_min <- 60
    b.close_foil_max <- 150
    if(PropertyExists(jsonBlock, "p_show"))        { b.p_show        <- jsonBlock.p_show }
    if(PropertyExists(jsonBlock, "p_leak"))         { b.p_leak        <- jsonBlock.p_leak }
    if(PropertyExists(jsonBlock, "p_alpha_leak"))   { b.p_alpha_leak  <- jsonBlock.p_alpha_leak }
    if(PropertyExists(jsonBlock, "sig_jitter"))     { b.sig_jitter    <- jsonBlock.sig_jitter }
    if(PropertyExists(jsonBlock, "p_close_foil"))   { b.p_close_foil  <- jsonBlock.p_close_foil }
    if(PropertyExists(jsonBlock, "close_foil_min")) { b.close_foil_min <- jsonBlock.close_foil_min }
    if(PropertyExists(jsonBlock, "close_foil_max")) { b.close_foil_max <- jsonBlock.close_foil_max }

    ## Confidence rating: if 1, CollectConfidence() fires after response (choice mode only for now)
    b.collect_confidence <- 0
    if(PropertyExists(jsonBlock, "collect_confidence")) { b.collect_confidence <- jsonBlock.collect_confidence }
    ## Scale size for CollectConfidence (4 = legacy 1/2/9/0; 5 = 1–5). Default 4.
    b.confidence_levels <- 4
    if(PropertyExists(jsonBlock, "confidence_levels")) { b.confidence_levels <- jsonBlock.confidence_levels }

    ## Input modality: "mouse" | "keyboard" | "auto" | "either"
    ## Task-level defaults in gResponseInput / gConfidenceInput; block may override.
    b.response_input <- gResponseInput
    if(PropertyExists(jsonBlock, "response_input")) { b.response_input <- jsonBlock.response_input }
    b.confidence_input <- gConfidenceInput
    if(PropertyExists(jsonBlock, "confidence_input")) { b.confidence_input <- jsonBlock.confidence_input }

    ## RNG seed: SeedRNG at block start for reproducible stimulus sequences.
    ## Prefer "randomseed"; "seed" kept as alias for older configs.
    b.seed <- 0
    b.randomseed <- 0
    if(PropertyExists(jsonBlock, "seed"))
    {
        b.seed <- jsonBlock.seed
        b.randomseed <- jsonBlock.seed
    }
    if(PropertyExists(jsonBlock, "randomseed"))
    {
        b.randomseed <- jsonBlock.randomseed
        b.seed <- jsonBlock.randomseed
    }

    ## How many times to present the base trial set via ShuffleRepeat (default 1 = no case list).
    b.repetitions <- 1
    if(PropertyExists(jsonBlock, "repetitions")) { b.repetitions <- jsonBlock.repetitions }
    if(b.repetitions < 1) { b.repetitions <- 1 }

    b.starting_score <- 0
    if(PropertyExists(jsonBlock, "starting_score")) { b.starting_score <- jsonBlock.starting_score }

    b.burn_in <- 0
    if(PropertyExists(jsonBlock, "burn_in")) { b.burn_in <- jsonBlock.burn_in }

    b.signal_cue <- 0
    if(PropertyExists(jsonBlock, "signal_cue")) { b.signal_cue <- jsonBlock.signal_cue }

    b.forced_vessel_id <- 0
    b.forced_template_idx <- 0
    b.has_forced_sig <- 0
    b.forced_sig <- []
    ## Stimulus-case id for aligning ShuffleRepeat duplicates (see LogTrial).
    b.instance_id <- 0

    ## Urns / directional inference parameters
    b.urn_east_rate  <- 0.7
    b.urn_bearing_sd  <- 20
    b.urn_draw_limit  <- 12
    b.urn_draw_cost   <- 0
    b.urn_correct_pts <- 100
    b.urn_wrong_pts   <- -100
    if(PropertyExists(jsonBlock, "urn_east_rate"))  { b.urn_east_rate  <- jsonBlock.urn_east_rate }
    if(PropertyExists(jsonBlock, "urn_bearing_sd"))  { b.urn_bearing_sd  <- jsonBlock.urn_bearing_sd }
    if(PropertyExists(jsonBlock, "urn_draw_limit"))  { b.urn_draw_limit  <- jsonBlock.urn_draw_limit }
    if(PropertyExists(jsonBlock, "urn_draw_cost"))   { b.urn_draw_cost   <- jsonBlock.urn_draw_cost }
    if(PropertyExists(jsonBlock, "urn_correct_pts")) { b.urn_correct_pts <- jsonBlock.urn_correct_pts }
    if(PropertyExists(jsonBlock, "urn_wrong_pts"))   { b.urn_wrong_pts   <- jsonBlock.urn_wrong_pts }

    ## Horizon / explore-exploit parameters
    b.horizon_free_trials  <- 1
    b.horizon_info         <- "equal"
    b.horizon_forced_isi   <- 600
    b.horizon_hi_mean      <- 60
    b.horizon_lo_mean      <- 40
    b.horizon_pay_sd       <- 20
    if(PropertyExists(jsonBlock, "horizon_free_trials"))  { b.horizon_free_trials  <- jsonBlock.horizon_free_trials }
    if(PropertyExists(jsonBlock, "horizon_info"))         { b.horizon_info         <- jsonBlock.horizon_info }
    if(PropertyExists(jsonBlock, "horizon_forced_isi"))   { b.horizon_forced_isi   <- jsonBlock.horizon_forced_isi }
    if(PropertyExists(jsonBlock, "horizon_hi_mean"))      { b.horizon_hi_mean      <- jsonBlock.horizon_hi_mean }
    if(PropertyExists(jsonBlock, "horizon_lo_mean"))      { b.horizon_lo_mean      <- jsonBlock.horizon_lo_mean }
    if(PropertyExists(jsonBlock, "horizon_pay_sd"))       { b.horizon_pay_sd       <- jsonBlock.horizon_pay_sd }

    ## SABART (BART analog): constant intel per WAIT; hidden sink breakpoint
    b.sabart_points_per_wait <- 5
    b.sabart_min_waits       <- 0
    b.sabart_vessel          <- 0
    if(PropertyExists(jsonBlock, "sabart_points_per_wait")) { b.sabart_points_per_wait <- jsonBlock.sabart_points_per_wait }
    if(PropertyExists(jsonBlock, "sabart_min_waits"))       { b.sabart_min_waits       <- jsonBlock.sabart_min_waits }
    if(PropertyExists(jsonBlock, "sabart_vessel"))          { b.sabart_vessel          <- jsonBlock.sabart_vessel }

    ## SFT / dual-channel 2AFC
    b.audio_level <- "hi"
    b.visual_level <- "hi"
    b.use_noise_overlay <- 1
    b.channel <- "both"
    b.adaptive <- 0
    b.adapt_window <- 10
    b.adapt_min_correct <- 8
    b.adapt_hi_steps <- 2
    b.adapt_levels <- [0, 6, 12, 18, 24, 32, 42, 54, 68]
    if(PropertyExists(jsonBlock, "audio_level")) { b.audio_level <- jsonBlock.audio_level }
    if(PropertyExists(jsonBlock, "visual_level")) { b.visual_level <- jsonBlock.visual_level }
    if(PropertyExists(jsonBlock, "use_noise_overlay")) { b.use_noise_overlay <- jsonBlock.use_noise_overlay }
    if(PropertyExists(jsonBlock, "channel")) { b.channel <- jsonBlock.channel }
    if(PropertyExists(jsonBlock, "adaptive")) { b.adaptive <- jsonBlock.adaptive }
    if(PropertyExists(jsonBlock, "adapt_window")) { b.adapt_window <- jsonBlock.adapt_window }
    if(PropertyExists(jsonBlock, "adapt_min_correct")) { b.adapt_min_correct <- jsonBlock.adapt_min_correct }
    if(PropertyExists(jsonBlock, "adapt_hi_steps")) { b.adapt_hi_steps <- jsonBlock.adapt_hi_steps }
    if(PropertyExists(jsonBlock, "adapt_levels"))
    {
        if(IsList(jsonBlock.adapt_levels) == 1) { b.adapt_levels <- jsonBlock.adapt_levels }
    }
    if(b.channel == "audio" and PropertyExists(jsonBlock, "adapt_levels") == 0)
    {
        b.adapt_levels <- [1.0, 0.72, 0.52, 0.38, 0.27, 0.19, 0.14, 0.10]
    }

    ## Kaernbach staircase params for adaptive blocks.
    ## sc_min/max_level default to first/last element of adapt_levels at runtime.
    ## Storing 0 here signals "use adapt_levels range".
    b.sc_target_p       <- 0.75
    b.sc_step_divisor   <- 20
    b.sc_min_level      <- 0
    b.sc_max_level      <- 0
    b.sc_start_level    <- 0
    b.sc_stop_reversals <- 12
    b.sc_skip_first     <- 4
    b.sc_stuck_window   <- 20
    ## sc_hi_level: fixed easy level used after calibration (-1 = use built-in default).
    b.sc_hi_level       <- -1
    b.sc_max_trials     <- 80
    if(PropertyExists(jsonBlock, "sc_target_p"))       { b.sc_target_p       <- jsonBlock.sc_target_p }
    if(PropertyExists(jsonBlock, "sc_step_divisor"))   { b.sc_step_divisor   <- jsonBlock.sc_step_divisor }
    if(PropertyExists(jsonBlock, "sc_min_level"))      { b.sc_min_level      <- jsonBlock.sc_min_level }
    if(PropertyExists(jsonBlock, "sc_max_level"))      { b.sc_max_level      <- jsonBlock.sc_max_level }
    if(PropertyExists(jsonBlock, "sc_start_level"))    { b.sc_start_level    <- jsonBlock.sc_start_level }
    if(PropertyExists(jsonBlock, "sc_stop_reversals")) { b.sc_stop_reversals <- jsonBlock.sc_stop_reversals }
    if(PropertyExists(jsonBlock, "sc_skip_first"))     { b.sc_skip_first     <- jsonBlock.sc_skip_first }
    if(PropertyExists(jsonBlock, "sc_stuck_window"))   { b.sc_stuck_window   <- jsonBlock.sc_stuck_window }
    if(PropertyExists(jsonBlock, "sc_hi_level"))       { b.sc_hi_level       <- jsonBlock.sc_hi_level }
    if(PropertyExists(jsonBlock, "sc_max_trials"))     { b.sc_max_trials     <- jsonBlock.sc_max_trials }

    ## Method-of-limits (MOL) audio calibration params.
    b.mol_levels            <- [1.0, 0.5, 0.25, 0.125, 0.063, 0.031, 0.016]
    b.mol_fine_step         <- 1.059
    b.mol_fine_start_factor <- 0.5
    b.mol_reps              <- 3
    b.mol_lo_offset         <- 4
    if(PropertyExists(jsonBlock, "mol_levels"))
    {
        if(IsList(jsonBlock.mol_levels) == 1) { b.mol_levels <- jsonBlock.mol_levels }
    }
    if(PropertyExists(jsonBlock, "mol_fine_step"))         { b.mol_fine_step         <- jsonBlock.mol_fine_step }
    if(PropertyExists(jsonBlock, "mol_fine_start_factor")) { b.mol_fine_start_factor <- jsonBlock.mol_fine_start_factor }
    if(PropertyExists(jsonBlock, "mol_reps"))              { b.mol_reps              <- jsonBlock.mol_reps }
    if(PropertyExists(jsonBlock, "mol_lo_offset"))         { b.mol_lo_offset         <- jsonBlock.mol_lo_offset }

    ## Fixed stimulus sample (ms). 0 = until response (legacy). Task-level
    ## stim_ms / resp_ms supply defaults; blocks may override.
    b.stim_ms <- gTaskStimMs
    b.resp_ms <- gTaskRespMs
    if(PropertyExists(jsonBlock, "stim_ms")) { b.stim_ms <- jsonBlock.stim_ms }
    if(PropertyExists(jsonBlock, "resp_ms")) { b.resp_ms <- jsonBlock.resp_ms }

    return(b)
}


## Build a thumbnail widget using rectangles drawn onto a canvas.
## Three row bands match the main waterfall geometry. Each frequency
## in sig gets a narrow stripe rectangle in its correct row band.
define MakeThumbnail(sig, x, y, win, zoom)
{
    ## Build canvas at actual display pixel size — avoid zoom on canvas (breaks at zoom<1)
    tw <- Round(240 * zoom)
    th <- Round(120 * zoom)
    if(tw < 1) { tw <- 1 }
    if(th < 1) { th <- 1 }

    ## Row band geometry: native narrowband coords scaled to thumb pixel size
    scaleY <- th / 1000.0
    scaleX <- tw / 2000.0

    r1cy <- Round((60  + 283/2) * scaleY)
    r2cy <- Round((381 + 283/2) * scaleY)
    r3cy <- Round((702 + 283/2) * scaleY)
    rowH <- Round(283 * scaleY)

    bgDark    <- MakeColorRGB(0,  20,  0)
    rowBg     <- MakeColorRGB(0,  50,  0)
    stripeCol <- MakeColorRGB(60, 230, 80)
    borderCol <- MakeColorRGB(0, 100, 20)

    stripeW <- Round(5 * zoom)
    if(stripeW < 1) { stripeW <- 1 }

    canvas <- MakeCanvas(tw, th, bgDark)
    AddObject(canvas, win)
    Move(canvas, x, y)

    ## Three row background bands
    rb1 <- Rectangle(tw/2, r1cy, tw, rowH, rowBg, 1)
    rb2 <- Rectangle(tw/2, r2cy, tw, rowH, rowBg, 1)
    rb3 <- Rectangle(tw/2, r3cy, tw, rowH, rowBg, 1)
    AddObject(rb1, canvas)
    AddObject(rb2, canvas)
    AddObject(rb3, canvas)
    Draw(rb1)
    Draw(rb2)
    Draw(rb3)

    ## Thin vertical gridlines every 20% across each band (5 boxes, like waterfall_bg).
    ## Same native content map as stripes: x = 50 + frac*1950 on the 2000-wide panel.
    gridCol <- MakeColorRGB(0, 75, 25)
    gridW   <- 1
    gridLines <- []
    loop(rcy, [r1cy, r2cy, r3cy])
    {
        loop(frac, [0.2, 0.4, 0.6, 0.8])
        {
            gx <- Round((50 + frac * 1950) * scaleX)
            g  <- Rectangle(gx, rcy, gridW, rowH, gridCol, 1)
            AddObject(g, canvas)
            Draw(g)
            PushOnEnd(gridLines, g)
        }
    }

    ## Border
    bord <- Rectangle(tw/2, th/2, tw, th, borderCol, 0)
    AddObject(bord, canvas)
    Draw(bord)

    ## Stripe rectangles — one per frequency, position mapped into canvas pixel coords
    rects <- []

    loop(freq, sig)
    {
        freqLo <- 0
        freqHi <- 1
        rcy    <- r1cy

        if(freq >= 0   and freq < 250)  { freqLo <- 0;   freqHi <- 250;  rcy <- r1cy }
        if(freq >= 250 and freq < 750)  { freqLo <- 250; freqHi <- 750;  rcy <- r2cy }
        if(freq >= 750 and freq <= 1750){ freqLo <- 750; freqHi <- 1750; rcy <- r3cy }

        nativeFrac <- (freq - freqLo) / (freqHi - freqLo)
        px <- Round((50 + nativeFrac * 1950) * scaleX)

        r <- Rectangle(px, rcy, stripeW, rowH, stripeCol, 1)
        AddObject(r, canvas)
        Draw(r)
        PushOnEnd(rects, r)
    }

    Draw(canvas)

    obj           <- MakeCustomObject("thumbnail")
    obj.canv      <- canvas
    obj.rb1       <- rb1
    obj.rb2       <- rb2
    obj.rb3       <- rb3
    obj.bord      <- bord
    obj.rects     <- rects
    obj.gridLines <- gridLines
    obj.bgDark    <- bgDark
    obj.rowBg     <- rowBg
    obj.stripeCol <- stripeCol
    obj.borderCol <- borderCol
    obj.gridCol   <- gridCol
    obj.x      <- x
    obj.y      <- y
    obj.width  <- tw
    obj.height <- th
    obj.Move   <- "MoveThumbnail"
    obj.Hide   <- "HideThumbnail"
    obj.Show   <- "ShowThumbnail"
    obj.Add    <- "AddThumbnail"
    obj.Remove <- "RemoveThumbnail"
    return(obj)
}

define MoveThumbnail(obj, x, y)
{
    obj.x <- x
    obj.y <- y
    Move(obj.canv, x, y)
}

define HideThumbnail(obj)
{
    Hide(obj.canv)
}

define ShowThumbnail(obj)
{
    Show(obj.canv)
}

define AddThumbnail(obj, win)
{
    AddObject(obj.canv, win)
}

define RemoveThumbnail(obj, win)
{
    RemoveObject(obj.canv, win)
}


## Hide thumbnails and show go/no-go role labels instead.
## Returns a list of the created label objects so they can be removed later.
define SetupGonogDisplay(vessels, blockCfg)
{
    goVessel <- blockCfg.gonogo_go_vessel

    gngLabels <- []

    thumbNativeH <- 120
    if(blockCfg.display == "heading") { thumbNativeH <- 60 }
    tbgW   <- Round(gVideoWidth * 0.125)
    tzoomX <- tbgW / 240.0
    tbgH   <- Round(thumbNativeH * tzoomX)

    loop(v, vessels)
    {
        Show(v.thumbImg)
        Show(v.lbl)
        tx <- v.thumb.x
        ty <- v.thumb.y

        ## Role label placed below the existing name label
        lblY <- ty + Round(tbgH / 2) + 28 + 26

        roleL <- MakeLabel("WITHHOLD", gFontNogo)
        if(v.id == goVessel)
        {
            roleL <- MakeLabel("RESPOND", gFontGo)
        }
        AddObject(roleL, gWin)
        Move(roleL, tx, lblY)

        PushOnEnd(gngLabels, roleL)
    }

    Draw()
    return(gngLabels)
}


## Remove gonogo role labels and restore thumbnails.
define TeardownGonogDisplay(vessels, gngLabels)
{
    loop(v, vessels)
    {
        Show(v.thumbImg)
        Show(v.lbl)
    }
    loop(lbl, gngLabels)
    {
        RemoveObject(lbl, gWin)
    }
    Draw()
}


## Build vessel objects from parsed JSON vessel list entries.
## display: "narrowband" or "heading" — controls which thumbnail type is built.
define BuildVessels(jsonVessels, display)
{
    vessels     <- []
    gThumbnails <- []   ## global list keeps thumbnail objects (and nested canvases) alive
    gVesselSounds <- []

    ## Thumbnail dimensions: narrowband=240x120, heading=240x60
    thumbNativeW <- 240
    thumbNativeH <- 120
    if(display == "heading") { thumbNativeH <- 60 }

    tbgW   <- Round(gVideoWidth * 0.125)
    tzoomX <- tbgW / thumbNativeW
    tbgH   <- Round(thumbNativeH * tzoomX)
    ## Keep thumbnail + label at least 80px above bottom edge
    thumbY <- Round(gVideoHeight * 0.82)
    safeThumbY <- gVideoHeight - Round(tbgH / 2) - 80
    if(thumbY > safeThumbY) { thumbY <- safeThumbY }
    nV     <- Length(jsonVessels)

    idx <- 1
    loop(jv, jsonVessels)
    {
        thumbX <- Round(gVideoWidth * (idx / (nV + 1.0)))
        ## Require sig (or templates[1].sig). Guard PropertyExists — PEBL fatals on missing props.
        sig <- []
        if(PropertyExists(jv, "sig"))
        {
            sig <- jv.sig
        }

        v      <- MakeCustomObject("vessel")
        v.id   <- jv.id
        v.name <- jv.name
        if(PropertyExists(jv, "name") == 0) { v.name <- "vessel-" + idx }
        v.sig  <- sig

        ## Optional multi-template signatures (one response class, several stim variants).
        ## templates: [{ "name": "...", "sig": [...] }, ...]
        ##   or random-gen class: { "name": "unidentified biological", "kind": "random" }
        ## kind "random" uses MakeRandomNontargetSig; participates in round-robin like others.
        ## Thumbnail uses top-level sig.
        v.templates <- []
        v.template_names <- []
        v.template_kinds <- []
        v.n_templates <- 0
        v.active_sig <- sig
        v.active_template <- ""
        v.forced_template_idx <- 0
        ## Legacy P(strange outlier | this vessel trial) when not using a random template
        ## class. Prefer kind:"random" in the templates list for scheduled designs.
        v.outlier_p <- 0
        if(PropertyExists(jv, "outlier_p")) { v.outlier_p <- jv.outlier_p }
        v.outlier_label <- "unidentified biological"
        if(PropertyExists(jv, "outlier_label")) { v.outlier_label <- jv.outlier_label }
        v.outlier_min_dist <- 100
        if(PropertyExists(jv, "outlier_min_dist")) { v.outlier_min_dist <- jv.outlier_min_dist }
        if(PropertyExists(jv, "templates"))
        {
            loop(t, jv.templates)
            {
                tKind <- "fixed"
                if(PropertyExists(t, "kind")) { tKind <- t.kind }
                tSig <- []
                if(PropertyExists(t, "sig")) { tSig <- t.sig }
                ## Random-gen slots have no fixed bands.
                if(tKind == "random") { tSig <- [] }
                PushOnEnd(v.templates, tSig)
                tName <- ""
                if(PropertyExists(t, "name")) { tName <- t.name }
                if(tName == "" and tKind == "random") { tName <- v.outlier_label }
                PushOnEnd(v.template_names, tName)
                PushOnEnd(v.template_kinds, tKind)
            }
            v.n_templates <- Length(v.templates)
            if(v.n_templates > 0 and Length(sig) == 0)
            {
                ## Prefer first fixed (non-random) template for default/thumbnail sig.
                ti <- 1
                while(ti <= v.n_templates and Length(sig) == 0)
                {
                    if(Nth(v.template_kinds, ti) != "random")
                    {
                        cand <- Nth(v.templates, ti)
                        if(Length(cand) > 0) { sig <- cand }
                    }
                    ti <- ti + 1
                }
                v.sig <- sig
                v.active_sig <- sig
            }
        }
        if(Length(v.sig) == 0)
        {
            SignalFatalError("Vessel missing sig (and no usable templates): id/name index " + idx)
        }

        ## Per-response thumbnail visibility (default 1). 0 = no spectral fingerprint on
        ## the response control (plain labeled button); stim sig/templates still used on trials.
        v.show_thumbnail <- 1
        if(PropertyExists(jv, "show_thumbnail")) { v.show_thumbnail <- jv.show_thumbnail }

        ## Optional Simon / heading fields
        v.response_side  <- "left"
        if(PropertyExists(jv, "response_side"))  { v.response_side  <- jv.response_side }
        v.bearings <- sig
        if(PropertyExists(jv, "bearings"))       { v.bearings       <- jv.bearings }
        v.contact_type <- "solid"
        if(PropertyExists(jv, "contact_type"))   { v.contact_type   <- jv.contact_type }
        v.payoff_mean <- 0
        if(PropertyExists(jv, "payoff_mean"))    { v.payoff_mean    <- jv.payoff_mean }
        v.payoff_sd <- 0
        if(PropertyExists(jv, "payoff_sd"))      { v.payoff_sd      <- jv.payoff_sd }
        v.loss_prob <- 0.0
        if(PropertyExists(jv, "loss_prob"))      { v.loss_prob      <- jv.loss_prob }
        v.loss_amount <- 0
        if(PropertyExists(jv, "loss_amount"))    { v.loss_amount    <- jv.loss_amount }
        v.bart_life <- 128
        if(PropertyExists(jv, "bart_life"))      { v.bart_life      <- jv.bart_life }

        ## Build thumbnail widget matching display type; zoom set inside constructor.
        ## When show_thumbnail=0, build an empty (stripe-free) canvas so no fingerprint leaks.
        thumbSig <- sig
        if(v.show_thumbnail == 0) { thumbSig <- [] }
        thumb <- MakeThumbnail(thumbSig, thumbX, thumbY, gWin, tzoomX)
        if(display == "heading")
        {
            thumb <- MakeHeadingThumbnail(thumbSig, thumbX, thumbY, gWin, v.contact_type, tzoomX)
        }
        v.thumb    <- thumb
        v.thumbImg <- thumb.canv
        PushOnEnd(gThumbnails, thumb)

        ## Label under thumbnail
        lbl  <- MakeLabel(jv.name, gFontLbl)
        AddObject(lbl, gWin)
        lblY <- thumbY + Round(tbgH / 2) + 28
        Move(lbl, thumbX, lblY)
        v.lbl <- lbl

        ## Plain labeled button for no-thumbnail mode — parked offscreen until needed
        btnCol <- MakeColorRGB(0, 60, 0)
        PushOnEnd(gKeep, btnCol)
        btn    <- Rectangle(gOffscreenX, thumbY, tbgW, tbgH, btnCol, 1)
        AddObject(btn, gWin)
        btnLbl <- MakeLabel(jv.name, gBtnFont)
        AddObject(btnLbl, gWin)
        Move(btnLbl, gOffscreenX, thumbY)
        v.btn    <- btn
        v.btnLbl <- btnLbl
        v.btnX   <- thumbX
        v.btnY   <- thumbY
        v.btnCol <- btnCol
        v.thumbX <- thumbX
        v.thumbY <- thumbY
        ## Keep ALL response widgets parked until SetupMode → ApplyVesselThumbDisplay
        ## so Biological (plain button) does not appear alone before the kilo thumbs.
        if(v.show_thumbnail == 0)
        {
            Hide(v.thumbImg)
            Hide(v.lbl)
        }
        Move(v.btn,    gOffscreenX, thumbY)
        Move(v.btnLbl, gOffscreenX, thumbY)
        v.hasSound   <- 0
        v.hasSoundHi <- 0
        v.hasSoundLo <- 0
        v.snd        <- 0
        v.sndHi      <- 0
        v.sndLo      <- 0
        if(gUseAudio == 1)
        {
            hiPath <- ""
            if(PropertyExists(jv, "sound"))    { hiPath <- jv.sound }
            if(PropertyExists(jv, "sound_hi")) { hiPath <- jv.sound_hi }
            if(hiPath != "")
            {
                if(FileExists(hiPath) == 1)
                {
                    v.sndHi      <- LoadSound(hiPath)
                    v.hasSoundHi <- 1
                    PushOnEnd(gVesselSounds, v.sndHi)
                }
            }
            loPath <- hiPath
            if(PropertyExists(jv, "sound_lo")) { loPath <- jv.sound_lo }
            if(loPath != "")
            {
                if(FileExists(loPath) == 1)
                {
                    v.sndLo      <- LoadSound(loPath)
                    v.hasSoundLo <- 1
                    PushOnEnd(gVesselSounds, v.sndLo)
                }
            }
            if(v.hasSoundLo == 0)
            {
                v.sndLo      <- v.sndHi
                v.hasSoundLo <- v.hasSoundHi
            }
            v.snd      <- v.sndHi
            v.hasSound <- v.hasSoundHi
        }

        PushOnEnd(vessels, v)
        idx <- idx + 1
    }

    return(vessels)
}


## Overlay response_side / bearings from a JSON vessel list onto live vessel objects.
define ApplyVesselOverrides(jsonVessels, vessels)
{
    loop(jv, jsonVessels)
    {
        loop(v, vessels)
        {
            if(v.id == jv.id)
            {
                if(PropertyExists(jv, "response_side")) { v.response_side <- jv.response_side }
                if(PropertyExists(jv, "bearings"))      { v.bearings      <- jv.bearings }
            }
        }
    }
}


## Multi-column config file picker.
## labels: display names (filenames). values: full paths returned on click.
## Lays items in columns of maxRows each, small font, compact spacing.
define PickConfigFile(labels, values, win)
{
    ShowCursor(1)

    fontTitle <- MakeFont(gPEBLBaseFont, 1, 22, MakeColor("white"),  MakeColor("black"), 1)
    fontItem  <- MakeFont(gPEBLBaseFont, 0, 18, MakeColor("white"),  MakeColor("black"), 1)
    boxCol    <- MakeColorRGB(0, 80, 0)
    boxHiCol  <- MakeColorRGB(60, 180, 60)

    title <- MakeLabel("Select a task configuration — click to load:", fontTitle)
    AddObject(title, win)
    Move(title, Round(gVideoWidth / 2), 30)

    maxRows  <- 8
    nItems   <- Length(labels)
    nCols    <- Ceiling(nItems / maxRows)
    colW     <- Round(gVideoWidth / (nCols + 1))
    rowH     <- 40
    startY   <- 80

    squares  <- []
    allObjs  <- [title]
    idx      <- 1

    loop(lbl, labels)
    {
        col <- Ceiling(idx / maxRows)
        row <- idx - (col - 1) * maxRows
        cx  <- col * colW
        cy  <- startY + (row - 1) * rowH + Round(rowH / 2)

        sq  <- Square(cx - Round(colW / 2) + 15, cy, rowH - 8, boxCol, 1)
        AddObject(sq, win)

        lab <- MakeLabel(lbl, fontItem)
        AddObject(lab, win)
        Move(lab, cx - Round(colW / 2) + 15 + rowH + 8 + Round(lab.width / 2), cy)

        PushOnEnd(squares, sq)
        PushOnEnd(allObjs, sq)
        PushOnEnd(allObjs, lab)
        idx <- idx + 1
    }

    Draw()
    chosen <- WaitForClickOnTarget(squares, values)

    loop(o, allObjs) { RemoveObject(o, win) }
    Draw()
    return(chosen)
}


##this initializes any UI elements that are set up at the beginning and potentially used repeatedly.  
##it should be dependent on test mode, but for now we move all of them here.

##taskdisplay may be 'heading' 'cued', 'narrowband' etc.
#It generates many global objects for display and stimuli.

define InitializeUI(taskDisplay,cfg)
{
    InitAudio(cfg)

    ## --- Display constants ---
    gZoom          <- gVideoWidth / 2000.0 * 0.5
    zoom           <- gZoom
    gStripeStretch <- 4.0
    gOffscreenX    <- -3000

    ## --- Fonts (globals: labels do not keep their font alive) ---
    gKeep      <- []
    gBtnFont   <- MakeFont(gPEBLBaseFont, 1, 28, MakeColor("white"),  MakeColor("black"), 0)
    gFontLarge <- MakeFont(gPEBLBaseFont, 0, 28, MakeColor("white"),  MakeColor("black"), 1)
    gFontSmall <- MakeFont(gPEBLBaseFont, 0, 24, MakeColor("white"),  MakeColor("black"), 1)
    gFontFB    <- MakeFont(gPEBLBaseFont, 0, 32, MakeColor("yellow"), MakeColor("black"), 0)
    gFontLbl   <- MakeFont(gPEBLBaseFont, 0, 20, MakeColor("white"),  MakeColor("black"), 1)
    gFontGo    <- MakeFont(gPEBLBaseFont, 1, 22, MakeColorRGB(60, 220, 60),  MakeColor("black"), 1)
    gFontNogo  <- MakeFont(gPEBLBaseFont, 1, 22, MakeColorRGB(220, 60, 60), MakeColor("black"), 1)
    gFontSimonL <- MakeFont(gPEBLBaseFont, 1, 22, MakeColorRGB(60, 220, 60),  MakeColor("black"), 1)
    gFontSimonR <- MakeFont(gPEBLBaseFont, 1, 22, MakeColorRGB(60, 200, 220), MakeColor("black"), 1)
    PushOnEnd(gKeep, gBtnFont)
    PushOnEnd(gKeep, gFontGo)
    PushOnEnd(gKeep, gFontNogo)
    PushOnEnd(gKeep, gFontSimonL)
    PushOnEnd(gKeep, gFontSimonR)

    ## --- Score HUD (persistent payoff display, top-right corner) ---
    gCumulScore <- 0
    gBlockScore <- 0
    gBlockNCorrect <- 0
    gBlockNTrials <- 0
    gScoreHUD   <- MakeLabel("Score: 0", gFontLbl)
    AddObject(gScoreHUD, gWin)
    Move(gScoreHUD, Round(gVideoWidth * 0.88), 40)

    ## --- Task rule HUD (top-center, updated per block, cleared between blocks) ---
    gRuleFont <- MakeFont(gPEBLBaseFont, 1, 20, MakeColorRGB(220, 220, 100), MakeColor("black"), 1)
    PushOnEnd(gKeep, gRuleFont)
    gRuleHUD  <- MakeLabel("", gRuleFont)
    AddObject(gRuleHUD, gWin)
    Move(gRuleHUD, Round(gVideoWidth * 0.50), 22)

    ## Mode-specific buttons are created lazily in SetupMode / Ensure*Buttons.
    ## The global lists (not AddObject) keep the widgets alive.
    gSecretaryBtns <- []
    gUrnsBtns      <- []
    gHorizonBtns   <- []
    gSabartBtns    <- []
    gSabartSchedule <- []
    gSabartLastPts <- 0
    gSabartFill    <- 0
    gVesselSounds  <- []

    ## --- Layout: vertical center of stimulus display ---
    ## Narrowband bg is 1000px tall; heading bg is 200px tall (both 2000px wide).
    ## "cued" display uses both: heading top ~20%, narrowband below.
    if(taskDisplay == "heading")
    {
        bgHScaled  <- Round(200 * zoom)
        gDispY     <- Round(gVideoHeight * 0.30)
        gHeadDispY <- gDispY
        gNbDispY   <- gDispY
    } else {
        if(taskDisplay == "cued")
        {
            bgHScaled  <- Round(1000 * zoom)
            gNbDispY   <- Round(gVideoHeight * 0.50)
            gHeadDispY <- gNbDispY - Round(bgHScaled / 2) - Round(200 * zoom / 2) - 10
            gDispY     <- gNbDispY
        } else {
            bgHScaled  <- Round(1000 * zoom)
            gDispY     <- Round(gVideoHeight * 0.38) + 50
            gHeadDispY <- gDispY
            gNbDispY   <- gDispY
        }
    }
    gPanelHalfH <- Round(bgHScaled / 2)
    gFbY <- gDispY + gPanelHalfH + 35

    ## Load only the panel(s) this recipe already asked for via display.
    ## heading → bearing strip; narrowband → waterfall+noise; cued → both.
    gWaterfallReady <- 0
    gHeadingReady   <- 0
    gNoiseImgs      <- []
    if(taskDisplay != "heading") { EnsureWaterfall() }
    if(taskDisplay != "narrowband") { EnsureHeading() }

    if(taskDisplay == "heading")
    {
        Move(gHeadingBg, Round(gVideoWidth/2), gDispY)
    } else {
        if(taskDisplay == "cued")
        {
            Move(gHeadingBg, Round(gVideoWidth/2), gHeadDispY)
        } else {
            Move(gBg, Round(gVideoWidth/2), gDispY)
        }
    }

    ## --- Signal cue label: positioned just above display, hidden until trial onset ---
    ## Use gPanelHalfH (not gBg.height): heading-only tasks never load the waterfall bg.
    gSignalFont <- MakeFont(gPEBLBaseFont, 1, 28, MakeColorRGB(80, 220, 80), MakeColor("black"), 1)
    PushOnEnd(gKeep, gSignalFont)
    gSignalLbl  <- MakeLabel("Signal Detected!", gSignalFont)
    AddObject(gSignalLbl, gWin)
    Move(gSignalLbl, Round(gVideoWidth / 2), gDispY - gPanelHalfH - 20)
    Hide(gSignalLbl)

    vesselDisplayType <- gTaskDisplay
    if(gTaskDisplay == "cued") { vesselDisplayType <- "narrowband" }
    gVessels <- BuildVessels(cfg.vessels, vesselDisplayType)

    ## --- Response indicator box (gonogo) ---
    tbgW         <- Round(gVideoWidth * 0.125)
    thumbNativeW <- 240
    thumbNativeH <- 120
    if(gTaskDisplay == "heading") { thumbNativeH <- 60 }
    tzoomX       <- tbgW / thumbNativeW
    tbgH         <- Round(thumbNativeH * tzoomX)
    gRespBoxCol  <- MakeColorRGB(60, 230, 60)
    gResponseBox <- Rectangle(gOffscreenX, gDispY, tbgW + 6, tbgH + 6, gRespBoxCol, 0)
    AddObject(gResponseBox, gWin)

    ## Recenter click sits between the bottom-left/right response thumbs.
    ## Label font last arg 0 = transparent background (no filled box).
    gRecenterX <- Round(gVideoWidth / 2)
    thumbV <- Nth(gVessels, 1)
    gRecenterY <- thumbV.thumbY
    gFontRecenter <- MakeFont(gPEBLBaseFont, 0, 20, MakeColor("white"), MakeColor("black"), 0)
    PushOnEnd(gKeep, gFontRecenter)
    gRecenterLbl <- MakeLabel("Click here", gFontRecenter)
    AddObject(gRecenterLbl, gWin)
    Move(gRecenterLbl, gOffscreenX, gDispY)

    gLayout2AFCReady <- 0
    gGoLayoutReady   <- 0
}


## ============================================================
## HTML SESSION REPORT (ScaleRunner-style helpers from HTML.pbl)
## ============================================================

## Index of vessel id in vessels list (1-based); 0 if not found.
define VesselIndexById(vid, vessels)
{
    found <- 0
    idx <- 0
    i <- 1
    loop(v, vessels)
    {
        if(found == 0)
        {
            if(v.id == vid)
            {
                idx <- i
                found <- 1
            }
        }
        i <- i + 1
    }
    return(idx)
}


define FormatPct(nOk, nTot)
{
    pct <- 0
    if(nTot > 0) { pct <- Round(100.0 * nOk / nTot) }
    return(pct)
}


## n x n zero matrix as list-of-lists.
define ZeroConfMat(n)
{
    mat <- []
    i <- 1
    while(i <= n)
    {
        row <- []
        j <- 1
        while(j <= n)
        {
            PushOnEnd(row, 0)
            j <- j + 1
        }
        PushOnEnd(mat, row)
        i <- i + 1
    }
    return(mat)
}


## Increment mat[ti][ri] by rebuilding (PEBL lists are not assignable via Nth).
define IncConfMat(mat, ti, ri)
{
    out <- []
    i <- 1
    loop(row, mat)
    {
        if(i == ti)
        {
            newRow <- []
            j <- 1
            loop(cell, row)
            {
                if(j == ri)
                {
                    PushOnEnd(newRow, cell + 1)
                } else {
                    PushOnEnd(newRow, cell)
                }
                j <- j + 1
            }
            PushOnEnd(out, newRow)
        } else {
            PushOnEnd(out, row)
        }
        i <- i + 1
    }
    return(out)
}


## Build confusion table rows for HTML Table(): first col = true label.
## vessels order defines both axes. trials: list of [trueId, respId, ...].
define BuildConfusionTable(trials, vessels)
{
    n <- Length(vessels)
    mat <- ZeroConfMat(n)
    loop(tr, trials)
    {
        tid <- Nth(tr, 1)
        rid <- Nth(tr, 2)
        ti <- VesselIndexById(tid, vessels)
        ri <- VesselIndexById(rid, vessels)
        if(ti > 0 and ri > 0)
        {
            mat <- IncConfMat(mat, ti, ri)
        }
    }
    ## Header uses vessel names; body rows prepend true-class name.
    headers <- ["True \\ Pred"]
    loop(v, vessels)
    {
        PushOnEnd(headers, v.name)
    }
    rows <- []
    i <- 1
    loop(v, vessels)
    {
        row <- [v.name]
        matRow <- Nth(mat, i)
        loop(cell, matRow)
        {
            PushOnEnd(row, cell + "")
        }
        PushOnEnd(rows, row)
        i <- i + 1
    }
    return([headers, rows])
}


## Unique block ids in trial order of first appearance.
define ReportBlockIds(trialRecs)
{
    ids <- []
    loop(rec, trialRecs)
    {
        bid <- Nth(rec, 1)
        seen <- 0
        loop(x, ids)
        {
            if(x == bid) { seen <- 1 }
        }
        if(seen == 0) { PushOnEnd(ids, bid) }
    }
    return(ids)
}


define ReportBlockLabel(trialRecs, bid)
{
    lab <- bid
    found <- 0
    loop(rec, trialRecs)
    {
        if(found == 0)
        {
            if(Nth(rec, 1) == bid)
            {
                lab <- Nth(rec, 2)
                found <- 1
            }
        }
    }
    return(lab)
}


define FilterTrialsByBlock(trialRecs, bid)
{
    out <- []
    loop(rec, trialRecs)
    {
        if(Nth(rec, 1) == bid)
        {
            ## [trueId, respId, correct, points]
            PushOnEnd(out, [Nth(rec, 3), Nth(rec, 4), Nth(rec, 5), Nth(rec, 6)])
        }
    }
    return(out)
}


define ListToCsv(lst)
{
    s <- ""
    if(Length(lst) > 0) { s <- ConcatenateList(lst, ", ") }
    return(s)
}


## Write ScaleRunner-style HTML report: design summary + accuracy + confusion.
## trialRecs entries: [blockId, blockLabel, vesselId, respId, correct, points, confidence]
define GenerateSonarReport(cfg, dataFile, vessels, trialRecs)
{
    taskId <- cfg.task_id
    safeTask <- ReplaceChar(taskId + "", [" ", "/", "\\", ":", ",", "|"], "_")
    reportFilename <- safeTask + "-report-" + gSubNum + ".html"
    reportPath <- GetDirectory(dataFile.filename) + reportFilename
    Print("Creating HTML report: " + reportPath)
    htmlFile <- FileOpenWrite(reportPath)

    FilePrint(htmlFile, "<html><head><title>" + taskId + " Report - " + gSubNum + "</title>")
    FilePrint(htmlFile, "<style>")
    FilePrint(htmlFile, "body { font-family: Arial, sans-serif; margin: 40px; }")
    FilePrint(htmlFile, "table { border-collapse: collapse; margin: 20px 0; }")
    FilePrint(htmlFile, "th, td { border: 1px solid #ddd; padding: 10px; text-align: left; }")
    FilePrint(htmlFile, "th { background-color: #2c5f8a; color: white; }")
    FilePrint(htmlFile, "tr:nth-child(even) { background-color: #f2f2f2; }")
    FilePrint(htmlFile, ".summary { background-color: #e8f0f7; padding: 20px; border-radius: 5px; margin: 20px 0; }")
    FilePrint(htmlFile, "h1 { color: #222; }")
    FilePrint(htmlFile, "h2 { color: #444; }")
    FilePrint(htmlFile, "h3 { color: #555; }")
    FilePrint(htmlFile, ".note { color: #666; font-size: 0.95em; }")
    FilePrint(htmlFile, "</style></head><body>")

    FilePrint(htmlFile, H("Sonar Task Report", 1))
    FilePrint(htmlFile, P("Task: " + B(taskId)))
    if(gChosenConfigStem != "")
    {
        FilePrint(htmlFile, P("Config file: " + B(gChosenConfigStem + ".json") +
            " &nbsp;|&nbsp; pick=" + B(gTaskPickMode) +
            " &nbsp;|&nbsp; pool=[" + gTaskPoolRaw + "]"))
    }
    if(gSeedPlan != "")
    {
        FilePrint(htmlFile, P("Seed plan (Latin-square row): " + B(gSeedPlan)))
    }
    FilePrint(htmlFile, P("Participant: " + B(gSubNum)))
    FilePrint(htmlFile, P("Test Date: " + B(TimeStamp())))
    elapsedMin <- 0
    if(gReportStartTime > 0)
    {
        elapsedMin <- Round((GetTime() - gReportStartTime) / 1000.0 / 60.0 * 100) / 100
    }
    FilePrint(htmlFile, P("Session duration: " + B(elapsedMin + " minutes")))
    FilePrint(htmlFile, HL())

    ## --- Design ---
    FilePrint(htmlFile, H("Design", 2))
    FilePrint(htmlFile, "<div class='summary'>")
    disp <- "narrowband"
    if(PropertyExists(cfg, "display")) { disp <- cfg.display }
    aud <- "off"
    if(PropertyExists(cfg, "audio"))
    {
        if(cfg.audio == 1) { aud <- "on" }
    }
    FilePrint(htmlFile, P(B("Display: ") + disp + " &nbsp;|&nbsp; " + B("Task audio: ") + aud))
    rin <- ""
    cin <- ""
    if(PropertyExists(cfg, "response_input")) { rin <- cfg.response_input }
    if(PropertyExists(cfg, "confidence_input")) { cin <- cfg.confidence_input }
    if(rin != "" or cin != "")
    {
        FilePrint(htmlFile, P(B("Response input: ") + rin + " &nbsp;|&nbsp; " + B("Confidence input: ") + cin))
    }
    FilePrint(htmlFile, "</div>")

    ## Vessels
    FilePrint(htmlFile, H("Response classes (vessels)", 3))
    vRows <- []
    loop(v, vessels)
    {
        tmplInfo <- "—"
        if(v.n_templates > 0)
        {
            tmplInfo <- ListToCsv(v.template_names)
            ## Mark random-gen slots
            kinds <- []
            ki <- 1
            loop(nm, v.template_names)
            {
                kind <- "fixed"
                if(ki <= Length(v.template_kinds)) { kind <- Nth(v.template_kinds, ki) }
                if(kind == "random") { nm <- nm + " [random]" }
                PushOnEnd(kinds, nm)
                ki <- ki + 1
            }
            tmplInfo <- ListToCsv(kinds)
        }
        PushOnEnd(vRows, [v.id + "", v.name, tmplInfo])
    }
    FilePrint(htmlFile, Table(vRows, ["ID", "Name", "Templates / variants"]))

    ## Blocks
    FilePrint(htmlFile, H("Blocks", 3))
    bRows <- []
    if(PropertyExists(cfg, "blocks"))
    {
        loop(jb, cfg.blocks)
        {
            bid <- jb.id
            blab <- ""
            if(PropertyExists(jb, "label")) { blab <- jb.label }
            nTr <- ""
            if(PropertyExists(jb, "trials")) { nTr <- jb.trials + "" }
            nRep <- "1"
            if(PropertyExists(jb, "repetitions")) { nRep <- jb.repetitions + "" }
            counts <- "—"
            if(PropertyExists(jb, "vessel_counts")) { counts <- ListToCsv(jb.vessel_counts) }
            mode <- ""
            if(PropertyExists(jb, "signal_mode")) { mode <- jb.signal_mode }
            jit <- ""
            if(PropertyExists(jb, "signal_params"))
            {
                if(PropertyExists(jb.signal_params, "jitter_sd"))
                {
                    jit <- jb.signal_params.jitter_sd + ""
                }
            }
            fb <- ""
            if(PropertyExists(jb, "feedback")) { fb <- jb.feedback }
            sc <- ""
            if(PropertyExists(jb, "scoring")) { sc <- jb.scoring }
            thumbs <- "yes"
            if(PropertyExists(jb, "show_thumbnails"))
            {
                if(jb.show_thumbnails == 0) { thumbs <- "no" }
            }
            pay <- "—"
            if(PropertyExists(jb, "payoff_correct_by_conf"))
            {
                pay <- ListToCsv(jb.payoff_correct_by_conf)
            }
            PushOnEnd(bRows, [bid, blab, nTr, nRep, counts, mode, jit, fb, sc, thumbs, pay])
        }
    }
    FilePrint(htmlFile, Table(bRows, ["ID", "Label", "Trials", "Reps", "Vessel counts", "Signal", "Jitter %", "Feedback", "Scoring", "Refs", "Payoffs (corr)"]))
    FilePrint(htmlFile, P("<span class='note'>Vessel counts follow vessel-list order. Refs = reference signature thumbnails. Jitter % is SD as percent of each band frequency (not fixed Hz). Payoffs are correct-by-confidence (incorrect is symmetric negation when configured).</span>"))

    FilePrint(htmlFile, HL())

    ## --- Performance ---
    FilePrint(htmlFile, H("Performance", 2))
    nAll <- Length(trialRecs)
    nOkAll <- 0
    ptsAll <- 0
    loop(rec, trialRecs)
    {
        if(Nth(rec, 5) == 1) { nOkAll <- nOkAll + 1 }
        ptsAll <- ptsAll + Nth(rec, 6)
    }
    FilePrint(htmlFile, "<div class='summary'>")
    FilePrint(htmlFile, P(B("Overall accuracy: ") + nOkAll + " / " + nAll + " (" + FormatPct(nOkAll, nAll) + "%)"))
    signPts <- "+" + ptsAll
    if(ptsAll < 0) { signPts <- "" + ptsAll }
    FilePrint(htmlFile, P(B("Total points: ") + signPts))
    FilePrint(htmlFile, "</div>")

    ## Per-block summary table
    blockIds <- ReportBlockIds(trialRecs)
    sumRows <- []
    loop(bid, blockIds)
    {
        lab <- ReportBlockLabel(trialRecs, bid)
        bt <- FilterTrialsByBlock(trialRecs, bid)
        nB <- Length(bt)
        nOk <- 0
        pts <- 0
        loop(tr, bt)
        {
            if(Nth(tr, 3) == 1) { nOk <- nOk + 1 }
            pts <- pts + Nth(tr, 4)
        }
        signB <- "+" + pts
        if(pts < 0) { signB <- "" + pts }
        PushOnEnd(sumRows, [bid, lab, nB + "", nOk + "", FormatPct(nOk, nB) + "%", signB])
    }
    FilePrint(htmlFile, H("By block", 3))
    FilePrint(htmlFile, Table(sumRows, ["Block", "Label", "N", "Correct", "Accuracy", "Points"]))

    ## Overall confusion
    FilePrint(htmlFile, H("Confusion matrix (study)", 3))
    FilePrint(htmlFile, P("<span class='note'>Rows = true class; columns = response. Only trials with a valid vessel response are counted in cells.</span>"))
    allPairs <- []
    loop(rec, trialRecs)
    {
        PushOnEnd(allPairs, [Nth(rec, 3), Nth(rec, 4)])
    }
    cm <- BuildConfusionTable(allPairs, vessels)
    FilePrint(htmlFile, Table(Second(cm), First(cm)))

    ## Per-block confusion
    loop(bid, blockIds)
    {
        lab <- ReportBlockLabel(trialRecs, bid)
        bt <- FilterTrialsByBlock(trialRecs, bid)
        pairs <- []
        loop(tr, bt)
        {
            PushOnEnd(pairs, [Nth(tr, 1), Nth(tr, 2)])
        }
        FilePrint(htmlFile, H("Confusion — " + lab + " (" + bid + ")", 3))
        cmB <- BuildConfusionTable(pairs, vessels)
        FilePrint(htmlFile, Table(Second(cmB), First(cmB)))
    }

    FilePrint(htmlFile, HL())
    FilePrint(htmlFile, H("Data files", 2))
    csvName <- dataFile.filename
    parts <- SplitString(csvName, "/")
    if(Length(parts) > 0) { csvName <- Nth(parts, Length(parts)) }
    FilePrint(htmlFile, "<ul>")
    FilePrint(htmlFile, "<li><a href='" + csvName + "'>" + csvName + "</a> — trial-by-trial data</li>")
    FilePrint(htmlFile, "<li><a href='" + reportFilename + "'>" + reportFilename + "</a> — this report</li>")
    FilePrint(htmlFile, "</ul>")

    FilePrint(htmlFile, "<p style='font-size:0.85em;color:#888;text-align:center;'>")
    FilePrint(htmlFile, "Generated by sonar-task via <a href='http://pebl.sf.net' target='_blank'>PEBL</a>")
    FilePrint(htmlFile, " HTML helpers (H/P/Table) from pebl-lib/HTML.pbl.")
    FilePrint(htmlFile, "</p>")
    FilePrint(htmlFile, "</body></html>")
    FileClose(htmlFile)
    Print("HTML report saved: " + reportPath)

    fileObj <- MakeCustomObject("file")
    fileObj.filename <- reportPath
    return(fileObj)
}


## ============================================================
## CONFIG SELECTION (task / tasks / taskPick)
## ============================================================

## Split a comma-separated stem string into a cleaned list.
## Also accepts PEBL list values from JSON list-typed params.
define ParseTaskStems(raw)
{
    stems <- []
    if(IsList(raw))
    {
        loop(item, raw)
        {
            s <- StripSpace(item + "")
            if(s != "") { PushOnEnd(stems, s) }
        }
        return(stems)
    }
    s <- StripSpace(raw + "")
    if(s == "") { return(stems) }
    ## Single token with no comma → one stem
    parts <- SplitString(s, ",")
    loop(p, parts)
    {
        t <- StripSpace(p + "")
        if(t != "") { PushOnEnd(stems, t) }
    }
    return(stems)
}


## Choose one stem from a pool. mode: random | first | subnum
define PickTaskStem(stems, mode)
{
    n <- Length(stems)
    if(n <= 0)
    {
        SignalFatalError("PickTaskStem: empty task pool")
    }
    if(n == 1) { return(First(stems)) }

    m <- Lowercase(StripSpace(mode + ""))
    if(m == "" or m == "random")
    {
        idx <- RandomDiscrete(n)
        return(Nth(stems, idx))
    }
    if(m == "first")
    {
        return(First(stems))
    }
    if(m == "subnum")
    {
        ## Deterministic cycle assignment from subject code → 1..n
        idx <- Mod(ToInteger(gSubNum), n) + 1
        return(Nth(stems, idx))
    }
    SignalFatalError("taskPick must be random, first, or subnum (got: " + mode + ")")
}


## ============================================================
## START
## ============================================================

define Start(p)
{
    InitializeUpload()
    gWin <- MakeWindow("black")

    if(gSubNum + "" == "0")
    {
        gSubNum <- GetSubNum(gWin)
    }



    ## --- Load config via named parameter ---
    ## Schema: task / tasks / taskPick (+ audio / responsemode).
    ## Online: PEBLHub serves the par.json via its API; CreateParameters reads it.
    ## Local with --pfile: reads the specified par.json.
    ## Local without --pfile: reads params/sonar-task.pbl.par.json (default).
    parpairs <- [["task", "askuser"],
                 ["tasks", ""],
                 ["taskPick", "random"],
    	         ["useAudio",0],
		 ["useWaterfallAnimation",0],
		 ["responsemode","auto"]]
		 
    gParams  <- CreateParameters(parpairs, gParamFile)

    gChosenConfigStem <- ""
    gTaskPickMode <- ""
    gTaskPoolRaw <- ""
    gSeedPlan <- ""

    taskName <- gParams.task
    tasksRaw <- ""
    if(PropertyExists(gParams, "tasks")) { tasksRaw <- gParams.tasks }
    pickMode <- "random"
    if(PropertyExists(gParams, "taskPick")) { pickMode <- gParams.taskPick }
    gTaskPickMode <- pickMode + ""

    ## Prefer explicit tasks pool; else allow comma-list in task.
    pool <- ParseTaskStems(tasksRaw)
    if(Length(pool) == 0 and taskName != "askuser")
    {
        pool <- ParseTaskStems(taskName)
    }

    if(taskName == "askuser" and Length(pool) == 0)
    {
        allFiles  <- GetDirectoryListing("config")
        jsonFiles <- []
        loop(f, allFiles)
        {
            flen <- StringLength(f)
            if(flen > 5)
            {
                ext <- SubString(f, flen - 4, flen)
                if(ext == ".json") { PushOnEnd(jsonFiles, f) }
            }
        }
        if(Length(jsonFiles) == 0)
        {
            SignalFatalError("No .json files found in config/")
        }
        fullPaths <- []
        loop(f, jsonFiles)
        {
            PushOnEnd(fullPaths, "config/" + f)
        }
        cfgPath <- PickConfigFile(jsonFiles, fullPaths, gWin)
        ## Stem without path / .json for logging
        parts <- SplitString(cfgPath, "/")
        leaf <- Nth(parts, Length(parts))
        flen <- StringLength(leaf)
        if(flen > 5)
        {
            gChosenConfigStem <- SubString(leaf, 1, flen - 5)
        } else {
            gChosenConfigStem <- leaf
        }
        gTaskPoolRaw <- "(askuser)"
        gTaskPickMode <- "askuser"
    } else {
        if(Length(pool) == 0)
        {
            SignalFatalError("No task / tasks config stems specified")
        }
        gTaskPoolRaw <- ConcatenateList(pool, ",")
        chosen <- PickTaskStem(pool, pickMode)
        gChosenConfigStem <- chosen
        cfgPath <- "config/" + chosen + ".json"
    }

    Print("Config pool: [" + gTaskPoolRaw + "] pick=" + gTaskPickMode + " → " + gChosenConfigStem)
    Print("Loading config: " + cfgPath)
    if(FileExists(cfgPath))
    {
        cfg <- ParseJSON(FileReadText(cfgPath))
    } else {
        SignalFatalError("Config not found: " + cfgPath)
    }


    taskId <- cfg.task_id
    if(PropertyExists(cfg, "seed_plan")) { gSeedPlan <- cfg.seed_plan + "" }

    gTaskDisplay <- "narrowband"
    if(PropertyExists(cfg, "display"))
    {
        gTaskDisplay <- cfg.display
    }

    ## Task-level input modality defaults (block may override).
    ## "mouse" | "keyboard" | "auto" | "either"
    gResponseInput <- "auto"
    gConfidenceInput <- "auto"
    if(PropertyExists(cfg, "response_input")) { gResponseInput <- cfg.response_input }
    if(PropertyExists(cfg, "confidence_input")) { gConfidenceInput <- cfg.confidence_input }

    ## Identity-feedback scratch (set per trial in RunTrial / GenerateSignal).
    gFeedbackTargetLabel <- ""
    gLastActiveTemplate <- ""

    ## Session HTML report accumulators (filled in LogTrial).
    gReportTrials <- []
    gReportStartTime <- 0

   InitializeUI(gTaskDisplay,cfg)
   ## Do not leave Biological (or any response control) visible during subnum / instructions.
   HideAllResponseOptions(gVessels)

    ## --- Data file ---
    dataHeader <- "subnum,task_id,block_id,response_mode,trial,vessel_id,vessel_name,response,correct,outcome,points,signal_mode,rt_ms,rt2_ms,abstime,base_sig,actual_sig,instance_id,n_shown,n_extra,n_missing,bearing,congruent,reported_correct,n_consec,n_reversals,correct_vessel,confidence,channel,visual_sd,audio_gain,visual_level,audio_level"
    dataFile <- GetNewDataFile(gSubNum, gWin, "sonar-task", "csv", dataHeader)

    ## Session-meta row: which config/plan was chosen (does not change column schema).
    ## block_id=__session__; response_mode=config_pick; vessel_name=stem; response=pickMode;
    ## outcome=seed_plan; signal_mode=pool list.
    metaRow <- [gSubNum, taskId, "__session__", "config_pick",
                0, "", gChosenConfigStem, gTaskPickMode, "", gSeedPlan, "",
                gTaskPoolRaw, "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""]
    FilePrint(dataFile, ConcatenateList(metaRow, ","))
    Print("Logged config_pick: stem=" + gChosenConfigStem + " plan=" + gSeedPlan + " mode=" + gTaskPickMode)


    ## --- Click-to-begin label ---
    gClickLbl <- MakeLabel("[ Click here to begin ]", gFontSmall)
    gReportStartTime <- GetTime()

    ## --- Run blocks ---
    jsonBlocks <- cfg.blocks
    loop(jb, jsonBlocks)
    {
        blockCfg <- BuildBlockCfg(jb, taskId)

        if(PropertyExists(jb, "vessels"))
        {
            ApplyVesselOverrides(jb.vessels, gVessels)
        }

        ## Hide thumbs AND plain buttons during instructions / click-to-begin.
        ## Otherwise Biological (show_thumbnail=0) stays on-screen alone and looks clickable.
        HideAllResponseOptions(gVessels)
        ShowBlockInstructions(blockCfg, gClickLbl)
        RunBlock(blockCfg, gVessels, gNoiseImgs, gDispY, gFbY, gOffscreenX, dataFile)

        if(PropertyExists(jb, "vessels"))
        {
            ApplyVesselOverrides(cfg.vessels, gVessels)
        }
    }

    ## --- Wrap up ---
    reportFile <- GenerateSonarReport(cfg, dataFile, gVessels, gReportTrials)
    UploadFile(gSubNum, reportFile.filename)
    FileClose(dataFile)
    UploadFile(gSubNum, dataFile.filename)

    done <- MakeLabel("Task complete. Click anywhere to exit.", gFontLarge)
    AddObject(done, gWin)
    Move(done, Round(gVideoWidth/2), Round(gVideoHeight/2))
    Draw()
    WaitForDownClick()
}
