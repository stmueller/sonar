## sonar-task.pbl  -- JSON-driven sonar decision-task simulator
## Cover story: narrowband waterfall / bearing display.
## Run from this directory:  ../pebl/bin/pebl2 sonar-task.pbl
## Configs: config/*.json  (task / tasks / taskPick params, or askuser picker)
##   task     — single stem, askuser, or comma-separated stems
##   tasks    — optional pool (comma-separated); when set, overrides task for pick
##   taskPick — random | first | subnum  (how to choose among multiple stems)
##
## Structure: Start → InitializeUI (display + audio) → loop RunBlock
##   RunBlock: SetupMode → trial loop (RunModeTrial) → TeardownMode
## Mode widgets (secretary/urns/horizon) are created lazily in SetupMode.
## Waterfall (noise + bg + stripes) loads only for display narrowband/cued;
## heading recipes load the bearing strip. No extra JSON flags.
## RT 2AFC (Simon) and go/no-go use WaitForLayoutResponse; gParams.responsemode
## selects keys vs mouse buttons vs on-screen targets (same param as the battery).
##
## gWin is the window (PEBL convention, not a builtin). Every widget, font,
## color, and sound that must outlive its creating function is stored in a
## g… variable or in a list a g… variable holds. AddObject does not keep
## counted pointers alive.


## ============================================================
## SIGNAL GENERATION
## ============================================================

define CopyList(lst)
{
    out <- []
    loop(x, lst) { PushOnEnd(out, x) }
    return(out)
}


define MakeCleanSig(baseSig)
{
    return(CopyList(baseSig))
}


## Truncated normal via rejection sampling (falls back to clamp after many tries).
define TruncatedNormal(mean, sd, lo, hi)
{
    if(lo > hi)
    {
        tmp <- lo
        lo <- hi
        hi <- tmp
    }
    x <- mean + RandomNormal(0, sd)
    tries <- 0
    while((x < lo or x > hi) and tries < 100)
    {
        tries <- tries + 1
        x <- mean + RandomNormal(0, sd)
    }
    if(x < lo) { x <- lo }
    if(x > hi) { x <- hi }
    return(x)
}


## Waterfall row width (Hz) for narrowband display — must match RenderNarrowband.
define NarrowbandRowWidthHz(f)
{
    rowW <- 1000
    if(f < 250) { rowW <- 250 }
    if(f >= 250 and f < 750) { rowW <- 500 }
    return(rowW)
}


## pct → Hz SD: jitter is proportional to ROW width (visual span), not band frequency.
## jitter_sd 10 → SD = 10% of row (25 Hz in row 1, 50 in row 2, 100 in row 3).
define JitterSdHz(f, pct)
{
    rowW <- NarrowbandRowWidthHz(f)
    sd <- rowW * pct / 100.0
    if(sd < 0.5) { sd <- 0.5 }
    return(sd)
}


## Validate a jittered signature: (1) bands stay in ascending order,
## (2) neighboring bands are at least minSep Hz apart (default 15).
## Returns 1 if OK, 0 if a redraw is needed.
define ValidateSignature(sig, minSep:15)
{
    ok <- 1
    if(minSep <= 0) { minSep <- 15 }
    n <- Length(sig)
    if(n >= 2)
    {
        i <- 1
        while(i < n and ok == 1)
        {
            a <- Nth(sig, i)
            b <- Nth(sig, i + 1)
            ## Out of order
            if(b < a) { ok <- 0 }
            ## Too close (also catches equal / near-equal)
            if(ok == 1)
            {
                if(b < a + minSep) { ok <- 0 }
            }
            i <- i + 1
        }
    }
    return(ok)
}


## Jitter each band with Normal(0, sdHz), truncated to ±truncSd·sdHz about the base
## (also clamped to the displayable 50–1750 Hz window). truncSd <= 0 defaults to 1.5.
## sd is a PERCENT of the waterfall row width (Hz), not of band frequency — e.g. 10 → ±10% of row span.
## Does not reshape draws: ValidateSignature rejects order reversals or bands
## closer than minSep Hz (default 15) and redraws.
define MakeJitteredSig(baseSig, sd, truncSd, minSep:15)
{
    if(truncSd <= 0) { truncSd <- 1.5 }
    if(minSep <= 0) { minSep <- 15 }
    sig <- []
    attempt <- 1
    done <- 0
    while(attempt <= 200 and done == 0)
    {
        sig <- []
        loop(f, baseSig)
        {
            sdHz <- JitterSdHz(f, sd)
            half <- truncSd * sdHz
            lo <- f - half
            hi <- f + half
            if(lo < 50)   { lo <- 50 }
            if(hi > 1750) { hi <- 1750 }
            jf <- Round(TruncatedNormal(f, sdHz, lo, hi))
            PushOnEnd(sig, jf)
        }
        if(ValidateSignature(sig, minSep) == 1) { done <- 1 }
        attempt <- attempt + 1
    }
    ## Extremely rare: keep last draw rather than force-reshape (preserves jitter dist).
    return(sig)
}



define MakeNoisySig(baseSig, nMin, nMax)
{
    sig    <- CopyList(baseSig)
    nNoise <- nMin + Round(Random() * (nMax - nMin))
    added  <- 0
    tries  <- 0
    while(added < nNoise and tries < 200)
    {
        tries <- tries + 1
        f <- Round(50 + Random() * 1700)
        tooClose <- 0
        loop(existing, sig)
        {
            if(Abs(f - existing) < 30) { tooClose <- 1 }
        }
        if(tooClose == 0)
        {
            PushOnEnd(sig, f)
            added <- added + 1
        }
    }
    return(sig)
}


define MakeMimicSig(baseSig, altSig, nMimic)
{
    sig    <- CopyList(baseSig)
    added  <- 0
    tries  <- 0
    while(added < nMimic and tries < 50)
    {
        tries <- tries + 1
        idx   <- Round(1 + Random() * (Length(altSig) - 1))
        f     <- Nth(altSig, idx)
        tooClose <- 0
        loop(existing, sig)
        {
            if(Abs(f - existing) < 30) { tooClose <- 1 }
        }
        if(tooClose == 0)
        {
            PushOnEnd(sig, f)
            added <- added + 1
        }
    }
    return(sig)
}


define MakeProbSig(baseSig, pShow)
{
    sig <- []
    loop(f, baseSig)
    {
        if(Random() < pShow) { PushOnEnd(sig, f) }
    }
    ## Only add noise bands when some target bands were suppressed.
    if(Length(sig) < Length(baseSig))
    {
        nRandom <- Round(1 + Random())
        added <- 0
        tries <- 0
        while(added < nRandom and tries < 200)
        {
            tries <- tries + 1
            f <- Round(50 + Random() * 1700)
            tooClose <- 0
            loop(existing, sig)
            {
                if(Abs(f - existing) < 30) { tooClose <- 1 }
            }
            if(tooClose == 0)
            {
                PushOnEnd(sig, f)
                added <- added + 1
            }
        }
    }
    if(Length(sig) == 0) { PushOnEnd(sig, Nth(baseSig, 1)) }
    return(sig)
}


## jitter + noisy combined
define MakeComboSig(baseSig, sd, nMin, nMax, truncSd, minSep:15)
{
    if(truncSd <= 0) { truncSd <- 1.5 }
    jittered <- MakeJitteredSig(baseSig, sd, truncSd, minSep)
    sig      <- MakeNoisySig(jittered, nMin, nMax)
    return(sig)
}


## Generate a target sig: each base band shown with pShow probability + small jitter.
## Additional alpha bands may appear (leakage) at rate pLeak per missing band.
## jitterSd is percent of waterfall row width (see JitterSdHz).
define MakeTargetSig(baseSig, pShow, jitterSd, pLeak)
{
    sig  <- []
    truncSd <- 1.5
    loop(f, baseSig)
    {
        if(Random() < pShow)
        {
            sdHz <- JitterSdHz(f, jitterSd)
            half <- truncSd * sdHz
            lo <- f - half
            hi <- f + half
            if(lo < 50)   { lo <- 50 }
            if(hi > 1750) { hi <- 1750 }
            jf <- Round(TruncatedNormal(f, sdHz, lo, hi))
            PushOnEnd(sig, jf)
        }
    }
    ## Leak: random extra bands near alpha frequencies (noise on target)
    loop(f, baseSig)
    {
        if(Random() < pLeak)
        {
            sdHz <- JitterSdHz(f, jitterSd * 2)
            half <- truncSd * sdHz
            lo <- f - half
            hi <- f + half
            if(lo < 50)   { lo <- 50 }
            if(hi > 1750) { hi <- 1750 }
            jf <- Round(TruncatedNormal(f, sdHz, lo, hi))
            tooClose <- 0
            loop(existing, sig)
            {
                if(Abs(jf - existing) < 30) { tooClose <- 1 }
            }
            if(tooClose == 0) { PushOnEnd(sig, jf) }
        }
    }
    if(Length(sig) == 0) { PushOnEnd(sig, Nth(baseSig, 1)) }
    return(sig)
}


## Generate a foil sig: random bands, but alpha bands bleed in at rate pAlphaLeak.
## This means foils sometimes look partly like the target, raising task difficulty.
## jitterSd is percent of waterfall row width (see JitterSdHz).
define MakeFoilSig(alphaSig, nBands, pAlphaLeak, jitterSd)
{
    sig  <- []
    rows <- [[50, 240], [260, 740], [760, 1740]]
    ## Each alpha band bleeds into foil with pAlphaLeak
    loop(f, alphaSig)
    {
        if(Random() < pAlphaLeak)
        {
            truncSd <- 1.5
            sdHz <- JitterSdHz(f, jitterSd)
            half <- truncSd * sdHz
            lo <- f - half
            hi <- f + half
            if(lo < 50)   { lo <- 50 }
            if(hi > 1750) { hi <- 1750 }
            jf <- Round(TruncatedNormal(f, sdHz, lo, hi))
            tooClose <- 0
            loop(existing, sig)
            {
                if(Abs(jf - existing) < 30) { tooClose <- 1 }
            }
            if(tooClose == 0) { PushOnEnd(sig, jf) }
        }
    }
    ## Fill remaining bands randomly
    added <- 0
    tries <- 0
    while(Length(sig) < nBands and tries < 200)
    {
        tries <- tries + 1
        ri    <- 1 + Round(Random() * 2)
        r     <- Nth(rows, ri)
        lo    <- Nth(r, 1)
        hi    <- Nth(r, 2)
        f     <- lo + Round(Random() * (hi - lo))
        tooClose <- 0
        loop(existing, sig)
        {
            if(Abs(f - existing) < 40) { tooClose <- 1 }
        }
        if(tooClose == 0) { PushOnEnd(sig, f) }
    }
    return(sig)
}


## Euclidean distance between two equal-length frequency lists.
define SigDistance(a, b)
{
    result <- 99999
    if(Length(a) == Length(b))
    {
        s <- 0
        i <- 1
        while(i <= Length(a))
        {
            d <- Nth(a, i) - Nth(b, i)
            s <- s + d * d
            i <- i + 1
        }
        result <- Sqrt(s)
    }
    return(result)
}


## All base + template signatures across vessels (for outlier avoidance).
define CollectAllVesselSigs(vessels)
{
    out <- []
    loop(v, vessels)
    {
        if(Length(v.sig) > 0) { PushOnEnd(out, v.sig) }
        loop(t, v.templates)
        {
            if(Length(t) > 0) { PushOnEnd(out, t) }
        }
    }
    return(out)
}


## Generate a random 5-band narrowband signature that does not match known templates.
## Bands are placed randomly across all 3 frequency rows (at least 1 per row).
## avoidSigs: list of signatures to stay away from; minDist: Euclidean Hz floor.
define MakeRandomNontargetSig(avoidSigs, minDist)
{
    if(minDist <= 0) { minDist <- 100 }
    rows <- [[50, 240], [260, 740], [760, 1740]]
    best <- []
    bestMin <- -1
    result <- []
    found <- 0
    attempt <- 1
    while(attempt <= 40 and found == 0)
    {
        sig  <- []
        ## Guarantee at least one band per row
        loop(r, rows)
        {
            lo <- Nth(r, 1)
            hi <- Nth(r, 2)
            f  <- lo + Round(Random() * (hi - lo))
            PushOnEnd(sig, f)
        }
        ## Add 2 more bands in random rows
        added <- 0
        tries <- 0
        while(added < 2 and tries < 200)
        {
            tries  <- tries + 1
            ri     <- 1 + Round(Random() * 2)
            r      <- Nth(rows, ri)
            lo     <- Nth(r, 1)
            hi     <- Nth(r, 2)
            f      <- lo + Round(Random() * (hi - lo))
            tooClose <- 0
            loop(existing, sig)
            {
                if(Abs(f - existing) < 40) { tooClose <- 1 }
            }
            if(tooClose == 0)
            {
                PushOnEnd(sig, f)
                added <- added + 1
            }
        }
        sig <- Sort(sig)
        ## Distance to nearest avoided prototype
        nearest <- 99999
        loop(av, avoidSigs)
        {
            a5 <- av
            s5 <- sig
            if(Length(a5) > 5) { a5 <- SubList(a5, 1, 5) }
            if(Length(s5) > 5) { s5 <- SubList(s5, 1, 5) }
            if(Length(a5) == Length(s5))
            {
                d <- SigDistance(s5, a5)
                if(d < nearest) { nearest <- d }
            }
        }
        if(Length(avoidSigs) == 0) { nearest <- minDist + 1 }
        if(nearest >= minDist)
        {
            result <- sig
            found <- 1
        }
        if(found == 0 and nearest > bestMin)
        {
            bestMin <- nearest
            best <- sig
        }
        attempt <- attempt + 1
    }
    if(found == 0)
    {
        result <- best
        if(Length(result) == 0) { result <- sig }
    }
    return(result)
}


## Generate a close foil: each Alpha band shifted by a medium offset (minShift..maxShift Hz)
## in a random direction, staying within the same frequency row. Looks structurally similar
## to Alpha but is consistently offset — requires careful comparison to reject.
define MakeCloseFoilSig(alphaSig, minShift, maxShift)
{
    row1Lo <- 0;   row1Hi <- 250
    row2Lo <- 250; row2Hi <- 750
    row3Lo <- 750; row3Hi <- 1750

    sig  <- []
    loop(f, alphaSig)
    {
        shift <- minShift + Round(Random() * (maxShift - minShift))
        if(Random() < 0.5) { shift <- 0 - shift }
        nf <- f + shift
        ## Clamp to row bounds so band stays in same row
        rowLo <- 50
        rowHi <- 1750
        if(f >= row1Lo and f < row1Hi) { rowLo <- row1Lo + 10; rowHi <- row1Hi - 10 }
        if(f >= row2Lo and f < row2Hi) { rowLo <- row2Lo + 10; rowHi <- row2Hi - 10 }
        if(f >= row3Lo and f <= row3Hi) { rowLo <- row3Lo + 10; rowHi <- row3Hi - 10 }
        if(nf < rowLo) { nf <- rowLo }
        if(nf > rowHi) { nf <- rowHi }
        PushOnEnd(sig, nf)
    }
    return(sig)
}


## Look up the alt-vessel signature for a given vessel_id.
## vessels: list of vessel property objects.
define GetAltSig(vesselId, vessels)
{
    alts <- []
    loop(v, vessels)
    {
        if(v.id != vesselId) { PushOnEnd(alts, v.sig) }
    }
    idx <- 1 + Floor(Random() * Length(alts))
    if(idx > Length(alts)) { idx <- Length(alts) }
    return(Nth(alts, idx))
}


## Look up a vessel object by id.
define GetVessel(vesselId, vessels)
{
    result <- Nth(vessels, 1)
    loop(v, vessels)
    {
        if(v.id == vesselId) { result <- v }
    }
    return(result)
}


## ============================================================
## AUDIO
## Bed (sounds/FX_BBbgnd.ogg) is the SABART ocean loop and the SFT
## noise backing. Start it once with SetPlayRepeats(-1); do not Play
## it again or the loop restarts. Vessel clips use a second stream.
## StopVesselStim never stops the bed.
## SetSoundLevel uses SetPanning(amp,amp) as a linear gain (no SetVolume).
## ============================================================

define SetSoundLevel(snd, amp)
{
    level <- amp
    if(level < 0) { level <- 0 }
    if(level > 1) { level <- 1 }
    SetPanning(snd, level, level)
}


define StartBed()
{
    if(gUseAudio == 1)
    {
        if(gBedSound != 0)
        {
            if(gBedPlaying == 0)
            {
                SetSoundLevel(gBedSound, gBedLevel)
                SetPlayRepeats(gBedSound, -1)
                PlayBackground(gBedSound)
                gBedPlaying <- 1
            }
        }
    }
}


define StopBed()
{
    if(gBedSound != 0)
    {
        Stop(gBedSound)
        gBedPlaying <- 0
    }
}


define InitAudio(cfg)
{
    gUseAudio <- 0
    if(gParams.useAudio == 1) { gUseAudio <- 1 }
    if(PropertyExists(cfg, "audio"))
    {
        if(cfg.audio == 1) { gUseAudio <- 1 }
    }

    gBedSound     <- 0
    gBedPlaying   <- 0
    gBedLevel     <- 1.0
    if(PropertyExists(cfg, "bed_level")) { gBedLevel <- cfg.bed_level }
    ## Fixed sample window for visual bands + vessel audio (0 = until response).
    gTaskStimMs   <- 0
    if(PropertyExists(cfg, "stim_ms")) { gTaskStimMs <- cfg.stim_ms }
    gTaskRespMs   <- 0
    if(PropertyExists(cfg, "resp_ms")) { gTaskRespMs <- cfg.resp_ms }
    gPingSound    <- 0
    gSuccessSound <- 0
    gErrorSound   <- 0
    ## Trial outcome feedback (correct/error). Loaded even when task audio is off
    ## so visual-only configs (e.g. nafc) still get chimes / chirp.
    successPath <- "sounds/successchimes.ogg"
    if(FileExists(successPath) == 1)
    {
        gSuccessSound <- LoadSound(successPath)
    }
    gErrorSound <- LoadSound("chirp1.ogg")
    if(gUseAudio == 1)
    {
        bedPath <- "sounds/FX_BBbgnd_mix.ogg"
        if(FileExists(bedPath) == 0) { bedPath <- "sounds/FX_BBbgnd_1080_1520.ogg" }
        if(FileExists(bedPath) == 0) { bedPath <- "sounds/FX_BBbgnd_pink.ogg" }
        if(FileExists(bedPath) == 0) { bedPath <- "sounds/FX_BBbgnd.ogg" }
        if(FileExists(bedPath) == 0) { bedPath <- "sounds/bgnd.ogg" }
        if(FileExists(bedPath) == 1)
        {
            gBedSound <- LoadSound(bedPath)
            StartBed()
        }
        pingPath <- "sounds/ping.ogg"
        if(FileExists(pingPath) == 1)
        {
            gPingSound <- LoadSound(pingPath)
        }
    }

    ## SFT salience defaults (adaptive blocks overwrite these).
    gVisJitterHi    <- 6
    gVisJitterLo    <- 20
    gAudGainHi           <- 1.0
    gAudGainLo           <- 0.25
    gAudGainLoPerVessel  <- []
    gAudMOLCalibrated    <- 0
    gVisCalibrated       <- 0
    gAudCalibrated       <- 0
    gCurrentJitter       <- 6
    gCurrentAudGain      <- 1.0
    gCurrentChannel      <- "both"
}


define PlayVesselStim(vessel)
{
    if(gUseAudio == 1)
    {
        if(gCurrentChannel != "visual")
        {
            if(vessel.hasSound == 1)
            {
                gain <- gCurrentAudGain
                if(gAudMOLCalibrated == 1 and gCurrentChannel != "visual")
                {
                    if(vessel.id <= Length(gAudGainLoPerVessel))
                    {
                        gain <- Nth(gAudGainLoPerVessel, vessel.id)
                    }
                }
                SetSoundLevel(vessel.snd, gain)
                SetPlayRepeats(vessel.snd, -1)
                PlayBackground(vessel.snd)
            }
        }
    }
}


define StopVesselStim(vessel)
{
    if(gUseAudio == 1)
    {
        if(vessel.hasSound == 1)
        {
            Stop(vessel.snd)
        }
    }
}


## Switch each vessel's active sound clip to hi or lo based on level.
define ApplyBlockAudio(vessels, level)
{
    loop(v, vessels)
    {
        if(level == "lo")
        {
            v.snd      <- v.sndLo
            v.hasSound <- v.hasSoundLo
        } else {
            v.snd      <- v.sndHi
            v.hasSound <- v.hasSoundHi
        }
    }
}


## Set gCurrentJitter / gCurrentAudGain / gCurrentChannel for this block.
## After adaptive calibration, hi/lo map to the subject's critical points.
define ApplySftStimulus(blockCfg, vessels)
{
    gCurrentChannel <- blockCfg.channel
    ApplyBlockAudio(vessels, "hi")

    jit <- blockCfg.signal_params.jitter_sd
    amp <- 1.0
    if(blockCfg.visual_level == "lo")
    {
        if(gVisCalibrated == 1) { jit <- gVisJitterLo }
    } else {
        if(gVisCalibrated == 1) { jit <- gVisJitterHi }
    }
    if(blockCfg.audio_level == "lo")
    {
        if(gAudCalibrated == 1) { amp <- gAudGainLo }
    } else {
        if(gAudCalibrated == 1) { amp <- gAudGainHi }
    }
    if(blockCfg.adaptive == 0)
    {
        gCurrentJitter  <- jit
        gCurrentAudGain <- amp
        blockCfg.signal_params.jitter_sd <- jit
    }
}


define PlayPing()
{
    if(gUseAudio == 1)
    {
        if(gPingSound != 0)
        {
            PlayBackground(gPingSound)
        }
    }
}


define PlaySuccess()
{
    if(gSuccessSound != 0)
    {
        PlayBackground(gSuccessSound)
    }
}


define PlayError()
{
    if(gErrorSound != 0)
    {
        PlayBackground(gErrorSound)
    }
}


## Correct → successchimes; incorrect → builtin chirp1. No-op if not loaded.
define PlayOutcomeSound(correct)
{
    if(correct == 1)
    {
        PlaySuccess()
    } else {
        PlayError()
    }
}


## Jitter only the bearing (first element); preserve halfWidth (second element).
define MakeJitteredHeadingSig(baseSig, sd)
{
    bearing   <- Nth(baseSig, 1)
    halfWidth <- Nth(baseSig, 2)
    jb <- bearing + Round(RandomNormal(0, sd))
    if(jb < 0)   { jb <- jb + 360 }
    if(jb >= 360){ jb <- jb - 360 }
    return([jb, halfWidth])
}


## Dispatch to the right signal generator based on mode string.
## For heading sigs (2-element [bearing, halfWidth]), jitter/combo only jitter bearing.
## True when template index ti is a random-gen class (kind == "random").
define TemplateIsRandom(vessel, ti)
{
    isRand <- 0
    if(ti > 0 and ti <= Length(vessel.template_kinds))
    {
        if(Nth(vessel.template_kinds, ti) == "random") { isRand <- 1 }
    }
    return(isRand)
}


## If vessel.n_templates > 0, draw one template signature as the base for this trial
## and record it on vessel.active_sig / vessel.active_template for logging.
## Also sets gLastActiveTemplate for identity feedback (avoids optional-arg loss).
## vessel.forced_template_idx > 0 pins the template (used by repetitions case lists).
## Template kind "random" (JSON) uses MakeRandomNontargetSig; label = template name.
## Legacy: forced_template_idx < 0, or outlier_p when unforced, still force a random outlier.
define GenerateSignal(vesselId, mode, params, vessels)
{
    vessel <- GetVessel(vesselId, vessels)
    baseSig <- vessel.sig
    vessel.active_template <- ""
    vessel.active_sig <- baseSig
    gLastActiveTemplate <- ""
    if(vessel.n_templates > 0)
    {
        ## Legacy probabilistic / negative-index outlier (kept for non–round-robin designs).
        useOutlier <- 0
        if(vessel.forced_template_idx < 0) { useOutlier <- 1 }
        if(vessel.forced_template_idx == 0 and vessel.outlier_p > 0)
        {
            if(Random() < vessel.outlier_p) { useOutlier <- 1 }
        }
        if(useOutlier == 1)
        {
            avoid <- CollectAllVesselSigs(vessels)
            baseSig <- MakeRandomNontargetSig(avoid, vessel.outlier_min_dist)
            vessel.active_sig <- baseSig
            vessel.active_template <- vessel.outlier_label
            gLastActiveTemplate <- vessel.outlier_label
            vessel.forced_template_idx <- 0
        } else {
            ti <- 1 + Floor(Random() * vessel.n_templates)
            if(ti > vessel.n_templates) { ti <- vessel.n_templates }
            if(vessel.forced_template_idx > 0)
            {
                ti <- vessel.forced_template_idx
                if(ti > vessel.n_templates) { ti <- vessel.n_templates }
            }
            tName <- Nth(vessel.template_names, ti)
            if(TemplateIsRandom(vessel, ti) == 1)
            {
                avoid <- CollectAllVesselSigs(vessels)
                baseSig <- MakeRandomNontargetSig(avoid, vessel.outlier_min_dist)
                if(tName == "") { tName <- vessel.outlier_label }
            } else {
                baseSig <- Nth(vessel.templates, ti)
            }
            vessel.active_sig <- baseSig
            vessel.active_template <- tName
            gLastActiveTemplate <- tName
            vessel.forced_template_idx <- 0
        }
    }
    isHeading <- 0
    if(Length(baseSig) == 2) { isHeading <- 1 }

    sig <- baseSig

    if(mode == "clean")
    {
        sig <- MakeCleanSig(baseSig)
    }
    if(mode == "jittered")
    {
        sd <- params.jitter_sd
        truncSd <- params.jitter_trunc_sd
        minSep <- params.jitter_min_sep
        if(isHeading == 1)
        {
            sig <- MakeJitteredHeadingSig(baseSig, sd)
        } else {
            sig <- MakeJitteredSig(baseSig, sd, truncSd, minSep)
        }
    }
    if(mode == "noisy")
    {
        if(isHeading == 1)
        {
            sig <- MakeCleanSig(baseSig)
        } else {
            nMin <- params.n_noise_min
            nMax <- params.n_noise_max
            sig <- MakeNoisySig(baseSig, nMin, nMax)
        }
    }
    if(mode == "mimic")
    {
        altSig <- GetAltSig(vesselId, vessels)
        nMimic <- params.n_mimic
        sig <- MakeMimicSig(baseSig, altSig, nMimic)
    }
    if(mode == "prob")
    {
        pShow <- params.p_show
        sig <- MakeProbSig(baseSig, pShow)
    }
    if(mode == "combo")
    {
        if(isHeading == 1)
        {
            sig <- MakeJitteredHeadingSig(baseSig, params.jitter_sd)
        } else {
            sd   <- params.jitter_sd
            nMin <- params.n_noise_min
            nMax <- params.n_noise_max
            truncSd <- params.jitter_trunc_sd
            minSep <- params.jitter_min_sep
            sig <- MakeComboSig(baseSig, sd, nMin, nMax, truncSd, minSep)
        }
    }

    return(sig)
}


## ============================================================
## SIGNAL ANALYSIS HELPERS
## ============================================================

define CountMatches(sig, baseSig)
{
    n <- 0
    loop(f, sig)
    {
        loop(b, baseSig)
        {
            if(Abs(f - b) < 5) { n <- n + 1 }
        }
    }
    return(n)
}


define SigToStr(sig)
{
    s <- ""
    first <- 1
    loop(f, sig)
    {
        if(first == 1)
        {
            s <- "" + f
            first <- 0
        } else {
            s <- s + ";" + f
        }
    }
    return(s)
}


## ============================================================
## DISPLAY
## ============================================================

## Look up a stripe PNG for row_num (1-3), random variant 0-7.
## Loaded per call from RenderNarrowband — heading tasks never reach this.
define StripeFilename(rowNum)
{
    v    <- Round(Random() * 7)
    vstr <- "" + v
    if(v < 10) { vstr <- "0" + v }
    return("img/stripes/stripe_r" + rowNum + "_v" + vstr + ".png")
}


## Waterfall stack: 20 noise overlays + waterfall_bg. Driven by display
## (narrowband / cued), not a separate flag. Heading recipes skip this.
define EnsureWaterfall()
{
    if(gWaterfallReady == 0)
    {
        gNoiseImgs <- []
        noiseIdx   <- 0
        while(noiseIdx < 20)
        {
            if(noiseIdx < 10)
            {
                npath <- "img/noise/waterfall_noise_0" + noiseIdx + ".jpg"
            } else {
                npath <- "img/noise/waterfall_noise_" + noiseIdx + ".jpg"
            }
            nimg <- MakeImage(npath)
            nimg.zoomx <- gZoom
            nimg.zoomy <- gZoom
            AddObject(nimg, gWin)
            Move(nimg, gOffscreenX, gDispY)
            PushOnEnd(gNoiseImgs, nimg)
            noiseIdx <- noiseIdx + 1
        }

        gBg <- MakeImage("img/waterfall_bg.png")
        AddObject(gBg, gWin)
        gBg.zoomx <- gZoom
        gBg.zoomy <- gZoom
        Move(gBg, gOffscreenX, gDispY)
        gWaterfallReady <- 1
    }
}


define EnsureHeading()
{
    if(gHeadingReady == 0)
    {
        gHeadingBg <- MakeImage("img/heading_bg.png")
        AddObject(gHeadingBg, gWin)
        gHeadingBg.zoomx <- gZoom
        gHeadingBg.zoomy <- gZoom
        Move(gHeadingBg, gOffscreenX, gDispY)
        gHeadingReady <- 1
    }
}


define PickNoiseOverlay()
{
    EnsureWaterfall()
    noiseChoice <- Round(Random() * (Length(gNoiseImgs) - 1)) + 1
    return(Nth(gNoiseImgs, noiseChoice))
}


## Render frequency stripes on the waterfall background.
## Returns list of created image objects (for later removal).
define RenderNarrowband(sig, zoom, dispY)
{
    EnsureWaterfall()

    bgW  <- 2000
    stripeNativeW <- 80
    stripeNativeH <- 283
    row1Top <- 60;  row2Top <- 381;  row3Top <- 702
    contentLeft <- 50
    contentW    <- 1950
    row1Lo <- 0;   row1Hi <- 250
    row2Lo <- 250; row2Hi <- 750
    row3Lo <- 750; row3Hi <- 1750

    bgScreenLeft <- Round(gVideoWidth/2 - bgW * zoom / 2.0)
    bgScreenTop  <- Round(dispY        - 1000 * zoom / 2.0)

    imgW <- Round(stripeNativeW * zoom)
    imgH <- Round(stripeNativeH * zoom)

    imgs <- []

    loop(freq, sig)
    {
        rowTop  <- 0
        rowNum  <- 0
        freqLo  <- 0
        freqHi  <- 1
        inRow   <- 0

        if(freq >= row1Lo and freq < row1Hi)
        {
            rowTop <- row1Top; rowNum <- 1
            freqLo <- row1Lo;  freqHi <- row1Hi; inRow <- 1
        }
        if(freq >= row2Lo and freq < row2Hi)
        {
            rowTop <- row2Top; rowNum <- 2
            freqLo <- row2Lo;  freqHi <- row2Hi; inRow <- 1
        }
        if(freq >= row3Lo and freq <= row3Hi)
        {
            rowTop <- row3Top; rowNum <- 3
            freqLo <- row3Lo;  freqHi <- row3Hi; inRow <- 1
        }

        if(inRow == 1)
        {
            freqXNative <- contentLeft + Round((freq - freqLo) / (freqHi - freqLo) * contentW)
            screenX <- bgScreenLeft + Round(freqXNative * zoom)
            screenY <- bgScreenTop  + Round((rowTop + 5 + stripeNativeH / 2) * zoom)

            fname <- StripeFilename(rowNum)
            img   <- MakeImage(fname)
            img.zoomx <- zoom * gStripeStretch
            img.zoomy <- zoom
            AddObject(img, gWin)
            Move(img, screenX, screenY)
            PushOnEnd(imgs, img)
        }
    }

    return(imgs)
}


define ClearDisplay(imgs)
{
    loop(img, imgs) { RemoveObject(img, gWin) }
}


## Render a bearing contact on the heading display.
## sig = [bearing, halfWidthDeg] where bearing is 0-359.
## Draws a bright center bar plus a wider dim glow bar.
## Returns list of canvas objects (for later removal via ClearDisplay).
## contactType: "solid" (rectangle bar) or "noisy" (stripe image — biological contact).
define RenderHeading(sig, zoom, dispY, contactType)
{
    EnsureHeading()

    bgNativeW <- 2000
    bgNativeH <- 200

    bgScreenLeft <- Round(gVideoWidth / 2 - bgNativeW * zoom / 2.0)
    bgScreenCY   <- dispY

    bearing   <- Nth(sig, 1)
    halfWidth <- Nth(sig, 2)

    bearingX <- Round(bearing / 360.0 * bgNativeW)
    screenX  <- bgScreenLeft + Round(bearingX * zoom)

    imgs <- []

    if(contactType == "noisy")
    {
        ## Biological contact: dense noisy blob image, randomly selected variant
        v     <- Round(Random() * 7)
        fname <- "img/stripes/bio_heading_v0" + v + ".png"
        stripeNativeH <- 283
        barH  <- Round(bgNativeH * zoom * 0.85)
        ## Fixed width: ~20px on screen regardless of halfWidth parameter
        barW  <- Round(20 * zoom * 4)
        if(barW < 12) { barW <- 12 }
        stripeImg <- MakeImage(fname)
        stripeImg.zoomx <- barW / 40.0
        stripeImg.zoomy <- barH / stripeNativeH
        AddObject(stripeImg, gWin)
        Move(stripeImg, screenX, bgScreenCY)
        PushOnEnd(imgs, stripeImg)
    } else {
        ## Solid contact: glow + center rectangle bars
        glowW   <- Round(halfWidth * 2 * bgNativeW / 360.0 * zoom) + 6
        if(glowW < 8) { glowW <- 8 }
        glowH   <- Round(bgNativeH * zoom * 0.7)
        glowCol <- MakeColorRGB(0, 120, 0)
        glowImg <- Rectangle(screenX, bgScreenCY, glowW, glowH, glowCol, 1)
        AddObject(glowImg, gWin)
        Move(glowImg, screenX, bgScreenCY)
        PushOnEnd(imgs, glowImg)

        barW   <- Round(halfWidth * bgNativeW / 360.0 * zoom) + 2
        if(barW < 4) { barW <- 4 }
        barH   <- Round(bgNativeH * zoom * 0.85)
        barCol <- MakeColorRGB(60, 230, 60)
        barImg <- Rectangle(screenX, bgScreenCY, barW, barH, barCol, 1)
        AddObject(barImg, gWin)
        Move(barImg, screenX, bgScreenCY)
        PushOnEnd(imgs, barImg)
    }

    return(imgs)
}


## Build a heading thumbnail canvas showing bearing strip + contact.
## sig = [bearing, halfWidthDeg]. contactType: "solid" or "noisy".
define MakeHeadingThumbnail(sig, x, y, win, contactType, zoom)
{
    ## Build at actual display pixel size — avoid zoom on canvas (breaks at zoom<1)
    tw <- Round(240 * zoom)
    th <- Round(60  * zoom)
    if(tw < 1) { tw <- 1 }
    if(th < 1) { th <- 1 }

    bgDark  <- MakeColorRGB(0, 20, 0)
    lineCol <- MakeColorRGB(0, 160, 0)
    glowCol <- MakeColorRGB(0, 100, 0)
    barCol  <- MakeColorRGB(60, 230, 60)

    canvas <- MakeCanvas(tw, th, bgDark)
    AddObject(canvas, win)
    Move(canvas, x, y)

    baseline <- Rectangle(tw/2, th/2, tw, 2, lineCol, 1)
    AddObject(baseline, canvas)
    Draw(baseline)

    cx <- tw / 2

    extras <- []

    if(contactType == "noisy")
    {
        fname     <- "img/stripes/bio_heading_v00.png"
        barW      <- Round(30 * zoom)
        if(barW < 1) { barW <- 1 }
        stripeImg <- MakeImage(fname)
        stripeImg.zoomx <- barW / 40.0
        stripeImg.zoomy <- (th - 4) / 283.0
        AddObject(stripeImg, canvas)
        Move(stripeImg, cx, th/2)
        Draw(stripeImg)
        PushOnEnd(extras, stripeImg)
    } else {
        glowW <- Round(20 * zoom)
        barW2 <- Round(8  * zoom)
        if(glowW < 1) { glowW <- 1 }
        if(barW2 < 1) { barW2 <- 1 }
        glowBar <- Rectangle(cx, th/2, glowW, th - 4, glowCol, 1)
        AddObject(glowBar, canvas)
        Draw(glowBar)

        bar <- Rectangle(cx, th/2, barW2, th - 4, barCol, 1)
        AddObject(bar, canvas)
        Draw(bar)
        PushOnEnd(extras, glowBar)
        PushOnEnd(extras, bar)
    }

    Draw(canvas)

    obj          <- MakeCustomObject("heading_thumb")
    obj.canv     <- canvas
    obj.baseline <- baseline
    obj.extras   <- extras
    obj.bgDark   <- bgDark
    obj.lineCol  <- lineCol
    obj.glowCol  <- glowCol
    obj.barCol   <- barCol
    obj.x        <- x
    obj.y        <- y
    obj.width    <- tw
    obj.height   <- th
    return(obj)
}


## ============================================================
## SCORING AND FEEDBACK
## ============================================================

## Returns [correct, points, outcomeLabel]
define ScoreTrial(vesselId, response, blockCfg)
{
    correct <- 0
    if(response == vesselId) { correct <- 1 }

    ## Determine signal/noise trial for fa/cr distinction.
    ## signal_vessel_id == 0 means no target designation (treat all as signal trials).
    isSignalTrial <- 1
    if(blockCfg.signal_vessel_id != 0 and vesselId != blockCfg.signal_vessel_id)
    {
        isSignalTrial <- 0
    }

    ## Assign 4-way outcome label.
    if(isSignalTrial == 1 and correct == 1) { outcomeLabel <- "hit"  }
    if(isSignalTrial == 1 and correct == 0) { outcomeLabel <- "miss" }
    if(isSignalTrial == 0 and correct == 0) { outcomeLabel <- "fa"   }
    if(isSignalTrial == 0 and correct == 1) { outcomeLabel <- "cr"   }

    points <- 0
    fbType <- blockCfg.feedback
    ## Classic hit/miss/fa/cr table. Confidence scoring is applied later in RunTrial
    ## (after CollectConfidence). Keep outcome payoffs when scoring=="outcome" or
    ## legacy feedback=="payoff" without confidence scoring.
    useOutcomePay <- 0
    if(blockCfg.scoring == "outcome") { useOutcomePay <- 1 }
    if(fbType == "payoff" and blockCfg.scoring != "confidence") { useOutcomePay <- 1 }

    if(useOutcomePay == 1)
    {
        if(outcomeLabel == "hit")  { points <- blockCfg.payoff_hit  }
        if(outcomeLabel == "miss") { points <- blockCfg.payoff_miss }
        if(outcomeLabel == "fa")   { points <- blockCfg.payoff_fa   }
        if(outcomeLabel == "cr")   { points <- blockCfg.payoff_cr   }
    }

    ## Probabilistic feedback flip: shown as incorrect when truly correct (and vice versa).
    ## Recorded correct value is always the true one.
    reportedCorrect <- correct
    if(Random() < blockCfg.p_flip_feedback) { reportedCorrect <- 1 - correct }

    return([correct, points, outcomeLabel, reportedCorrect])
}


## Points for confidence scoring: index conf (1..N) into correct/incorrect tables.
## Tables may be asymmetric; omit incorrect in JSON to auto-negate correct (symmetric).
define ConfidencePayoff(correct, conf, blockCfg)
{
    pts <- 0
    n <- Length(blockCfg.payoff_correct_by_conf)
    if(n > 0)
    {
        if(conf < 1) { conf <- 1 }
        if(conf > n) { conf <- n }
        if(correct == 1)
        {
            pts <- Nth(blockCfg.payoff_correct_by_conf, conf)
        } else {
            nBad <- Length(blockCfg.payoff_incorrect_by_conf)
            if(nBad < 1)
            {
                pts <- 0 - Nth(blockCfg.payoff_correct_by_conf, conf)
            } else {
                if(conf > nBad) { conf <- nBad }
                pts <- Nth(blockCfg.payoff_incorrect_by_conf, conf)
            }
        }
    }
    return(pts)
}


## Credit points to block + cumulative totals. HUD updates immediately unless
## feedback is "none" (deferred to ShowBlockScoreSummary at block end).
define CreditScore(points, blockCfg)
{
    scored <- 0
    scoringOn <- 0
    if(blockCfg.scoring == "confidence") { scoringOn <- 1 }
    if(blockCfg.scoring == "outcome") { scoringOn <- 1 }
    if(blockCfg.feedback == "payoff") { scoringOn <- 1 }
    if(scoringOn == 1)
    {
        gBlockScore <- gBlockScore + points
        gCumulScore <- gCumulScore + points
        if(blockCfg.feedback != "none")
        {
            gScoreHUD.text <- "Score: " + gCumulScore
            Draw()
        }
        scored <- 1
    }
    return(scored)
}


## Update the persistent score HUD label (legacy helper; prefers CreditScore).
define UpdateScoreHUD(points)
{
    gCumulScore <- gCumulScore + points
    gScoreHUD.text <- "Score: " + gCumulScore
    Draw()
}


## End-of-block score panel (always used when scoring is active).
## Shows accuracy + points in a formatted text box with solid background.
define ShowBlockScoreSummary(blockCfg)
{
    showed <- 0
    scoringOn <- 0
    if(blockCfg.scoring == "confidence") { scoringOn <- 1 }
    if(blockCfg.scoring == "outcome") { scoringOn <- 1 }
    if(blockCfg.feedback == "payoff") { scoringOn <- 1 }
    if(scoringOn == 1)
    {
        gScoreHUD.text <- "Score: " + gCumulScore
        blk <- gBlockScore
        signBlk <- "+" + blk
        if(blk < 0) { signBlk <- "" + blk }
        nOk <- gBlockNCorrect
        nTot <- gBlockNTrials
        pct <- 0
        if(nTot > 0) { pct <- Round(100.0 * nOk / nTot) }
        blkLabel <- blockCfg.label
        if(blkLabel == "") { blkLabel <- blockCfg.id }

        msg <- "<h2>Block complete</h2><br><hr><br>" +
               "<p size=105><b>" + blkLabel + "</b></p><br><br>" +
               "<p size=120><b>Accuracy:</b>  " + nOk + " / " + nTot +
               "   (" + pct + "%)</p><br>" +
               "<p size=120><b>Block points:</b>  " + signBlk + "</p><br>" +
               "<p size=120><b>Total score:</b>  " + gCumulScore + "</p><br><br>" +
               "<p size=90 color='#aaaaaa'>Click below to continue</p>"

        tbW <- Round(gVideoWidth * 0.52)
        tbH <- Round(gVideoHeight * 0.40)
        tbX <- Round((gVideoWidth - tbW) / 2)
        tbY <- Round(gVideoHeight * 0.22)
        pad <- 18
        cx <- Round(gVideoWidth / 2)
        cy <- Round(tbY + tbH / 2)
        panel <- Rectangle(cx, cy, tbW + 2 * pad, tbH + 2 * pad,
                           MakeColorRGB(20, 42, 72), 1)
        AddObject(panel, gWin)
        ## White text on dark panel fill (EasyTextBox bgcolor = box background).
        tb <- EasyTextBox(msg, tbX, tbY, gWin, 22, tbW, tbH, "white", "#142a48")
        SetProperty(tb, "FORMATTED", 1)

        AddObject(gClickLbl, gWin)
        Move(gClickLbl, cx, Round(tbY + tbH + pad + 28))
        Draw()
        WaitForClickOnTarget([gClickLbl], [1])
        RemoveObject(tb, gWin)
        RemoveObject(panel, gWin)
        RemoveObject(gClickLbl, gWin)
        Draw()
        showed <- 1
    }
    return(showed)
}


## Label for identity feedback: vessel name, or active biological template
## (shrimp / dolphin pod / whale / school of whitefish) when present.
## Prefers vessel.active_template, then gLastActiveTemplate (set in GenerateSignal).
## Multi-template vessels never return the class name alone (e.g. not "Biological").
define FeedbackTargetLabel(vesselId, vessels)
{
    label <- ""
    if(vesselId > 0)
    {
        v <- GetVessel(vesselId, vessels)
        if(v.n_templates > 0)
        {
            label <- v.active_template
            if(label == "") { label <- gLastActiveTemplate }
        } else {
            label <- v.name
        }
    }
    return(label)
}


## Show feedback; optional center click recenters the cursor (no warp on web).
## Identity text comes from gFeedbackTargetLabel (set by caller) — PEBL optional
## string args after click:0 were dropping the template name (bare "CORRECT").
define ApplyFeedback(correct, points, blockCfg, fbY, click:0)
{
    fbType <- blockCfg.feedback
    msg    <- 0
    showed <- 0
    targetLabel <- gFeedbackTargetLabel
    ## Default: gutter between panel bottom and response row (fbY / gFbY).
    ## Avoids covering vessel thumbnails / Biological label at the bottom.
    fbPosY <- fbY
    if(fbPosY == 0) { fbPosY <- gFbY }

    ## Optional points suffix when scoring alongside identity/accuracy feedback.
    ptSuffix <- ""
    scoringOn <- 0
    if(blockCfg.scoring == "confidence") { scoringOn <- 1 }
    if(blockCfg.scoring == "outcome") { scoringOn <- 1 }
    if(scoringOn == 1)
    {
        if(points >= 0)
        {
            ptSuffix <- "  (+" + points + " pts)"
        } else {
            ptSuffix <- "  (" + points + " pts)"
        }
    }

    if(fbType == "accuracy")
    {
        fbText <- "CORRECT"
        if(correct == 0) { fbText <- "INCORRECT" }
        msg <- MakeLabel(fbText + ptSuffix, gFontFB)
        AddObject(msg, gWin)
        Move(msg, Round(gVideoWidth/2), fbPosY)
        showed <- 1
    }

    if(fbType == "identity")
    {
        ## Always name the true contact (Kilo-A / Kilo-B / shrimp / …).
        fbText <- "CORRECT — " + targetLabel
        if(correct == 0)
        {
            fbText <- "INCORRECT — was: " + targetLabel
        }
        if(targetLabel == "")
        {
            fbText <- "CORRECT"
            if(correct == 0) { fbText <- "INCORRECT" }
        }
        msg <- MakeLabel(fbText + ptSuffix, gFontFB)
        AddObject(msg, gWin)
        Move(msg, Round(gVideoWidth/2), fbPosY)
        showed <- 1
    }

    if(fbType == "payoff")
    {
        ## Score already credited via CreditScore; only show trial points here.
        if(points >= 0)
        {
            ptStr <- "+" + points + " pts"
        } else {
            ptStr <- "" + points + " pts"
        }
        msg <- MakeLabel(ptStr, gFontFB)
        AddObject(msg, gWin)
        Move(msg, Round(gVideoWidth/2), fbPosY)
        showed <- 1
    }

    if(showed == 1)
    {
        PlayOutcomeSound(correct)
        if(click == 1)
        {
            ## 2AFC recenter path only — keep feedback near the recenter control.
            Move(msg, gRecenterX, gRecenterY - 36)
            Move(gRecenterLbl, gRecenterX, gRecenterY)
            Draw()
            WaitForClickOnTarget([gRecenterLbl], [1])
            Move(gRecenterLbl, gOffscreenX, gDispY)
        } else {
            if(blockCfg.feedback_error_click == 1 and correct == 0)
            {
                ## Keep stim+feedback on screen until participant inspects and clicks.
                hint <- MakeLabel("Click anywhere to continue", gFontLbl)
                AddObject(hint, gWin)
                Move(hint, Round(gVideoWidth / 2), Round(fbPosY + 36))
                Draw()
                WaitForDownClick()
                ClearEventLoop()
                RemoveObject(hint, gWin)
            } else {
                Draw()
                Wait(600)
            }
        }
        RemoveObject(msg, gWin)
        Draw()
    }
}


## ============================================================
## RESPONSE LAYOUT (pebl-lib Layout.pbl)
## Recipe response_mode is the paradigm. gParams.responsemode is the
## input device (auto / keyboardShift / mousebutton / mousetarget / …).
## ============================================================

define GonogoModeName()
{
    name   <- gParams.responsemode
    result <- "spacebar"
    if(name == "mousebutton" or name == "leftclick" or name == "touchscreen")
    {
        result <- "leftclick"
    }
    if(name == "mousetarget" or name == "touchtarget" or name == "clicktarget")
    {
        result <- "clicktarget"
    }
    return(result)
}


define HideLayoutUI(layout)
{
    layout.header.visible    <- 0
    layout.subheader.visible <- 0
    layout.footer.visible    <- 0
    Hide(layout.header)
    Hide(layout.subheader)
    Hide(layout.footer)
    loop(l, layout.responseLabels) { Hide(l) }
    loop(b, layout.responseBorders) { Hide(b) }
}


define ShowLayoutUI(layout)
{
    layout.header.visible    <- 0
    layout.subheader.visible <- 0
    layout.footer.visible    <- 1
    Hide(layout.header)
    Hide(layout.subheader)
    Show(layout.footer)
    loop(l, layout.responseLabels) { Show(l) }
    if(layout.responseMode.type == "mousetarget")
    {
        loop(b, layout.responseBorders) { Show(b) }
    } else {
        loop(b, layout.responseBorders) { Hide(b) }
    }
}


define Ensure2AFCLayout()
{
    if(gLayout2AFCReady == 0)
    {
        gParams.responsesemantics <- "2afc"
        ## Number-row 2AFC: 1 = left, 0 = right (same hand positions as confidence 1–2–9–0).
        gParams.customkeys <- ["1", "0"]
        gParams.customlabels <- ["1 for <SEMANTIC>", "0 for <SEMANTIC>"]
        gLayout2AFC <- CreateLayout("sonar-task", gWin, gParams)
        HideLayoutUI(gLayout2AFC)
        gLayout2AFCReady <- 1
    }
}


define EnsureGoLayout()
{
    if(gGoLayoutReady == 0)
    {
        savedMode <- gParams.responsemode
        gParams.responsesemantics <- "gonogo"
        gParams.responsemode <- GonogoModeName()
        gGoLayout <- CreateLayout("sonar-task", gWin, gParams)
        gParams.responsemode <- savedMode
        HideLayoutUI(gGoLayout)
        gGoLayoutReady <- 1
    }
}


define LayoutWantsRecenter(layout)
{
    result <- 0
    if(layout.responseMode.type == "mousetarget") { result <- 1 }
    return(result)
}


## ============================================================
## TRIAL RUNNER
## ============================================================

## Choose vessel_id for this trial given base_rate / vessel_rates and vessel list.
## If blockCfg.forced_vessel_id > 0, use that directly (for balanced sequences).
## If blockCfg.has_vessel_rates == 1 and Length(vessel_rates) == n vessels:
##   multinomial sample in vessel-list order (e.g. [0.5, 0.1, 0.4]).
## Else 2 vessels: base_rate = P(vessel 1), 1-base_rate = P(vessel 2).
## Else 3+ vessels: uniform across all vessels (base_rate ignored).
define PickVessel(blockCfg, vessels)
{
    nVessels <- Length(vessels)
    v1       <- Nth(vessels, 1)
    vesselId <- v1.id

    if(blockCfg.forced_vessel_id > 0)
    {
        vesselId <- blockCfg.forced_vessel_id
    } else {
        if(blockCfg.has_vessel_rates == 1 and Length(blockCfg.vessel_rates) == nVessels)
        {
            r      <- Random()
            cum    <- 0
            picked <- 0
            i      <- 1
            loop(rate, blockCfg.vessel_rates)
            {
                cum <- cum + rate
                if(picked == 0 and r < cum)
                {
                    tmpV     <- Nth(vessels, i)
                    vesselId <- tmpV.id
                    picked   <- 1
                }
                i <- i + 1
            }
            if(picked == 0)
            {
                tmpV     <- Nth(vessels, nVessels)
                vesselId <- tmpV.id
            }
        } else {
            if(nVessels == 2)
            {
                baseRate <- blockCfg.base_rate
                v2 <- Nth(vessels, 2)
                if(Random() < baseRate)
                {
                    vesselId <- v1.id
                } else {
                    vesselId <- v2.id
                }
            } else {
                idx  <- 1 + Floor(Random() * nVessels)
                if(idx > nVessels) { idx <- nVessels }
                tmpV <- Nth(vessels, idx)
                vesselId <- tmpV.id
            }
        }
    }

    return(vesselId)
}


## True when gParams.responsemode is keyboard-oriented (incl. auto → keys for 2AFC).
define ConfidenceUsesKeys()
{
    mode <- gParams.responsemode
    useKeys <- 1
    if(mode == "mousetarget" or mode == "mousebutton" or mode == "touchtarget")
    {
        useKeys <- 0
    }
    if(mode == "clicktarget" or mode == "touchscreen" or mode == "leftclick")
    {
        useKeys <- 0
    }
    return(useKeys)
}


## Resolve "mouse" | "keyboard" | "auto" | "either" → useKeys (1=keyboard, 0=mouse buttons).
## "auto" follows gParams.responsemode via ConfidenceUsesKeys().
## "either" uses mouse buttons (keys not dual-polled here).
define ConfidenceInputUsesKeys(inputMode)
{
    useKeys <- 0
    if(inputMode == "keyboard")
    {
        useKeys <- 1
    } else {
        if(inputMode == "auto")
        {
            useKeys <- ConfidenceUsesKeys()
        }
    }
    return(useKeys)
}


## Show an N-point confidence scale after a response (default 4).
## Returns 1 (low) … nLevels (certain).
## nLevels=4: keys 1–2–9–0 (legacy left/right hand on number row).
## nLevels=5: keys 1–2–3–4–5.
## inputMode: "mouse" | "keyboard" | "auto" | "either" (see ConfidenceInputUsesKeys).
define CollectConfidence(fbY, nLevels:4, inputMode:"auto")
{
    if(nLevels != 5) { nLevels <- 4 }

    ## 4-level: keys spaced for left-hand then right-hand (1 2 … 9 0).
    ## 5-level: consecutive 1–5.
    confLabels <- ["1: Guess", "2: Unsure", "9: Fairly sure", "0: Certain"]
    confKeys   <- ["1", "2", "9", "0"]
    btnW       <- 160
    if(nLevels == 5)
    {
        confLabels <- ["1: Guess", "2: Unsure", "3: Moderate", "4: Fairly sure", "5: Certain"]
        confKeys   <- ["1", "2", "3", "4", "5"]
        btnW       <- 130
    }
    btnH   <- 55
    gap    <- 12
    totalW <- nLevels * btnW + (nLevels - 1) * gap
    startX <- Round(gVideoWidth / 2 - totalW / 2 + btnW / 2)
    btnY   <- fbY - 20
    useKeys <- ConfidenceInputUsesKeys(inputMode)

    promptText <- "How confident? Click a button"
    if(useKeys == 1)
    {
        promptText <- "How confident? Press 1, 2, 9, or 0"
        if(nLevels == 5)
        {
            promptText <- "How confident? Press 1, 2, 3, 4, or 5"
        }
    }
    promptY <- btnY - 50

    ## Dark-grey panel behind prompt + scale so broadband/waterfall does not show through.
    padX    <- 28
    padY    <- 22
    panelW  <- totalW + 2 * padX
    panelTop <- promptY - 28
    panelBot <- btnY + Round(btnH / 2) + padY
    panelH  <- panelBot - panelTop
    panelX  <- Round(gVideoWidth / 2)
    panelY  <- Round((panelTop + panelBot) / 2)
    panelCol <- MakeColorRGB(45, 45, 45)
    PushOnEnd(gKeep, panelCol)
    panel <- Rectangle(panelX, panelY, panelW, panelH, panelCol, 1)
    AddObject(panel, gWin)

    promptFont <- MakeFont(gPEBLBaseFont, 0, 20, MakeColor("white"), MakeColor("black"), 0)
    prompt     <- MakeLabel(promptText, promptFont)
    AddObject(prompt, gWin)
    Move(prompt, Round(gVideoWidth/2), promptY)

    btnObjs  <- []
    lblObjs  <- []
    btnIds   <- []
    btnFont  <- MakeFont(gPEBLBaseFont, 0, 16, MakeColor("white"), MakeColor("black"), 0)
    btnCol   <- MakeColorRGB(40, 80, 120)

    i <- 1
    while(i <= nLevels)
    {
        bx  <- startX + (i - 1) * (btnW + gap)
        btn <- Rectangle(bx, btnY, btnW, btnH, btnCol, 1)
        lbl <- MakeLabel(Nth(confLabels, i), btnFont)
        AddObject(btn, gWin)
        AddObject(lbl, gWin)
        Move(lbl, bx, btnY)
        PushOnEnd(btnObjs, btn)
        PushOnEnd(lblObjs, lbl)
        PushOnEnd(btnIds, i)
        i <- i + 1
    }

    Draw()
    conf <- 0
    if(useKeys == 1)
    {
        ## Visual scale stays on screen as a reminder; response is keyboard-only.
        key <- WaitForListKeyPress(confKeys)
        if(nLevels == 5)
        {
            if(key == "1") { conf <- 1 }
            if(key == "2") { conf <- 2 }
            if(key == "3") { conf <- 3 }
            if(key == "4") { conf <- 4 }
            if(key == "5") { conf <- 5 }
        } else {
            if(key == "1") { conf <- 1 }
            if(key == "2") { conf <- 2 }
            if(key == "9") { conf <- 3 }
            if(key == "0") { conf <- 4 }
        }
    } else {
        conf <- WaitForClickOnTarget(btnObjs, btnIds)
    }

    ## Dismiss immediately and redraw before caller runs feedback / ISI.
    ## Without Draw() here the overlay stays on screen until the next trial paints.
    RemoveObject(prompt, gWin)
    loop(b, btnObjs) { RemoveObject(b, gWin) }
    loop(l, lblObjs) { RemoveObject(l, gWin) }
    RemoveObject(panel, gWin)
    ClearEventLoop()
    Draw()

    return(conf)
}


## Build the button list for WaitForClickOnTarget.
## Global show_thumbnails=0 → all plain buttons.
## Global show_thumbnails=1 → per-vessel v.show_thumbnail (1=thumb canvas, 0=plain button).
define BuildButtons(vessels, showThumbnails)
{
    btnObjs <- []
    btnIds  <- []
    loop(v, vessels)
    {
        useThumb <- 0
        if(showThumbnails == 1 and v.show_thumbnail == 1) { useThumb <- 1 }
        if(useThumb == 1)
        {
            PushOnEnd(btnObjs, v.thumbImg)
        } else {
            PushOnEnd(btnObjs, v.btn)
        }
        PushOnEnd(btnIds, v.id)
    }
    return([btnObjs, btnIds])
}


## Park every response control offscreen (thumbs, labels, plain buttons).
## Use before instructions / click-to-begin so Biological is not alone and clickable.
define HideAllResponseOptions(vessels)
{
    loop(v, vessels)
    {
        Hide(v.thumbImg)
        Hide(v.lbl)
        Move(v.btn,    gOffscreenX, v.btnY)
        Move(v.btnLbl, gOffscreenX, v.btnY)
    }
    Draw()
}


## Apply thumbnail vs plain-button visibility.
## forceNoThumb=1: hide all spectral thumbs (block-level show_thumbnails=0).
## forceNoThumb=0: honor each vessel's show_thumbnail flag independently.
## All visible options are shown together (no early Biological-only button).
define ApplyVesselThumbDisplay(vessels, forceNoThumb)
{
    loop(v, vessels)
    {
        useThumb <- 0
        if(forceNoThumb == 0 and v.show_thumbnail == 1) { useThumb <- 1 }
        if(useThumb == 1)
        {
            Show(v.thumbImg)
            Show(v.lbl)
            Move(v.btn,    gOffscreenX, v.btnY)
            Move(v.btnLbl, gOffscreenX, v.btnY)
        } else {
            Hide(v.thumbImg)
            Hide(v.lbl)
            Move(v.btn,    v.btnX, v.btnY)
            Move(v.btnLbl, v.btnX, v.btnY)
        }
    }
    Draw()
}


## Hide thumbnails/labels; show plain labeled buttons at the same positions.
define SetupNoThumbDisplay(vessels)
{
    ApplyVesselThumbDisplay(vessels, 1)
}


## Restore per-vessel thumbnail visibility (spectral thumbs where show_thumbnail=1).
define TeardownNoThumbDisplay(vessels)
{
    ApplyVesselThumbDisplay(vessels, 0)
}


## ============================================================
## GO/NO-GO TRIAL
## ============================================================

## Score a gonogo trial.
## isTarget=1: go-vessel shown (correct: respond). isTarget=0: nogo-vessel shown (correct: withhold).
## responded=1: click within window. responded=0: timeout (withheld).
## Returns [correct, points, outcomeLabel]
define ScoreGonogTrial(isTarget, responded, blockCfg)
{
    correct      <- 0
    points       <- 0
    outcomeLabel <- "cr"

    if(isTarget == 1 and responded == 1) { correct <- 1; outcomeLabel <- "hit"  }
    if(isTarget == 1 and responded == 0) { correct <- 0; outcomeLabel <- "miss" }
    if(isTarget == 0 and responded == 1) { correct <- 0; outcomeLabel <- "fa"   }
    if(isTarget == 0 and responded == 0) { correct <- 1; outcomeLabel <- "cr"   }

    fbType <- blockCfg.feedback
    if(fbType == "payoff")
    {
        if(outcomeLabel == "hit")  { points <- blockCfg.payoff_hit  }
        if(outcomeLabel == "miss") { points <- blockCfg.payoff_miss }
        if(outcomeLabel == "fa")   { points <- blockCfg.payoff_fa   }
        if(outcomeLabel == "cr")   { points <- blockCfg.payoff_cr   }
    }

    return([correct, points, outcomeLabel])
}


## Run a single go/no-go trial.
## Two-stimulus go/no-go trial.
## Every trial shows a vessel: the go-vessel (target) or a nogo-vessel (non-target).
## isTarget=1 → go-vessel shown (correct response: click).
## isTarget=0 → first nogo-vessel shown (correct response: withhold).
## base_rate controls how often the go-vessel appears.
## Returns same format as RunTrial: [vesselId, response, rt, correct, points, outcomeLabel, abstime, sig]
define RunGonogTrial(blockCfg, vessels, noiseImgs, dispY, fbY, offscreenX)
{
    goVessel   <- blockCfg.gonogo_go_vessel
    respWindow <- blockCfg.gonogo_response_window
    baseRate   <- blockCfg.base_rate
    mode       <- blockCfg.signal_mode
    params     <- blockCfg.signal_params

    ## Pick target (go) or non-target (nogo) based on base_rate
    isTarget <- 1
    if(Random() > baseRate) { isTarget <- 0 }

    ## Select which vessel to show
    vesselId <- goVessel
    if(isTarget == 0)
    {
        ## Use first vessel that is NOT the go-vessel as the nogo stimulus
        loop(v, vessels)
        {
            if(v.id != goVessel and vesselId == goVessel)
            {
                vesselId <- v.id
            }
        }
    }

    ## Generate signal and render stimulus
    vessel    <- GetVessel(vesselId, vessels)
    sig       <- GenerateSignal(vesselId, mode, params, vessels)
    noiseImg  <- 0
    stripImgs <- []
    if(blockCfg.display == "heading")
    {
        stripImgs <- RenderHeading(sig, gZoom, dispY, vessel.contact_type)
    } else {
        noiseImg <- PickNoiseOverlay()
        Move(noiseImg, Round(gVideoWidth/2), dispY)
        stripImgs <- RenderNarrowband(sig, gZoom, dispY)
    }

    ShowSignalCue(blockCfg)
    Draw()
    PlayVesselStim(vessel)

    absT <- GetTime()
    t0   <- GetTime()
    out  <- WaitForLayoutResponse(gGoLayout, respWindow)
    rt   <- GetTime() - t0
    StopVesselStim(vessel)
    HideSignalCue()
    ClearEventLoop()

    responded <- 0
    if(out != "<timeout>") { responded <- 1 }

    ## Show response box around the go-vessel thumbnail immediately on click
    if(responded == 1)
    {
        goV <- GetVessel(goVessel, vessels)
        Move(gResponseBox, goV.thumb.x, goV.thumb.y)
        Draw()
    }

    ## Hold display for remainder of response window before clearing
    remaining <- respWindow - rt
    if(remaining > 0) { Wait(remaining) }

    resp <- "nogo"
    if(responded == 1) { resp <- "go" }

    scoreData    <- ScoreGonogTrial(isTarget, responded, blockCfg)
    correct      <- First(scoreData)
    points       <- Second(scoreData)
    outcomeLabel <- Third(scoreData)
    CreditScore(points, blockCfg)

    Move(gResponseBox, offscreenX, dispY)
    if(blockCfg.display != "heading")
    {
        Move(noiseImg, offscreenX, dispY)
    }
    ClearDisplay(stripImgs)
    Draw()

    ApplyFeedback(correct, points, blockCfg, fbY)

    Wait(blockCfg.isi)

    return([vesselId, resp, rt, correct, points, outcomeLabel, absT, sig, ""])
}


## ============================================================
## CHOICE TRIAL
## ============================================================

## Drop visual stripes/overlay only (stimulus stays if caller skips this).
define ClearTrialStimulusVisual(noiseImg, stripImgs, offscreenX, dispY)
{
    if(noiseImg != 0)
    {
        Move(noiseImg, offscreenX, dispY)
    }
    ClearDisplay(stripImgs)
    Draw()
}


## Stop vessel audio, hide signal cue, and clear visual stripes/overlay.
## Bed noise (if any) keeps playing. Response collection may continue after this.
define ClearTrialStimulus(vessel, noiseImg, stripImgs, offscreenX, dispY)
{
    StopVesselStim(vessel)
    HideSignalCue()
    ClearTrialStimulusVisual(noiseImg, stripImgs, offscreenX, dispY)
}


## Run a single trial. Returns trial_result list:
##   [vesselId, response, rt, correct, points, outcomeLabel, abstime, sig]
## If blockCfg.stim_ms > 0, visual bands and vessel audio last that long, then
## clear; response may still be collected after offset (resp_ms; 0 = unlimited).
define RunTrial(blockCfg, vessels, noiseImgs, dispY, fbY, offscreenX)
{
    vesselId   <- PickVessel(blockCfg, vessels)
    vessel     <- GetVessel(vesselId, vessels)
    mode       <- blockCfg.signal_mode
    params     <- blockCfg.signal_params
    ## Repetition cases pin the full stimulus; otherwise draw a fresh signal.
    if(blockCfg.has_forced_sig == 1)
    {
        sig <- CopyList(blockCfg.forced_sig)
        if(vessel.n_templates > 0 and vessel.active_template != "")
        {
            gLastActiveTemplate <- vessel.active_template
        }
    } else {
        sig <- GenerateSignal(vesselId, mode, params, vessels)
    }
    stimMs     <- blockCfg.stim_ms
    respMs     <- blockCfg.resp_ms

    ## Render stimulus. Audio-only: waterfall bg with no stripes.
    noiseImg  <- 0
    stripImgs <- []
    if(gCurrentChannel != "audio")
    {
        if(blockCfg.display == "heading")
        {
            stripImgs <- RenderHeading(sig, gZoom, dispY, vessel.contact_type)
        } else {
            if(blockCfg.use_noise_overlay == 1)
            {
                noiseImg <- PickNoiseOverlay()
                Move(noiseImg, Round(gVideoWidth/2), dispY)
            }
            stripImgs <- RenderNarrowband(sig, gZoom, dispY)
        }
    }

    ShowSignalCue(blockCfg)
    Draw()
    PlayVesselStim(vessel)

    absT <- GetTime()
    t0   <- GetTime()
    resp <- 0
    rt   <- 0

    keepStim <- blockCfg.feedback_keep_stim
    if(stimMs <= 0)
    {
        resp <- CollectVesselResponse(vessels, blockCfg.show_thumbnails, 0, blockCfg.response_input)
        rt   <- GetTime() - t0
        if(keepStim == 0)
        {
            ClearTrialStimulus(vessel, noiseImg, stripImgs, offscreenX, dispY)
        } else {
            ## Keep waterfall for feedback inspection; stop looping vessel audio.
            StopVesselStim(vessel)
            HideSignalCue()
        }
    } else {
        resp <- CollectVesselResponse(vessels, blockCfg.show_thumbnails, stimMs, blockCfg.response_input)
        if(resp == "<timeout>")
        {
            if(keepStim == 0)
            {
                ClearTrialStimulus(vessel, noiseImg, stripImgs, offscreenX, dispY)
            } else {
                StopVesselStim(vessel)
                HideSignalCue()
            }
            resp <- CollectVesselResponse(vessels, blockCfg.show_thumbnails, respMs, blockCfg.response_input)
            rt   <- GetTime() - t0
            if(resp == "<timeout>")
            {
                resp <- 0
            }
        } else {
            rt <- GetTime() - t0
            if(keepStim == 0)
            {
                ClearTrialStimulus(vessel, noiseImg, stripImgs, offscreenX, dispY)
            } else {
                StopVesselStim(vessel)
                HideSignalCue()
            }
        }
    }

    ## Score outcome first; confidence payoffs applied after rating is collected.
    scoreData       <- ScoreTrial(vesselId, resp, blockCfg)
    correct         <- First(scoreData)
    points          <- Second(scoreData)
    outcomeLabel    <- Third(scoreData)
    reportedCorrect <- Nth(scoreData, 4)

    ## Confidence rating (before feedback so rating is not contaminated).
    ## CollectConfidence removes its UI and Draw()s before returning.
    confidence <- ""
    if(blockCfg.collect_confidence == 1)
    {
        confidence <- CollectConfidence(fbY, blockCfg.confidence_levels, blockCfg.confidence_input)
    }

    if(blockCfg.scoring == "confidence")
    {
        confLevel <- 1
        if(confidence != "") { confLevel <- confidence }
        points <- ConfidencePayoff(correct, confLevel, blockCfg)
    }
    CreditScore(points, blockCfg)

    ## Recenter click only for 2AFC layout; otherwise keep feedback in the gutter (fbY).
    click <- 0
    if(Length(vessels) == 2 and gLayout2AFCReady == 1)
    {
        click <- LayoutWantsRecenter(gLayout2AFC)
    }
    gFeedbackTargetLabel <- FeedbackTargetLabel(vesselId, vessels)
    ApplyFeedback(reportedCorrect, points, blockCfg, fbY, click)
    gFeedbackTargetLabel <- ""
    ## Clear waterfall after feedback (when kept visible for inspection).
    if(blockCfg.feedback_keep_stim == 1)
    {
        ClearTrialStimulus(vessel, noiseImg, stripImgs, offscreenX, dispY)
    }
    ## ISI after confidence dismiss (+ optional feedback). Next contact appears after this wait.
    Wait(blockCfg.isi)

    return([vesselId, resp, rt, correct, points, outcomeLabel, absT, sig, confidence, "", "", reportedCorrect])
}


## ============================================================
## SIMON TASK
## ============================================================

## Show L/R rule labels above thumbnails; return label list for teardown.
## Reposition vessel thumbnails and labels so that the vessel with response_side=="left"
## is on the left side of the screen and response_side=="right" is on the right.
## Call after applying per-block vessel overrides, before SetupSimonDisplay.
define RepositionSimonThumbs(vessels)
{
    nV    <- Length(vessels)
    tbgW  <- Round(gVideoWidth * 0.125)
    tzoomX <- tbgW / 240.0
    tbgH  <- Round(60 * tzoomX)
    thumbY <- Round(gVideoHeight * 0.82)
    safeY  <- gVideoHeight - Round(tbgH / 2) - 80
    if(thumbY > safeY) { thumbY <- safeY }
    lblY  <- thumbY + Round(tbgH / 2) + 28

    loop(v, vessels)
    {
        ## Compute target x: left vessel at idx=1 position, right at idx=nV position
        if(v.response_side == "left")
        {
            tx <- Round(gVideoWidth * (1.0 / (nV + 1.0)))
        } else {
            tx <- Round(gVideoWidth * (nV / (nV + 1.0)))
        }
        Move(v.thumbImg, tx, thumbY)
        Move(v.lbl,      tx, lblY)
    }
    Draw()
}


define SetupSimonDisplay(vessels, blockCfg)
{
    simonLabels <- []
    labelY <- gVideoHeight - 60
    leftX  <- Round(gVideoWidth * 0.25)
    rightX <- Round(gVideoWidth * 0.75)

    ## Build side→name mapping from vessels
    leftName  <- ""
    rightName <- ""
    loop(v, vessels)
    {
        if(v.response_side == "left")  { leftName  <- v.name }
        if(v.response_side == "right") { rightName <- v.name }
    }

    leftLbl <- MakeLabel("LEFT <- " + leftName, gFontSimonL)
    AddObject(leftLbl, gWin)
    Move(leftLbl, leftX, labelY)
    PushOnEnd(simonLabels, leftLbl)

    rightLbl <- MakeLabel(rightName + " -> RIGHT", gFontSimonR)
    AddObject(rightLbl, gWin)
    Move(rightLbl, rightX, labelY)
    PushOnEnd(simonLabels, rightLbl)

    Draw()
    return(simonLabels)
}


define TeardownSimonDisplay(simonLabels)
{
    loop(lbl, simonLabels) { RemoveObject(lbl, gWin) }
    Draw()
}


## Pick a bearing for this trial.
## vessel.bearings is a list; pick one randomly.
## If no bearings defined, use vessel sig bearing directly.
define PickBearing(vessel)
{
    bearing <- Nth(vessel.sig, 1)
    if(PropertyExists(vessel, "bearings"))
    {
        bl  <- vessel.bearings
        idx <- Round(Random() * (Length(bl) - 1)) + 1
        bearing <- Nth(bl, idx)
    }
    return(bearing)
}


## Returns [correct, points, outcomeLabel]
define ScoreSimonTrial(responseSide, vessel, blockCfg)
{
    correct      <- 0
    points       <- 0
    outcomeLabel <- "wrong"
    if(responseSide == vessel.response_side)
    {
        correct      <- 1
        outcomeLabel <- "correct"
        points       <- blockCfg.payoff_hit
    } else {
        points <- blockCfg.payoff_miss
    }
    return([correct, points, outcomeLabel])
}


## Run a single Simon trial.
## Returns extended result list:
##   [vesselId, responseSide, rt, correct, points, outcomeLabel, absT, sig, bearing, congruent]
define RunSimonTrial(blockCfg, vessels, noiseImgs, dispY, fbY, offscreenX)
{
    vesselId <- PickVessel(blockCfg, vessels)
    vessel   <- GetVessel(vesselId, vessels)
    mode     <- blockCfg.signal_mode
    params   <- blockCfg.signal_params

    ## Pick bearing for this trial (may differ from vessel's canonical bearing)
    bearing   <- PickBearing(vessel)
    halfWidth <- Nth(vessel.sig, 2)
    sig       <- [bearing, halfWidth]

    ## Stimulus side: bearings 0-179 = left half, 180-359 = right half
    stimSide <- "left"
    if(bearing >= 180) { stimSide <- "right" }

    congruent <- 0
    if(stimSide == vessel.response_side) { congruent <- 1 }

    ## Render
    stripImgs <- RenderHeading(sig, gZoom, dispY, vessel.contact_type)
    Draw()
    PlayVesselStim(vessel)

    absT <- GetTime()
    t0   <- GetTime()
    responseSide <- WaitForLayoutResponse(gLayout2AFC, 0)
    rt   <- GetTime() - t0
    StopVesselStim(vessel)
    ClearEventLoop()

    scoreData    <- ScoreSimonTrial(responseSide, vessel, blockCfg)
    correct      <- First(scoreData)
    points       <- Second(scoreData)
    outcomeLabel <- Third(scoreData)

    ApplyFeedback(correct, points, blockCfg, fbY, LayoutWantsRecenter(gLayout2AFC))

    ClearDisplay(stripImgs)
    Draw()
    Wait(blockCfg.isi)

    return([vesselId, responseSide, rt, correct, points, outcomeLabel, absT, sig, "", bearing, congruent, correct])
}


## ============================================================
## CUED TRIAL (heading click → narrowband ID)
## ============================================================

## Determine which vessel side (left/right of centre) a vessel "belongs to"
## based on cue_validity and the vessel's canonical bearing.
## Returns the bearing to display for this vessel on this trial.
## side_map: list [[vesselId, side], ...]  built once per block in RunCuedTrial.

## Pick which vessel to show, and assign it a bearing that respects cue_validity.
## right-side bearing (180-359) → 80% enemy (vessel 2), 20% friendly (vessel 1)
## left-side  bearing (0-179)   → 80% friendly (vessel 1), 20% enemy (vessel 2)
##
## Algorithm:
##   1. Pick vessel id by base_rate as usual.
##   2. With probability cue_validity, put it on its "home" side.
##      Otherwise put it on the other side (incongruent cue).
##   3. Sample a bearing uniformly from [0,179] or [180,359] accordingly.
## Returns [vesselId, bearing, cueCongruent]
## Pick vessel and assign a cued bearing.
## Vessel 1 home side = left (0-179); vessel 2 home side = right (180-359).
## With probability cue_validity the bearing matches the vessel's home side (congruent).
## Returns [vesselId, bearing, cueCongruent]
define PickCuedStimulus(blockCfg, vessels)
{
    validity <- blockCfg.cue_validity
    vesselId <- PickVessel(blockCfg, vessels)

    ## Bearing is fully random — no spatial home-side mapping
    bearing <- Round(Random() * 359)

    ## Congruent: cue glyph matches the actual vessel's contact_type
    ## Incongruent: cue glyph is the OTHER vessel's contact_type
    cueCongruent <- 1
    if(Random() >= validity) { cueCongruent <- 0 }

    ## cueContactType: what glyph to flash in Phase 1
    vessel <- GetVessel(vesselId, vessels)
    cueContactType <- vessel.contact_type
    if(cueCongruent == 0)
    {
        ## Find the other vessel's contact_type
        loop(v, vessels)
        {
            if(v.id != vesselId) { cueContactType <- v.contact_type }
        }
    }

    return([vesselId, bearing, cueCongruent, cueContactType])
}


## Run a Posner-style cued trial.
##   Phase 1: heading contact shown briefly (cue_duration ms) — no response required.
##   Phase 2: heading clears; narrowband waterfall appears; participant clicks vessel button.
## Returns [vesselId, response, cueRt, nbRt, correct, points, outcomeLabel,
##          absT, nbSig, bearing, cueCongruent]
define RunCuedTrial(blockCfg, vessels, noiseImgs, headDispY, nbDispY, fbY, offscreenX)
{
    mode        <- blockCfg.signal_mode
    params      <- blockCfg.signal_params
    cueDuration <- blockCfg.cue_duration
    cueSoa      <- blockCfg.cue_soa

    stimData       <- PickCuedStimulus(blockCfg, vessels)
    vesselId       <- Nth(stimData, 1)
    bearing        <- Nth(stimData, 2)
    cueCongruent   <- Nth(stimData, 3)
    cueContactType <- Nth(stimData, 4)

    headSig  <- [bearing, 8]

    ## --- Pre-cue blank ---
    if(cueSoa > 0) { Wait(cueSoa) }

    ## --- Phase 1: cue glyph (may be incongruent contact_type) ---
    headImgs <- RenderHeading(headSig, gZoom, headDispY, cueContactType)
    Draw()
    absT <- GetTime()
    Wait(cueDuration)

    ## --- Post-cue blank (contact removed, heading strip remains) ---
    ClearDisplay(headImgs)
    Draw()
    if(cueSoa > 0) { Wait(cueSoa) }

    ## --- Phase 2: narrowband stimulus ---
    ## EnsureWaterfall: cued/secretary recipes normally load it at init, but
    ## heading-only configs must not reach Move(gBg) with gBg undefined.
    EnsureWaterfall()
    nbSig    <- GenerateSignal(vesselId, mode, params, vessels)
    noiseImg <- PickNoiseOverlay()
    Move(noiseImg, Round(gVideoWidth/2), nbDispY)
    stripImgs <- RenderNarrowband(nbSig, gZoom, nbDispY)
    Move(gBg, Round(gVideoWidth/2), nbDispY)
    Draw()

    vessel <- GetVessel(vesselId, vessels)
    PlayVesselStim(vessel)

    t0   <- GetTime()
    resp <- CollectVesselResponse(vessels, blockCfg.show_thumbnails, 0, blockCfg.response_input)
    nbRt <- GetTime() - t0
    StopVesselStim(vessel)

    scoreData       <- ScoreTrial(vesselId, resp, blockCfg)
    correct         <- First(scoreData)
    points          <- Second(scoreData)
    outcomeLabel    <- Third(scoreData)
    reportedCorrect <- Nth(scoreData, 4)

    Move(noiseImg, offscreenX, nbDispY)
    ClearDisplay(stripImgs)
    Move(gBg, offscreenX, nbDispY)
    Draw()

    click <- 0
    if(Length(vessels) == 2 and gLayout2AFCReady == 1)
    {
        click <- LayoutWantsRecenter(gLayout2AFC)
    }
    ApplyFeedback(reportedCorrect, points, blockCfg, fbY, click)
    if(blockCfg.feedback != "none")
    {
        Wait(blockCfg.isi)
    }

    return([vesselId, resp, cueDuration, nbRt, correct, points, outcomeLabel,
            absT, nbSig, bearing, cueCongruent])
}


define LogCuedTrial(dataFile, blockCfg, trialNum, trialResult, vessels)
{
    vesselId     <- Nth(trialResult, 1)
    resp         <- Nth(trialResult, 2)
    headingRt    <- Nth(trialResult, 3)
    nbRt         <- Nth(trialResult, 4)
    correct      <- Nth(trialResult, 5)
    points       <- Nth(trialResult, 6)
    outcomeLabel <- Nth(trialResult, 7)
    absT         <- Nth(trialResult, 8)
    nbSig        <- Nth(trialResult, 9)
    bearing      <- Nth(trialResult, 10)
    cueCongruent <- Nth(trialResult, 11)

    vessel     <- GetVessel(vesselId, vessels)
    vesselName <- vessel.name
    baseSig    <- vessel.sig
    nMatches   <- CountMatches(nbSig, baseSig)
    nShown     <- Length(nbSig)
    nExtra     <- nShown - nMatches
    nMissing   <- Length(baseSig) - nMatches

    row <- [gSubNum, blockCfg.task_id, blockCfg.id, blockCfg.response_mode,
            trialNum, vesselId, vesselName, resp, correct, outcomeLabel, points,
            blockCfg.signal_mode, headingRt, nbRt, absT,
            SigToStr(baseSig), SigToStr(nbSig), nShown, nExtra, nMissing,
            bearing, cueCongruent, "", "", ""]
    FilePrint(dataFile, ConcatenateList(row, ","))
}




## ============================================================
## DATA LOGGING
## ============================================================

define LogTrial(dataFile, blockCfg, trialNum, trialResult, vessels)
{
    vesselId     <- Nth(trialResult, 1)
    resp         <- Nth(trialResult, 2)
    rt           <- Nth(trialResult, 3)
    correct      <- Nth(trialResult, 4)
    points       <- Nth(trialResult, 5)
    outcomeLabel <- Nth(trialResult, 6)
    absT         <- Nth(trialResult, 7)
    sig          <- Nth(trialResult, 8)
    confidence   <- Nth(trialResult, 9)

    ## Simon-only extra columns (positions 10-11); blank for other modes
    bearing         <- ""
    congruent       <- ""
    reportedCorrect <- correct
    if(blockCfg.response_mode == "simon")
    {
        bearing   <- Nth(trialResult, 10)
        congruent <- Nth(trialResult, 11)
    }
    if(Length(trialResult) >= 12) { reportedCorrect <- Nth(trialResult, 12) }


    vesselName <- "unknown"
    baseSig    <- []
    nMatches   <- 0
    nShown     <- Length(sig)
    nExtra     <- nShown
    nMissing   <- 0
    if(vesselId > 0)
    {
        vessel     <- GetVessel(vesselId, vessels)
        vesselName <- vessel.name
        baseSig    <- vessel.sig
        ## Prefer the template drawn for this trial when multi-template vessels are used.
        if(vessel.n_templates > 0)
        {
            baseSig <- vessel.active_sig
            if(vessel.active_template != "")
            {
                vesselName <- vessel.name + " [" + vessel.active_template + "]"
            }
        }
        nMatches   <- CountMatches(sig, baseSig)
        nExtra     <- nShown - nMatches
        nMissing   <- Length(baseSig) - nMatches
    }

    ## instance_id: stable id for a stimulus case (same across ShuffleRepeat
    ## duplicates). Defaults to trialNum when the block did not set one.
    instanceId <- trialNum
    if(blockCfg.instance_id > 0) { instanceId <- blockCfg.instance_id }

    ## Running block accuracy for ShowBlockScoreSummary.
    gBlockNTrials <- gBlockNTrials + 1
    if(correct == 1) { gBlockNCorrect <- gBlockNCorrect + 1 }

    ## Session report accumulator: [blockId, label, trueId, respId, correct, points, conf]
    PushOnEnd(gReportTrials, [blockCfg.id, blockCfg.label, vesselId, resp, correct, points, confidence])

    row <- [gSubNum, blockCfg.task_id, blockCfg.id, blockCfg.response_mode,
            trialNum, vesselId, vesselName, resp, correct, outcomeLabel, points,
            blockCfg.signal_mode, rt, "", absT,
            SigToStr(baseSig), SigToStr(sig), instanceId, nShown, nExtra, nMissing,
            bearing, congruent, reportedCorrect, "", "", "", confidence,
            gCurrentChannel, gCurrentJitter, gCurrentAudGain,
            blockCfg.visual_level, blockCfg.audio_level]
    FilePrint(dataFile, ConcatenateList(row, ","))
}


## ============================================================
## REVERSAL
## ============================================================

## Score a trial against the current correct_vessel (which may have been swapped).
## Supports probabilistic feedback: with probability p_flip_feedback, reported
## feedback is flipped (correct shown as incorrect and vice versa), but the
## *recorded* correct value is always the true one.
## Returns [trueCorrect, reportedCorrect, points, outcomeLabel]
define ScoreReversalTrial(vesselId, response, blockCfg)
{
    trueCorrect <- 0
    if(response == blockCfg.correct_vessel) { trueCorrect <- 1 }

    reportedCorrect <- trueCorrect
    if(Random() < blockCfg.p_flip_feedback)
    {
        reportedCorrect <- 1 - trueCorrect
    }

    points       <- blockCfg.payoff_miss
    outcomeLabel <- "miss"
    if(trueCorrect == 1)
    {
        points       <- blockCfg.payoff_hit
        outcomeLabel <- "hit"
    }

    return([trueCorrect, reportedCorrect, points, outcomeLabel])
}


## Find the vessel id that is NOT the current correct_vessel (the foil).
define GetOtherVessel(correctVesselId, vessels)
{
    other <- correctVesselId
    loop(v, vessels)
    {
        if(v.id != correctVesselId and other == correctVesselId)
        {
            other <- v.id
        }
    }
    return(other)
}


## Run a reversal block. Trials continue until nTrials reached OR reversal_max
## reversals occur (whichever comes first if reversal_max > 0).
## blockCfg.correct_vessel is mutated on each reversal.
## Returns total reversal count (for logging).
define RunReversalBlock(blockCfg, vessels, noiseImgs, dispY, fbY, offscreenX, dataFile)
{
    nTrials      <- blockCfg.trials
    criterion    <- blockCfg.reversal_criterion
    maxReversals <- blockCfg.reversal_max
    trueFeedback <- blockCfg.feedback
    trialNum     <- 1
    nConsec      <- 0
    nReversals   <- 0
    done         <- 0

    ## Suppress RunTrial's built-in feedback; reversal block applies its own
    blockCfg.feedback <- "none"

    while(trialNum <= nTrials and done == 0)
    {
        trialResult  <- RunTrial(blockCfg, vessels, noiseImgs, dispY, fbY, offscreenX)

        vesselId     <- Nth(trialResult, 1)
        response     <- Nth(trialResult, 2)
        rt           <- Nth(trialResult, 3)
        absT         <- Nth(trialResult, 7)
        sig          <- Nth(trialResult, 8)

        scoreData      <- ScoreReversalTrial(vesselId, response, blockCfg)
        trueCorrect    <- Nth(scoreData, 1)
        reportCorrect  <- Nth(scoreData, 2)
        points         <- Nth(scoreData, 3)
        outcomeLabel   <- Nth(scoreData, 4)

        ## Apply feedback using reported correctness and the original feedback mode
        blockCfg.feedback <- trueFeedback
        ApplyFeedback(reportCorrect, points, blockCfg, fbY)
        Wait(blockCfg.isi)
        blockCfg.feedback <- "none"

        ## Track consecutive correct (using TRUE outcome, not reported)
        if(trueCorrect == 1)
        {
            nConsec <- nConsec + 1
        } else {
            nConsec <- 0
        }

        ## Reversal: swap correct vessel when criterion reached
        if(nConsec >= criterion)
        {
            nConsec <- 0
            nReversals <- nReversals + 1
            blockCfg.correct_vessel <- GetOtherVessel(blockCfg.correct_vessel, vessels)
            if(maxReversals > 0 and nReversals >= maxReversals)
            {
                done <- 1
            }
        }

        ## Log with reversal columns: reuse bearing/congruent slots for nConsec/nReversals
        LogReversalTrial(dataFile, blockCfg, trialNum, vesselId, response, rt,
                         trueCorrect, reportCorrect, points, outcomeLabel, absT, sig,
                         nConsec, nReversals, vessels)

        trialNum <- trialNum + 1
    }

    blockCfg.feedback <- trueFeedback
    return(nReversals)
}


define LogReversalTrial(dataFile, blockCfg, trialNum, vesselId, response, rt,
                        trueCorrect, reportCorrect, points, outcomeLabel, absT, sig,
                        nConsec, nReversals, vessels)
{
    vessel     <- GetVessel(vesselId, vessels)
    vesselName <- vessel.name
    baseSig    <- vessel.sig
    nMatches   <- CountMatches(sig, baseSig)
    nShown     <- Length(sig)
    nExtra     <- nShown - nMatches
    nMissing   <- Length(baseSig) - nMatches

    row <- [gSubNum, blockCfg.task_id, blockCfg.id, blockCfg.response_mode,
            trialNum, vesselId, vesselName, response, trueCorrect, outcomeLabel, points,
            blockCfg.signal_mode, rt, "", absT,
            SigToStr(baseSig), SigToStr(sig), nShown, nExtra, nMissing, "", "",
            reportCorrect, nConsec, nReversals, blockCfg.correct_vessel]
    FilePrint(dataFile, ConcatenateList(row, ","))
}


## ============================================================
## BANDIT TASK
## ============================================================

## Sample a payoff for a zone using its mean and sd (normal distribution).
## Rounds to integer; no floor/ceiling — can go negative.
define SampleZonePayoff(vessel)
{
    mean <- vessel.payoff_mean
    sd   <- vessel.payoff_sd
    pts  <- Round(mean + RandomNormal(0, sd))
    if(vessel.loss_prob > 0)
    {
        if(Random() < vessel.loss_prob)
        {
            pts <- pts - vessel.loss_amount
        }
    }
    return(pts)
}


## Render all zone contacts on the heading strip simultaneously.
## Returns list of [contactImgList, clickZone, vesselId] per zone for hit-testing.
define RenderBanditContacts(vessels, dispY)
{
    zoneObjs  <- []
    zoneIds   <- []

    loop(v, vessels)
    {
        bearing   <- Nth(v.sig, 1)
        halfWidth <- Nth(v.sig, 2)
        sig       <- [bearing, halfWidth]

        contactType <- v.contact_type
        imgs <- RenderHeading(sig, gZoom, dispY, contactType)

        ## Click zone over this contact
        bgNativeW      <- 2000
        bgScreenLeft   <- Round(gVideoWidth / 2 - bgNativeW * gZoom / 2.0)
        bearingX       <- Round(bearing / 360.0 * bgNativeW)
        contactScreenX <- bgScreenLeft + Round(bearingX * gZoom)
        headingBgH     <- Round(200 * gZoom)
        czW <- Round(60 * gZoom)
        if(czW < 40) { czW <- 40 }
        czCol <- MakeColorRGB(0, 60, 0)
        cz    <- Rectangle(contactScreenX, dispY, czW, headingBgH, czCol, 1)
        AddObject(cz, gWin)
        Hide(cz)

        PushOnEnd(zoneObjs, cz)
        PushOnEnd(zoneIds,  v.id)

        ## Store imgs on vessel for later removal
        v.banditImgs <- imgs
    }

    return([zoneObjs, zoneIds])
}


## Remove all contact images from all zones.
define ClearBanditContacts(vessels)
{
    loop(v, vessels)
    {
        if(PropertyExists(v, "banditImgs"))
        {
            ClearDisplay(v.banditImgs)
        }
    }
}


## Run a single bandit trial.
## All zone contacts shown on heading strip; participant clicks one.
## Payoff sampled from that zone's distribution; shown as immediate feedback.
## Returns [chosenId, points, rt, absT]
define RunBanditTrial(blockCfg, vessels, dispY, fbY)
{
    ## Render all contacts
    zoneData <- RenderBanditContacts(vessels, dispY)
    zoneObjs <- First(zoneData)
    zoneIds  <- Second(zoneData)
    Draw()

    absT <- GetTime()
    t0   <- GetTime()
    chosenId <- WaitForClickOnTarget(zoneObjs, zoneIds)
    rt   <- GetTime() - t0

    ## Remove click zones
    loop(cz, zoneObjs) { RemoveObject(cz, gWin) }

    ## Sample payoff from chosen zone
    chosenVessel <- GetVessel(chosenId, vessels)
    points       <- SampleZonePayoff(chosenVessel)

    ## Show payoff immediately on heading strip (contacts still visible)
    UpdateScoreHUD(points)
    if(points >= 0)
    {
        ptStr <- "+" + points
    } else {
        ptStr <- "" + points
    }
    msg <- MakeLabel(ptStr, gFontFB)
    AddObject(msg, gWin)
    Move(msg, Round(gVideoWidth/2), fbY)
    Draw()
    Wait(600)
    RemoveObject(msg, gWin)

    ## Clear contacts, ISI
    ClearBanditContacts(vessels)
    Draw()
    Wait(blockCfg.isi)

    return([chosenId, points, rt, absT])
}


define LogBanditTrial(dataFile, blockCfg, trialNum, trialResult, vessels)
{
    chosenId <- Nth(trialResult, 1)
    points   <- Nth(trialResult, 2)
    rt       <- Nth(trialResult, 3)
    absT     <- Nth(trialResult, 4)

    vessel     <- GetVessel(chosenId, vessels)
    vesselName <- vessel.name

    row <- [gSubNum, blockCfg.task_id, blockCfg.id, blockCfg.response_mode,
            trialNum, chosenId, vesselName, chosenId, "", "", points,
            blockCfg.signal_mode, rt, "", absT,
            "", "", "", "", "", "", "", "", "", "", ""]
    FilePrint(dataFile, ConcatenateList(row, ","))
}


## ============================================================
## SECRETARY / OPTIMAL STOPPING TASK
## ============================================================


## Build NORTH, WAIT, SOUTH buttons for the urns/inference task.
## Returns [eastBtn, eastLbl, waitBtn, waitLbl, westBtn, westLbl]
define MakeUrnsButtons()
{
    eastCol <- MakeColorRGB(0, 80, 160)
    waitCol <- MakeColorRGB(60, 60, 60)
    westCol <- MakeColorRGB(160, 60, 0)
    PushOnEnd(gKeep, eastCol)
    PushOnEnd(gKeep, waitCol)
    PushOnEnd(gKeep, westCol)

    eastBtn <- Rectangle(gOffscreenX, 0, 200, 50, eastCol, 1)
    eastLbl <- MakeLabel("EAST", gBtnFont)
    AddObject(eastBtn, gWin)
    AddObject(eastLbl, gWin)
    Move(eastLbl, gOffscreenX, 0)

    waitBtn <- Rectangle(gOffscreenX, 0, 200, 50, waitCol, 1)
    waitLbl <- MakeLabel("WAIT", gBtnFont)
    AddObject(waitBtn, gWin)
    AddObject(waitLbl, gWin)
    Move(waitLbl, gOffscreenX, 0)

    westBtn <- Rectangle(gOffscreenX, 0, 200, 50, westCol, 1)
    westLbl <- MakeLabel("WEST", gBtnFont)
    AddObject(westBtn, gWin)
    AddObject(westLbl, gWin)
    Move(westLbl, gOffscreenX, 0)

    return([eastBtn, eastLbl, waitBtn, waitLbl, westBtn, westLbl])
}


define EnsureUrnsButtons()
{
    if(Length(gUrnsBtns) == 0)
    {
        gUrnsBtns <- MakeUrnsButtons()
    }
}


## Run one urns/directional-inference trial.
## Contacts appear one at a time as tick marks on the heading strip.
## Participant clicks WAIT to draw another contact, or NORTH/SOUTH to decide.
## Returns [trueUrn, response, correct, nDraws, rt_ms, absT, points, drawSeq]
## Also writes one event row per draw and one summary row.
define RunUrnsRound(blockCfg, btnObjs, dataFile, trialNum)
{
    eastBtn <- Nth(btnObjs, 1)
    eastLbl <- Nth(btnObjs, 2)
    waitBtn  <- Nth(btnObjs, 3)
    waitLbl  <- Nth(btnObjs, 4)
    westBtn <- Nth(btnObjs, 5)
    westLbl <- Nth(btnObjs, 6)

    btnY     <- Round(gVideoHeight * 0.88)
    eastX   <- Round(gVideoWidth * 0.25)
    waitX    <- Round(gVideoWidth * 0.50)
    westX   <- Round(gVideoWidth * 0.75)

    ## Position buttons
    Move(eastBtn, eastX, btnY); Move(eastLbl, eastX, btnY)
    Move(waitBtn,  waitX,  btnY); Move(waitLbl,  waitX,  btnY)
    Move(westBtn, westX, btnY); Move(westLbl, westX, btnY)

    ## Heading strip background already visible (moved by RunBlock)
    bgNativeW    <- 2000
    bgScreenLeft <- Round(gVideoWidth / 2 - bgNativeW * gZoom / 2.0)
    headingBgH   <- Round(200 * gZoom)

    ## Determine true urn: 1=north-majority, 2=south-majority
    ## vessel 1 = North center bearing, vessel 2 = South center bearing
    if(Random() < 0.5)
    {
        trueUrn <- 1
    } else {
        trueUrn <- 2
    }

    ## Draw probabilities: majority side rate vs 1-rate
    eastRate <- blockCfg.urn_east_rate
    westRate <- 1.0 - eastRate

    ## East bearing cluster center ~90 deg (right side), West ~270 deg (left side)
    eastCenter <- 90
    westCenter <- 270

    bearingSd <- blockCfg.urn_bearing_sd

    tickMarks    <- []
    curGlyphImgs <- []
    curBearing   <- -1
    drawSeq      <- ""
    nDraws       <- 0
    drawLimit    <- blockCfg.urn_draw_limit
    drawCost     <- blockCfg.urn_draw_cost

    response  <- ""
    decided   <- 0
    startT    <- GetTime()

    Draw()

    while(decided == 0)
    {
        ## At draw limit, hide WAIT so only East/West remain
        if(nDraws >= drawLimit)
        {
            Move(waitBtn, gOffscreenX, btnY)
            Move(waitLbl, gOffscreenX, btnY)
            Draw()
        }

        clickTargets <- [eastBtn, waitBtn, westBtn]
        clickVals    <- [1, 2, 3]
        clicked <- WaitForClickOnTarget(clickTargets, clickVals)

        if(clicked == 2 and nDraws < drawLimit)
        {
            ## Retire current glyph to a thin line
            if(curBearing >= 0)
            {
                loop(gi, curGlyphImgs) { RemoveObject(gi, gWin) }
                curGlyphImgs <- []
                tickBearingX <- Round(curBearing / 360.0 * bgNativeW)
                tickScreenX  <- bgScreenLeft + Round(tickBearingX * gZoom)
                tickTopY     <- gHeadDispY - Round(headingBgH / 2)
                tickCol      <- MakeColorRGB(60, 200, 60)
                tick <- Line(tickScreenX, tickTopY, 0, headingBgH, tickCol)
                AddObject(tick, gWin)
                PushOnEnd(tickMarks, tick)
            }

            ## Draw one contact from urn
            nDraws <- nDraws + 1

            ## Sample side from urn
            drawnSide <- 0
            if(trueUrn == 1)
            {
                if(Random() < eastRate)
                {
                    drawnSide <- 1
                } else {
                    drawnSide <- 2
                }
            } else {
                if(Random() < eastRate)
                {
                    drawnSide <- 2
                } else {
                    drawnSide <- 1
                }
            }

            ## Sample jittered bearing
            if(drawnSide == 1)
            {
                rawBearing <- eastCenter + Round(RandomNormal(0, bearingSd))
            } else {
                rawBearing <- westCenter + Round(RandomNormal(0, bearingSd))
            }
            ## Wrap bearing to 0-359
            while(rawBearing < 0)   { rawBearing <- rawBearing + 360 }
            while(rawBearing >= 360) { rawBearing <- rawBearing - 360 }

            ## Render current contact as a full noisy heading glyph
            curBearing   <- rawBearing
            headSig      <- [rawBearing, 5]
            curGlyphImgs <- RenderHeading(headSig, gZoom, gHeadDispY, "noisy")

            ## Accumulate draw cost
            if(drawCost != 0)
            {
                UpdateScoreHUD(drawCost)
            }

            ## Build draw sequence string: E or W
            if(drawnSide == 1)
            {
                drawSeq <- drawSeq + "E"
            } else {
                drawSeq <- drawSeq + "W"
            }

            ## Log draw event
            drawT <- GetTime() - startT
            erow  <- [gSubNum, blockCfg.task_id, blockCfg.id, "urns",
                      trialNum, "draw", nDraws, drawnSide, rawBearing, drawT, GetTime()]
            FilePrint(dataFile, ConcatenateList(erow, ","))

            Draw()

        } else {
            if(clicked == 1)
            {
                response <- "east"
                decided  <- 1
            }
            if(clicked == 3)
            {
                response <- "west"
                decided  <- 1
            }
        }
    }

    totalRt <- GetTime() - startT
    absT    <- GetTime()

    ## Score
    correct <- 0
    points  <- 0
    if(response == "east" and trueUrn == 1) { correct <- 1 }
    if(response == "west" and trueUrn == 2) { correct <- 1 }
    if(correct == 1)
    {
        points <- blockCfg.urn_correct_pts
    } else {
        points <- blockCfg.urn_wrong_pts
    }
    UpdateScoreHUD(points)

    ## Log decision event
    drow <- [gSubNum, blockCfg.task_id, blockCfg.id, "urns",
             trialNum, "decide", nDraws, response, trueUrn, correct, points, totalRt, GetTime()]
    FilePrint(dataFile, ConcatenateList(drow, ","))

    ## Feedback
    if(blockCfg.feedback == "accuracy" or blockCfg.feedback == "payoff")
    {
        if(correct == 1)
        {
            fbStr  <- "Correct! +" + points + " pts"
            fbFont <- MakeFont(gPEBLBaseFont, 1, 28, MakeColorRGB(60, 220, 60), MakeColor("black"), 0)
        } else {
            fbStr  <- "Wrong! " + points + " pts"
            fbFont <- MakeFont(gPEBLBaseFont, 1, 28, MakeColorRGB(220, 60, 60), MakeColor("black"), 0)
        }
        fbLbl <- MakeLabel(fbStr, fbFont)
        AddObject(fbLbl, gWin)
        Move(fbLbl, Round(gVideoWidth/2), Round(gVideoHeight * 0.78))
        Draw()
        Wait(blockCfg.isi)
        RemoveObject(fbLbl, gWin)
    } else {
        Wait(blockCfg.isi)
    }

    ## Clean up current glyph and all tick marks
    loop(gi, curGlyphImgs) { RemoveObject(gi, gWin) }
    loop(t, tickMarks) { RemoveObject(t, gWin) }

    ## Park buttons offscreen
    Move(eastBtn, gOffscreenX, btnY); Move(eastLbl, gOffscreenX, btnY)
    Move(waitBtn,  gOffscreenX, btnY); Move(waitLbl,  gOffscreenX, btnY)
    Move(westBtn, gOffscreenX, btnY); Move(westLbl, gOffscreenX, btnY)

    Draw()

    return([trueUrn, response, correct, nDraws, totalRt, absT, points, drawSeq])
}


## Log summary row for one urns trial.
define LogUrnsTrial(dataFile, blockCfg, trialNum, result)
{
    trueUrn  <- Nth(result, 1)
    response <- Nth(result, 2)
    correct  <- Nth(result, 3)
    nDraws   <- Nth(result, 4)
    rt       <- Nth(result, 5)
    absT     <- Nth(result, 6)
    points   <- Nth(result, 7)
    drawSeq  <- Nth(result, 8)

    row <- [gSubNum, blockCfg.task_id, blockCfg.id, "urns",
            trialNum, trueUrn, response, correct, nDraws, rt, absT, points, drawSeq]
    FilePrint(dataFile, ConcatenateList(row, ","))
}


## Run one horizon game using the heading strip display.
## Each game: East and West regions have different hidden payoff means (randomly assigned).
## Forced phase: automation gathers contacts per pre-assigned sequence; payoff drawn and scored.
## Free phase: participant chooses East or West; payoff drawn from chosen region and scored.
## Forced and free draws are mechanically identical — agency is the only difference.
## Returns list of free-trial results; writes one data row per draw (forced and free).
define RunHorizonGame(blockCfg, btnObjs, dataFile, hgameNum)
{
    eastBtn <- Nth(btnObjs, 1)
    eastLbl <- Nth(btnObjs, 2)
    waitBtn <- Nth(btnObjs, 3)
    waitLbl <- Nth(btnObjs, 4)
    westBtn <- Nth(btnObjs, 5)
    westLbl <- Nth(btnObjs, 6)

    btnY  <- Round(gVideoHeight * 0.88)
    eastX <- Round(gVideoWidth * 0.25)
    waitX <- Round(gVideoWidth * 0.50)
    westX <- Round(gVideoWidth * 0.75)

    bgNativeW    <- 2000
    bgScreenLeft <- Round(gVideoWidth / 2 - bgNativeW * gZoom / 2.0)
    headingBgH   <- Round(200 * gZoom)
    bearingSd    <- blockCfg.urn_bearing_sd
    fbY          <- gHeadDispY - Round(headingBgH / 2) - 20
    eastCenter   <- 90
    westCenter   <- 270

    freeTri  <- blockCfg.horizon_free_trials
    infoType <- blockCfg.horizon_info

    ## Per-game payoff means: randomly assign high/low to East/West
    hiMean <- blockCfg.horizon_hi_mean
    loMean <- blockCfg.horizon_lo_mean
    paySd  <- blockCfg.horizon_pay_sd
    highSide <- 1
    if(Random() < 0.5) { highSide <- 2 }
    if(highSide == 1)
    {
        eastMean <- hiMean
        westMean <- loMean
    } else {
        eastMean <- loMean
        westMean <- hiMean
    }

    ## Build forced sequence: [2,2] equal or [1,3]/[3,1] unequal, shuffled
    nF1 <- 2
    nF2 <- 2
    if(infoType == "unequal")
    {
        if(Random() < 0.5) { nF1 <- 1; nF2 <- 3 }
        else               { nF1 <- 3; nF2 <- 1 }
    }
    nForced   <- nF1 + nF2
    forcedSeq <- []
    fi <- 1
    while(fi <= nF1) { PushOnEnd(forcedSeq, 1); fi <- fi + 1 }
    fi <- 1
    while(fi <= nF2) { PushOnEnd(forcedSeq, 2); fi <- fi + 1 }
    forcedSeq <- Shuffle(forcedSeq)

    tickMarks    <- []
    tickLabels   <- []
    curGlyphImgs <- []
    curBearing   <- -1
    curPts       <- 0

    tickTopY  <- gHeadDispY - Round(headingBgH / 2)
    tickCol   <- MakeColorRGB(60, 200, 60)
    tickFont  <- MakeFont(gPEBLBaseFont, 0, 16, MakeColor("white"), MakeColor("black"), 0)

    ## --- FORCED PHASE: GATHER only ---
    Move(eastBtn, gOffscreenX, btnY); Move(eastLbl, gOffscreenX, btnY)
    Move(westBtn, gOffscreenX, btnY); Move(westLbl, gOffscreenX, btnY)
    Move(waitBtn, waitX, btnY);       Move(waitLbl, waitX, btnY)
    Draw()

    fi <- 1
    while(fi <= nForced)
    {
        WaitForClickOnTarget([waitBtn], [1])

        ## Retire current glyph to tick + payoff label
        if(curBearing >= 0)
        {
            loop(gi, curGlyphImgs) { RemoveObject(gi, gWin) }
            curGlyphImgs <- []
            tickBearingX <- Round(curBearing / 360.0 * bgNativeW)
            tickScreenX  <- bgScreenLeft + Round(tickBearingX * gZoom)
            tick <- Line(tickScreenX, tickTopY, 0, headingBgH, tickCol)
            AddObject(tick, gWin)
            PushOnEnd(tickMarks, tick)
            ptsStr <- "+" + curPts
            if(curPts < 0) { ptsStr <- "" + curPts }
            ptLbl <- MakeLabel(ptsStr, tickFont)
            AddObject(ptLbl, gWin)
            Move(ptLbl, tickScreenX, tickTopY - 12)
            PushOnEnd(tickLabels, ptLbl)
        }

        drawSide <- Nth(forcedSeq, fi)
        if(drawSide == 1)
        {
            rawBearing <- eastCenter + Round(RandomNormal(0, bearingSd))
            pts        <- Round(RandomNormal(eastMean, paySd))
        } else {
            rawBearing <- westCenter + Round(RandomNormal(0, bearingSd))
            pts        <- Round(RandomNormal(westMean, paySd))
        }
        while(rawBearing < 0)    { rawBearing <- rawBearing + 360 }
        while(rawBearing >= 360) { rawBearing <- rawBearing - 360 }

        curBearing   <- rawBearing
        curPts       <- pts
        headSig      <- [rawBearing, 5]
        curGlyphImgs <- RenderHeading(headSig, gZoom, gHeadDispY, "noisy")
        UpdateScoreHUD(pts)

        fbFont <- MakeFont(gPEBLBaseFont, 1, 28, MakeColorRGB(200, 200, 60), MakeColor("black"), 0)
        fbStr  <- "+" + pts + " pts"
        if(pts < 0) { fbStr <- pts + " pts" }
        fbLbl <- MakeLabel(fbStr, fbFont)
        AddObject(fbLbl, gWin)
        Move(fbLbl, Round(gVideoWidth/2), fbY)
        Draw()
        Wait(blockCfg.horizon_forced_isi)
        RemoveObject(fbLbl, gWin)

        sideStr <- "east"
        if(drawSide == 2) { sideStr <- "west" }
        erow <- [gSubNum, blockCfg.task_id, blockCfg.id, "horizon",
                 hgameNum, "forced", fi, infoType, freeTri, nF1, nF2,
                 highSide, sideStr, sideStr, pts, "", GetTime()]
        FilePrint(dataFile, ConcatenateList(erow, ","))

        fi <- fi + 1
    }

    ## Retire last forced glyph to tick + label
    if(curBearing >= 0)
    {
        loop(gi, curGlyphImgs) { RemoveObject(gi, gWin) }
        curGlyphImgs <- []
        tickBearingX <- Round(curBearing / 360.0 * bgNativeW)
        tickScreenX  <- bgScreenLeft + Round(tickBearingX * gZoom)
        tick <- Line(tickScreenX, tickTopY, 0, headingBgH, tickCol)
        AddObject(tick, gWin)
        PushOnEnd(tickMarks, tick)
        ptsStr <- "+" + curPts
        if(curPts < 0) { ptsStr <- "" + curPts }
        ptLbl <- MakeLabel(ptsStr, tickFont)
        AddObject(ptLbl, gWin)
        Move(ptLbl, tickScreenX, tickTopY - 12)
        PushOnEnd(tickLabels, ptLbl)
        curBearing <- -1
        Draw()
    }

    ## --- FREE PHASE: EAST/WEST, no GATHER ---
    Move(waitBtn, gOffscreenX, btnY); Move(waitLbl, gOffscreenX, btnY)
    Move(eastBtn, eastX, btnY);       Move(eastLbl, eastX, btnY)
    Move(westBtn, westX, btnY);       Move(westLbl, westX, btnY)
    Draw()

    freeResults <- []
    ti <- 1
    while(ti <= freeTri)
    {
        startT <- GetTime()
        chosenSide <- WaitForClickOnTarget([eastBtn, westBtn], [1, 2])
        rt   <- GetTime() - startT
        absT <- GetTime()

        if(chosenSide == 1)
        {
            rawBearing <- eastCenter + Round(RandomNormal(0, bearingSd))
            pts        <- Round(RandomNormal(eastMean, paySd))
        } else {
            rawBearing <- westCenter + Round(RandomNormal(0, bearingSd))
            pts        <- Round(RandomNormal(westMean, paySd))
        }
        while(rawBearing < 0)    { rawBearing <- rawBearing + 360 }
        while(rawBearing >= 360) { rawBearing <- rawBearing - 360 }

        curBearing   <- rawBearing
        curPts       <- pts
        headSig      <- [rawBearing, 5]
        curGlyphImgs <- RenderHeading(headSig, gZoom, gHeadDispY, "noisy")
        UpdateScoreHUD(pts)

        correct <- 0
        if(chosenSide == highSide) { correct <- 1 }

        fbFont <- MakeFont(gPEBLBaseFont, 1, 28, MakeColorRGB(200, 200, 60), MakeColor("black"), 0)
        fbStr  <- "+" + pts + " pts"
        if(pts < 0) { fbStr <- pts + " pts" }
        fbLbl <- MakeLabel(fbStr, fbFont)
        AddObject(fbLbl, gWin)
        Move(fbLbl, Round(gVideoWidth/2), fbY)
        Draw()
        Wait(blockCfg.isi)
        RemoveObject(fbLbl, gWin)

        ## Retire glyph to tick + payoff label
        loop(gi, curGlyphImgs) { RemoveObject(gi, gWin) }
        curGlyphImgs <- []
        tickBearingX <- Round(rawBearing / 360.0 * bgNativeW)
        tickScreenX  <- bgScreenLeft + Round(tickBearingX * gZoom)
        tick <- Line(tickScreenX, tickTopY, 0, headingBgH, tickCol)
        AddObject(tick, gWin)
        PushOnEnd(tickMarks, tick)
        ptsStr <- "+" + pts
        if(pts < 0) { ptsStr <- "" + pts }
        ptLbl <- MakeLabel(ptsStr, tickFont)
        AddObject(ptLbl, gWin)
        Move(ptLbl, tickScreenX, tickTopY - 12)
        PushOnEnd(tickLabels, ptLbl)
        curBearing <- -1
        Draw()

        chosenStr <- "east"
        if(chosenSide == 2) { chosenStr <- "west" }
        highStr <- "east"
        if(highSide == 2) { highStr <- "west" }
        erow <- [gSubNum, blockCfg.task_id, blockCfg.id, "horizon",
                 hgameNum, "free", ti, infoType, freeTri, nF1, nF2,
                 highStr, chosenStr, chosenStr, pts, rt, absT]
        FilePrint(dataFile, ConcatenateList(erow, ","))

        PushOnEnd(freeResults, [chosenSide, highSide, correct, pts, rt])
        ti <- ti + 1
    }

    ## Teardown
    Move(eastBtn, gOffscreenX, btnY); Move(eastLbl, gOffscreenX, btnY)
    Move(westBtn, gOffscreenX, btnY); Move(westLbl, gOffscreenX, btnY)
    loop(gi, curGlyphImgs) { RemoveObject(gi, gWin) }
    loop(t,  tickMarks)    { RemoveObject(t,  gWin) }
    loop(pl, tickLabels)   { RemoveObject(pl, gWin) }
    Draw()

    return(freeResults)
}


## Build EAST, WAIT, WEST buttons for horizon task.
## Returns [eastBtn, eastLbl, waitBtn, waitLbl, westBtn, westLbl]
define MakeHorizonButtons()
{
    eastCol <- MakeColorRGB(0, 80, 160)
    waitCol <- MakeColorRGB(60, 60, 60)
    westCol <- MakeColorRGB(160, 60, 0)
    PushOnEnd(gKeep, eastCol)
    PushOnEnd(gKeep, waitCol)
    PushOnEnd(gKeep, westCol)

    eastBtn <- Rectangle(gOffscreenX, 0, 200, 50, eastCol, 1)
    eastLbl <- MakeLabel("EAST", gBtnFont)
    AddObject(eastBtn, gWin); AddObject(eastLbl, gWin)
    Move(eastLbl, gOffscreenX, 0)

    waitBtn <- Rectangle(gOffscreenX, 0, 200, 50, waitCol, 1)
    waitLbl <- MakeLabel("GATHER", gBtnFont)
    AddObject(waitBtn, gWin); AddObject(waitLbl, gWin)
    Move(waitLbl, gOffscreenX, 0)

    westBtn <- Rectangle(gOffscreenX, 0, 200, 50, westCol, 1)
    westLbl <- MakeLabel("WEST", gBtnFont)
    AddObject(westBtn, gWin); AddObject(westLbl, gWin)
    Move(westLbl, gOffscreenX, 0)

    return([eastBtn, eastLbl, waitBtn, waitLbl, westBtn, westLbl])
}


define EnsureHorizonButtons()
{
    if(Length(gHorizonBtns) == 0)
    {
        gHorizonBtns <- MakeHorizonButtons()
    }
}


## Build SELECT and PASS buttons, park them offscreen initially.
## Returns [selectBtn, passBtn] — caller moves them onscreen.
define MakeSecretaryButtons()
{
    selCol   <- MakeColorRGB(0, 100, 0)
    deferCol <- MakeColorRGB(60, 60, 0)
    PushOnEnd(gKeep, selCol)
    PushOnEnd(gKeep, deferCol)

    selBtn <- Rectangle(gOffscreenX, 0, 200, 50, selCol, 1)
    selLbl <- MakeLabel("SELECT", gBtnFont)
    AddObject(selBtn, gWin)
    AddObject(selLbl, gWin)
    Move(selLbl, gOffscreenX, 0)

    deferBtn <- Rectangle(gOffscreenX, 0, 200, 50, deferCol, 1)
    deferLbl <- MakeLabel("Choose None", gBtnFont)
    AddObject(deferBtn, gWin)
    AddObject(deferLbl, gWin)
    Move(deferLbl, gOffscreenX, 0)

    return([selBtn, selLbl, deferBtn, deferLbl])
}


define EnsureSecretaryButtons()
{
    if(Length(gSecretaryBtns) == 0)
    {
        gSecretaryBtns <- MakeSecretaryButtons()
    }
}


## Run one secretary/optimal-stopping trial.
## All N contacts shown simultaneously on the bearing strip as click zones.
## Participant clicks any contact to investigate it (narrowband revealed).
## Can freely switch between contacts by clicking another.
## Terminal choices:
##   SELECT (shown when a contact is under investigation) — commit to it, earn quality
##   CHOOSE NONE  (shown always if allow_defer==1) — choose none, earn defer_cost (usually 0 or negative)
## Returns [selectedId, selectedQuality, nInvestigated, nContacts, totalRt, absT, deferred, hasTarget, points]
## Also writes one log row per investigate click and one for the terminal SELECT/DEFER.
define RunSecretaryRound(blockCfg, contacts, noiseImgs, dispY, fbY, offscreenX, btnObjs, vessels, dataFile, trialNum)
{
    selBtn   <- Nth(btnObjs, 1)
    selLbl   <- Nth(btnObjs, 2)
    deferBtn <- Nth(btnObjs, 3)
    deferLbl <- Nth(btnObjs, 4)

    nContacts    <- Length(contacts)
    btnY         <- fbY + 60
    selBtnX      <- Round(gVideoWidth / 2) - 130
    deferBtnX    <- Round(gVideoWidth / 2) + 130
    allowDefer   <- blockCfg.allow_defer
    deferCost    <- blockCfg.defer_cost

    selectedId      <- 0
    selectedQuality <- 0
    nInvestigated   <- 0
    absT            <- GetTime()
    totalRt         <- 0
    deferred        <- 0
    investigateT    <- 0    ## time when current investigation started
    prevContactId   <- 0    ## vessel id of previously investigated contact
    prevContactNum  <- 0    ## contact index of previously investigated contact

    ## Reference thumbnail: show existing Alpha thumbImg below SELECT button.
    targetV    <- Nth(vessels, 1)
    tbgW       <- Round(gVideoWidth * 0.125)
    tzoomX     <- tbgW / 240.0
    tbgH       <- Round(120 * tzoomX)
    refThumbY  <- btnY + Round(tbgH / 2) + 30
    refLblY    <- refThumbY + Round(tbgH / 2) + 20
    Move(targetV.thumbImg, selBtnX, refThumbY)
    Move(targetV.lbl,      selBtnX, refLblY)
    Show(targetV.thumbImg)
    Show(targetV.lbl)

    ## Render all contacts on heading strip; build invisible click zones
    czObjs <- []
    czImgs <- []
    idx <- 1
    loop(c, contacts)
    {
        headSig <- [c.bearing, 8]
        imgs    <- RenderHeading(headSig, gZoom, gHeadDispY, c.contact_type)

        bgNativeW      <- 2000
        bgScreenLeft   <- Round(gVideoWidth / 2 - bgNativeW * gZoom / 2.0)
        bearingX       <- Round(c.bearing / 360.0 * bgNativeW)
        contactScreenX <- bgScreenLeft + Round(bearingX * gZoom)
        headingBgH     <- Round(200 * gZoom)
        czW <- Round(60 * gZoom)
        if(czW < 40) { czW <- 40 }
        czCol <- MakeColorRGB(0, 60, 0)
        cz    <- Rectangle(contactScreenX, gHeadDispY, czW, headingBgH, czCol, 1)
        AddObject(cz, gWin)
        Hide(cz)

        PushOnEnd(czObjs, cz)
        PushOnEnd(czImgs, imgs)
        idx <- idx + 1
    }

    ## DEFER button shown immediately if allowed
    if(allowDefer == 1)
    {
        Move(deferBtn, deferBtnX, btnY)
        Move(deferLbl, deferBtnX, btnY)
    }

    currentNbImgs   <- []
    currentNoiseImg <- 0
    investigating   <- 0
    playingStim     <- 0
    playingVessel   <- Nth(vessels, 1)

    ## Highlight box shown on heading strip around the active contact
    headingBgH  <- Round(200 * gZoom)
    hlW         <- Round(70 * gZoom)
    if(hlW < 50) { hlW <- 50 }
    hlCol       <- MakeColorRGB(200, 200, 0)
    hlBox       <- Rectangle(gOffscreenX, gHeadDispY, hlW, headingBgH + 4, hlCol, 0)
    AddObject(hlBox, gWin)


    Draw()

    done <- 0
    while(done == 0)
    {
        ## Build target list: all contacts + SELECT if investigating + DEFER if allowed
        targObjs <- CopyList(czObjs)
        targIds  <- []
        i <- 1
        while(i <= nContacts)
        {
            PushOnEnd(targIds, i)
            i <- i + 1
        }

        if(investigating > 0)
        {
            Move(selBtn, selBtnX, btnY)
            Move(selLbl, selBtnX, btnY)
            PushOnEnd(targObjs, selBtn)
            PushOnEnd(targIds,  -1)
        } else {
            Move(selBtn,  gOffscreenX, btnY)
            Move(selLbl,  gOffscreenX, btnY)
        }

        if(allowDefer == 1)
        {
            PushOnEnd(targObjs, deferBtn)
            PushOnEnd(targIds,  -2)
        }

        Draw()

        t0   <- GetTime()
        resp <- WaitForClickOnTarget(targObjs, targIds)
        totalRt <- totalRt + (GetTime() - t0)

        if(resp == -1)
        {
            ## SELECT current contact — log final dwell then terminal event
            contact         <- Nth(contacts, investigating)
            selectedId      <- contact.id
            selectedQuality <- contact.quality
            dwellMs <- GetTime() - investigateT
            erow <- [gSubNum, blockCfg.task_id, blockCfg.id, blockCfg.response_mode,
                     trialNum, "investigate", prevContactNum, prevContactId,
                     nInvestigated, dwellMs, GetTime()]
            FilePrint(dataFile, ConcatenateList(erow, ","))
            erow <- [gSubNum, blockCfg.task_id, blockCfg.id, blockCfg.response_mode,
                     trialNum, "select", prevContactNum, selectedId,
                     nInvestigated, totalRt, GetTime()]
            FilePrint(dataFile, ConcatenateList(erow, ","))
            done            <- 1
        } else {
            if(resp == -2)
            {
                ## DEFER — log terminal event (no dwell to close if not investigating)
                if(investigating > 0)
                {
                    dwellMs <- GetTime() - investigateT
                    erow <- [gSubNum, blockCfg.task_id, blockCfg.id, blockCfg.response_mode,
                             trialNum, "investigate", prevContactNum, prevContactId,
                             nInvestigated, dwellMs, GetTime()]
                    FilePrint(dataFile, ConcatenateList(erow, ","))
                }
                erow <- [gSubNum, blockCfg.task_id, blockCfg.id, blockCfg.response_mode,
                         trialNum, "defer", 0, 0, nInvestigated, totalRt, GetTime()]
                FilePrint(dataFile, ConcatenateList(erow, ","))
                deferred <- 1
                done     <- 1
            } else {
                ## Investigate a contact — log dwell on previous, clear display
                if(investigating > 0)
                {
                    dwellMs <- GetTime() - investigateT
                    erow <- [gSubNum, blockCfg.task_id, blockCfg.id, blockCfg.response_mode,
                             trialNum, "investigate", prevContactNum, prevContactId,
                             nInvestigated, dwellMs, GetTime()]
                    FilePrint(dataFile, ConcatenateList(erow, ","))
                    Move(currentNoiseImg, offscreenX, dispY)
                    ClearDisplay(currentNbImgs)
                    if(gWaterfallReady == 1) { Move(gBg, offscreenX, dispY) }
                }
                investigateT   <- GetTime()
                investigating  <- resp
                nInvestigated  <- nInvestigated + 1
                contact        <- Nth(contacts, investigating)
                prevContactId  <- contact.id
                prevContactNum <- investigating

                ## Move highlight box and label to this contact's bearing position
                bgNativeW      <- 2000
                bgScreenLeft   <- Round(gVideoWidth / 2 - bgNativeW * gZoom / 2.0)
                bearingX       <- Round(contact.bearing / 360.0 * bgNativeW)
                contactScreenX <- bgScreenLeft + Round(bearingX * gZoom)
                Move(hlBox, contactScreenX, gHeadDispY)
                ## Investigate shows narrowband: load waterfall if this recipe
                ## started as heading-only (gBg was never created at init).
                EnsureWaterfall()
                currentNoiseImg <- PickNoiseOverlay()
                Move(currentNoiseImg, Round(gVideoWidth/2), dispY)
                currentNbImgs <- RenderNarrowband(contact.sig, gZoom, dispY)
                Move(gBg, Round(gVideoWidth/2), dispY)
                if(playingStim == 1) { StopVesselStim(playingVessel) }
                playingVessel <- GetVessel(contact.id, vessels)
                PlayVesselStim(playingVessel)
                playingStim <- 1
                Draw()
            }
        }
    }

    ## Clean up
    if(playingStim == 1) { StopVesselStim(playingVessel) }
    loop(imgs, czImgs) { ClearDisplay(imgs) }
    loop(cz,   czObjs) { RemoveObject(cz, gWin) }
    if(currentNoiseImg != 0)
    {
        Move(currentNoiseImg, offscreenX, dispY)
    }
    ClearDisplay(currentNbImgs)
    if(gWaterfallReady == 1)
    {
        Move(gBg, offscreenX, dispY)
    }
    Move(selBtn,   gOffscreenX, btnY)
    Move(selLbl,   gOffscreenX, btnY)
    Move(deferBtn, gOffscreenX, btnY)
    Move(deferLbl, gOffscreenX, btnY)
    RemoveObject(hlBox, gWin)
    Hide(targetV.thumbImg)
    Hide(targetV.lbl)

    ## Was a target (vessel id==1) present this round?
    hasTarget  <- 0
    loop(c, contacts)
    {
        if(c.id == targetV.id) { hasTarget <- 1 }
    }

    ## Outcome
    points   <- 0
    ptStr    <- ""
    missCost <- blockCfg.miss_cost
    if(deferred == 1)
    {
        if(hasTarget == 1)
        {
            ## Miss: deferred when target was present
            points <- missCost
            if(points == 0)
            {
                ptStr <- "Deferred — target was present (0 pts)"
            } else {
                ptStr <- "Deferred — target was present (" + points + " pts)"
            }
        } else {
            ## Correct rejection: no target, safe to defer
            points <- deferCost
            ptStr  <- "Deferred — no target (correct)"
        }
        UpdateScoreHUD(points)
    } else {
        if(selectedId > 0)
        {
            points <- selectedQuality
            UpdateScoreHUD(points)
            if(points >= 0)
            {
                ptStr <- "Selected: +" + points
            } else {
                ptStr <- "Selected: " + points
            }
        } else {
            points <- 0
            ptStr  <- "No selection — 0 pts"
        }
    }

    msg <- MakeLabel(ptStr, gFontFB)
    AddObject(msg, gWin)
    Move(msg, Round(gVideoWidth/2), fbY)
    Draw()
    Wait(1000)
    RemoveObject(msg, gWin)
    Draw()
    Wait(blockCfg.isi)

    return([selectedId, selectedQuality, nInvestigated, nContacts, totalRt, absT, deferred, hasTarget, points])
}


## Pick a bearing that is at least minSep degrees from all bearings in usedList.
define PickSeparatedBearing(usedList, minSep)
{
    bearing <- 0
    found   <- 0
    tries   <- 0
    while(found == 0 and tries < 200)
    {
        tries   <- tries + 1
        bearing <- Round(Random() * 359)
        tooClose <- 0
        loop(b, usedList)
        {
            diff <- Abs(bearing - b)
            if(diff > 180) { diff <- 360 - diff }
            if(diff < minSep) { tooClose <- 1 }
        }
        if(tooClose == 0) { found <- 1 }
    }
    return(bearing)
}


## Build contacts for one secretary round.
## Target rate: P(target_rate) chance of exactly one high-value vessel (id==1);
## remaining slots filled with vessel 2 (low-value).
## Bearings spaced at least secretary_min_sep degrees apart.
define BuildSecretaryContacts(blockCfg, vessels)
{
    nMax       <- blockCfg.secretary_n_contacts
    targetRate <- blockCfg.secretary_target_rate
    minSep     <- blockCfg.secretary_min_sep

    v1 <- Nth(vessels, 1)
    v2 <- Nth(vessels, 2)

    ## Number of contacts: uniform 1..nMax (Floor avoids rounding bias at endpoints)
    nContacts <- 1 + Floor(Random() * nMax)

    ## 0 or 1 target per round
    hasTarget <- 0
    if(Random() < targetRate) { hasTarget <- 1 }

    ## Build vessel id list: one v1 if hasTarget, rest v2
    idList <- []
    if(hasTarget == 1) { PushOnEnd(idList, v1.id) }
    i <- Length(idList) + 1
    while(i <= nContacts)
    {
        PushOnEnd(idList, v2.id)
        i <- i + 1
    }
    idList <- Shuffle(idList)

    ## Assign separated bearings and build contact objects
    usedBearings <- []
    contacts     <- []
    contactNum   <- 1
    loop(vid, idList)
    {
        v       <- GetVessel(vid, vessels)
        bearing <- PickSeparatedBearing(usedBearings, minSep)
        PushOnEnd(usedBearings, bearing)

        c              <- MakeCustomObject("contact")
        c.id           <- v.id
        c.name         <- "Contact " + contactNum
        c.contact_type <- "solid"
        contactNum     <- contactNum + 1
        c.quality      <- Round(v.payoff_mean + RandomNormal(0, v.payoff_sd))
        c.bearing      <- bearing
        ## Target: probabilistic display of alpha bands + jitter
        ## Foil: p_close_foil chance of a close shifted foil; otherwise random
        if(vid == v1.id)
        {
            c.sig <- MakeTargetSig(v.sig, blockCfg.p_show, blockCfg.sig_jitter, blockCfg.p_leak)
        } else {
            if(Random() < blockCfg.p_close_foil)
            {
                c.sig <- MakeCloseFoilSig(v1.sig, blockCfg.close_foil_min, blockCfg.close_foil_max)
            } else {
                c.sig <- MakeFoilSig(v1.sig, 5, blockCfg.p_alpha_leak, blockCfg.sig_jitter)
            }
        }
        PushOnEnd(contacts, c)
    }

    return(contacts)
}


define LogSecretaryTrial(dataFile, blockCfg, trialNum, trialResult)
{
    selectedId    <- Nth(trialResult, 1)
    quality       <- Nth(trialResult, 2)
    nInvestigated <- Nth(trialResult, 3)
    nContacts     <- Nth(trialResult, 4)
    rt            <- Nth(trialResult, 5)
    absT          <- Nth(trialResult, 6)
    deferred      <- Nth(trialResult, 7)
    hasTarget     <- Nth(trialResult, 8)
    points        <- Nth(trialResult, 9)

    row <- [gSubNum, blockCfg.task_id, blockCfg.id, blockCfg.response_mode,
            trialNum, selectedId, "", selectedId, deferred, "", points,
            blockCfg.signal_mode, rt, "", absT,
            nContacts, nInvestigated, hasTarget, "", "", "", "", "", "", ""]
    FilePrint(dataFile, ConcatenateList(row, ","))
}


## ============================================================
## SABART — sonar analog of the Balloon Analog Risk Task
## A recorder is on an underwater cable. Each WAIT records more traffic
## (constant payout). RETRIEVE DEVICE is a safe exfil and banks the take.
## If the nearby ship pings you: PING DETECTED, then command cuts the
## cable and that intercept is lost. Ship class is the threat type
## (BART balloon color), not the collection target.
## Breakpoints use battery/BART/bart.pbl.
## ============================================================

## Sequential 1/k sampling: P(return k) = 1/life for k in 1..life.
define SampleBreakpoint(life)
{
    cont <- 1
    while(cont == 1)
    {
        if(RandomDiscrete(life) == 1)
        {
            cont <- 0
        } else {
            life <- life - 1
        }
    }
    return(life)
}


## Sample `num` breakpoints whose mean is life/2 + min (within 0.1).
## min=0 is standard BART; min=1 never pops on the first wait.
define SampleBreakpointSet(life, num, min:0)
{
    set <- []
    loop(i, Sequence(1, num, 1))
    {
        set <- Append(set, SampleBreakpoint(life) + min)
    }

    sum <- Sum(set)

    while(Abs(sum / num - min - life / 2) > 0.1)
    {
        candidate <- SampleBreakpoint(life) + min
        sum <- sum - First(set) + candidate
        set <- Append(Rest(set), candidate)
    }

    return(set)
}


## Precompute [vesselId, breakpoint] pairs for this block.
## sabart_vessel != 0 → all trials that type; else equal mix, shuffled.
define BuildSabartSchedule(blockCfg, vessels)
{
    minW     <- blockCfg.sabart_min_waits
    schedule <- []

    if(blockCfg.sabart_vessel != 0)
    {
        v     <- GetVessel(blockCfg.sabart_vessel, vessels)
        lives <- SampleBreakpointSet(v.bart_life, blockCfg.trials, minW)
        loop(lf, lives)
        {
            PushOnEnd(schedule, [v.id, lf])
        }
    } else {
        nV    <- Length(vessels)
        nEach <- Floor(blockCfg.trials / nV)
        extra <- blockCfg.trials - nEach * nV
        loop(v, vessels)
        {
            nThis <- nEach
            if(extra > 0)
            {
                nThis <- nThis + 1
                extra <- extra - 1
            }
            if(nThis >= 1)
            {
                lives <- SampleBreakpointSet(v.bart_life, nThis, minW)
                loop(lf, lives)
                {
                    PushOnEnd(schedule, [v.id, lf])
                }
            }
        }
        schedule <- Shuffle(schedule)
    }

    return(schedule)
}


define MakeSabartButtons()
{
    waitCol  <- MakeColorRGB(60, 60, 60)
    diveCol  <- MakeColorRGB(0, 90, 40)
    trackCol <- MakeColorRGB(20, 40, 20)
    fillCol  <- MakeColorRGB(220, 200, 60)
    PushOnEnd(gKeep, waitCol)
    PushOnEnd(gKeep, diveCol)
    PushOnEnd(gKeep, trackCol)
    PushOnEnd(gKeep, fillCol)

    waitBtn <- Rectangle(gOffscreenX, 0, 200, 50, waitCol, 1)
    waitLbl <- MakeLabel("WAIT", gBtnFont)
    AddObject(waitBtn, gWin)
    AddObject(waitLbl, gWin)
    Move(waitLbl, gOffscreenX, 0)

    diveBtn <- Rectangle(gOffscreenX, 0, 320, 50, diveCol, 1)
    diveLbl <- MakeLabel("RETRIEVE DEVICE", gBtnFont)
    AddObject(diveBtn, gWin)
    AddObject(diveLbl, gWin)
    Move(diveLbl, gOffscreenX, 0)

    cx     <- Round(gVideoWidth / 2)
    trackW <- 400
    barH   <- 18
    track  <- Rectangle(gOffscreenX, 0, trackW, barH, trackCol, 1)
    fill   <- Rectangle(gOffscreenX, 0, 4, 14, fillCol, 1)
    AddObject(track, gWin)
    AddObject(fill, gWin)

    lastLbl <- MakeLabel("Last intercept: 0", gFontLbl)
    AddObject(lastLbl, gWin)
    Move(lastLbl, gOffscreenX, 0)

    nameLbl <- MakeLabel("", gFontLarge)
    AddObject(nameLbl, gWin)
    Move(nameLbl, gOffscreenX, 0)

    gSabartFillCol <- fillCol
    gSabartTrackW  <- trackW
    gSabartFill    <- fill

    return([waitBtn, waitLbl, diveBtn, diveLbl, track, fill, lastLbl, nameLbl])
}


define EnsureSabartButtons()
{
    if(Length(gSabartBtns) == 0)
    {
        gSabartBtns <- MakeSabartButtons()
        gSabartLastPts <- 0
    }
}


define ParkSabartButtons()
{
    if(Length(gSabartBtns) > 0)
    {
        waitBtn <- Nth(gSabartBtns, 1)
        waitLbl <- Nth(gSabartBtns, 2)
        diveBtn <- Nth(gSabartBtns, 3)
        diveLbl <- Nth(gSabartBtns, 4)
        track   <- Nth(gSabartBtns, 5)
        lastLbl <- Nth(gSabartBtns, 7)
        nameLbl <- Nth(gSabartBtns, 8)
        Move(waitBtn, gOffscreenX, 0)
        Move(waitLbl, gOffscreenX, 0)
        Move(diveBtn, gOffscreenX, 0)
        Move(diveLbl, gOffscreenX, 0)
        Move(track, gOffscreenX, 0)
        Move(gSabartFill, gOffscreenX, 0)
        Move(lastLbl, gOffscreenX, 0)
        Move(nameLbl, gOffscreenX, 0)
        Move(gResponseBox, gOffscreenX, gDispY)
    }
}


## Grow the intel bar from the left of the track. Same step every wait
## (BART balloon radius += 2 regardless of type).
define SetSabartIntelBar(waits, barY)
{
    trackW <- gSabartTrackW
    cx     <- Round(gVideoWidth / 2)
    fillW  <- 4 + waits * 4
    if(fillW > trackW) { fillW <- trackW }
    fillCx <- Round(cx - trackW / 2.0 + fillW / 2.0)

    oldFill <- gSabartFill
    RemoveObject(oldFill, gWin)
    fill <- Rectangle(fillCx, barY, fillW, 14, gSabartFillCol, 1)
    AddObject(fill, gWin)
    gSabartFill <- fill
    SetElement(gSabartBtns, 6, fill)
}


define RunSabartTrial(blockCfg, vessels, dispY, fbY, trialNum)
{
    item     <- Nth(gSabartSchedule, trialNum)
    vesselId <- First(item)
    life     <- Second(item)
    vessel   <- GetVessel(vesselId, vessels)
    ptsWait  <- blockCfg.sabart_points_per_wait

    waitBtn <- Nth(gSabartBtns, 1)
    waitLbl <- Nth(gSabartBtns, 2)
    diveBtn <- Nth(gSabartBtns, 3)
    diveLbl <- Nth(gSabartBtns, 4)
    track   <- Nth(gSabartBtns, 5)
    lastLbl <- Nth(gSabartBtns, 7)
    nameLbl <- Nth(gSabartBtns, 8)

    btnY  <- fbY + 50
    waitX <- Round(gVideoWidth * 0.35)
    diveX <- Round(gVideoWidth * 0.65)
    barY  <- fbY
    cx    <- Round(gVideoWidth / 2)

    Move(waitBtn, waitX, btnY)
    Move(waitLbl, waitX, btnY)
    Move(diveBtn, gOffscreenX, btnY)
    Move(diveLbl, gOffscreenX, btnY)
    Move(track, cx, barY)
    SetSabartIntelBar(0, barY)
    lastLbl.text <- "Last intercept: " + gSabartLastPts
    Move(lastLbl, Round(gVideoWidth * 0.88), 68)
    nameLbl.text <- vessel.name
    Move(nameLbl, cx, Round(gVideoHeight * 0.08))
    Move(gResponseBox, vessel.thumbX, vessel.thumbY)

    stripImgs <- RenderNarrowband(vessel.sig, gZoom, dispY)
    Draw()

    waits  <- 0
    temp   <- 0
    burst  <- 0
    cont   <- 1
    startT <- GetTime()

    while(cont == 1)
    {
        clickTargets <- [waitBtn]
        clickVals    <- [1]
        if(waits > 0)
        {
            clickTargets <- [waitBtn, diveBtn]
            clickVals    <- [1, 2]
        }
        clicked <- WaitForClickOnTarget(clickTargets, clickVals)

        if(clicked == 1)
        {
            waits <- waits + 1
            SetSabartIntelBar(waits, barY)
            if(waits == life)
            {
                burst <- 1
                temp  <- 0
                gSabartLastPts <- 0
                lastLbl.text <- "Last intercept: 0"
                fbLbl <- MakeLabel("PING DETECTED", gFontNogo)
                AddObject(fbLbl, gWin)
                Move(fbLbl, cx, fbY - 36)
                PlayPing()
                Draw()
                Wait(500)
                fbLbl.text <- "Commander cut the cable. Intel lost."
                Draw()
                Wait(blockCfg.isi + 200)
                RemoveObject(fbLbl, gWin)
                cont <- 0
            } else {
                temp <- temp + ptsWait
                Move(diveBtn, diveX, btnY)
                Move(diveLbl, diveX, btnY)
                Draw()
            }
        } else {
            gSabartLastPts <- temp
            lastLbl.text <- "Last intercept: " + temp
            UpdateScoreHUD(temp)
            gScoreHUD.text <- "Traffic: " + gCumulScore
            fbLbl <- MakeLabel("EXFIL  +" + temp, gFontGo)
            AddObject(fbLbl, gWin)
            Move(fbLbl, cx, fbY - 36)
            PlaySuccess()
            Draw()
            Wait(blockCfg.isi)
            RemoveObject(fbLbl, gWin)
            cont <- 0
        }
    }

    rt   <- GetTime() - startT
    absT <- GetTime()
    ClearDisplay(stripImgs)
    SetSabartIntelBar(0, barY)
    Move(diveBtn, gOffscreenX, btnY)
    Move(diveLbl, gOffscreenX, btnY)
    Move(gResponseBox, gOffscreenX, dispY)
    Draw()

    return([vesselId, waits, life, burst, temp, rt, absT])
}


define LogSabartTrial(dataFile, blockCfg, trialNum, result, vessels)
{
    vesselId <- Nth(result, 1)
    waits    <- Nth(result, 2)
    life     <- Nth(result, 3)
    burst    <- Nth(result, 4)
    points   <- Nth(result, 5)
    rt       <- Nth(result, 6)
    absT     <- Nth(result, 7)

    vessel     <- GetVessel(vesselId, vessels)
    vesselName <- vessel.name
    outcome    <- "retrieved"
    correct    <- 1
    if(burst == 1)
    {
        outcome <- "pinged"
        correct <- 0
    }

    row <- [gSubNum, blockCfg.task_id, blockCfg.id, blockCfg.response_mode,
            trialNum, vesselId, vesselName, waits, correct, outcome, points,
            blockCfg.signal_mode, rt, "", absT,
            SigToStr(vessel.sig), "", life, waits, burst,
            vessel.bart_life, "", "", "", "", "", ""]
    FilePrint(dataFile, ConcatenateList(row, ","))
}


## ============================================================
## BLOCK RUNNER
## SetupMode / RunModeTrial / TeardownMode keep per-mode UI out of Start().
## ============================================================

define IsHeadingGame(mode)
{
    result <- 0
    if(mode == "bandit" or mode == "secretary" or mode == "urns" or mode == "horizon")
    {
        result <- 1
    }
    return(result)
}


define DefaultRuleForMode(mode, vessels)
{
    rule <- ""
    if(mode == "gonogo")    { rule <- "GO target: respond. Withhold for other contacts." }
    if(mode == "simon")     { rule <- BuildSimonRuleText(vessels) }
    if(mode == "choice")    { rule <- "Identify the vessel (left/right keys or click)." }
    if(mode == "cued")      { rule <- "Cue flashes, then identify the vessel." }
    if(mode == "bandit")    { rule <- "Choose a sector to monitor each round." }
    if(mode == "secretary") { rule <- "Observe contacts in order. STOP when you see the best — no going back." }
    if(mode == "urns")      { rule <- "DRAW samples, or STOP and choose EAST or WEST." }
    if(mode == "horizon")   { rule <- "GATHER: auto-sample. Then choose EAST or WEST." }
    if(mode == "sabart")    { rule <- "WAIT to record. RETRIEVE DEVICE before they ping you." }
    if(mode == "reversal")  { rule <- "Identify the vessel. Mapping will reverse — watch for feedback." }
    return(rule)
}


## Prepare widgets for this block. Returns extra objects (e.g. gonogo/simon labels).
define SetupMode(blockCfg, vessels)
{
    mode  <- blockCfg.response_mode
    extra <- []

    if(IsHeadingGame(mode) == 1)
    {
        loop(v, vessels) { Hide(v.thumbImg); Hide(v.lbl) }
        Draw()
    } else {
        if(blockCfg.show_thumbnails == 0)
        {
            ApplyVesselThumbDisplay(vessels, 1)
        } else {
            ApplyVesselThumbDisplay(vessels, 0)
        }
    }

    ## Heading-strip games (incl. bandit/IGT): always ensure bearing panel.
    ## Secretary also investigates on the waterfall — ensure that too.
    if(mode == "secretary" or mode == "urns" or mode == "horizon" or mode == "bandit")
    {
        EnsureHeading()
        Move(gHeadingBg, Round(gVideoWidth/2), gHeadDispY)
        Draw()
    }
    if(mode == "secretary" or mode == "cued")
    {
        EnsureWaterfall()
    }

    if(gLayout2AFCReady == 1) { HideLayoutUI(gLayout2AFC) }
    if(gGoLayoutReady == 1)   { HideLayoutUI(gGoLayout) }

    if(mode == "gonogo")
    {
        EnsureGoLayout()
        ShowLayoutUI(gGoLayout)
        extra <- SetupGonogDisplay(vessels, blockCfg)
    }
    if(mode == "simon")
    {
        gParams.responselabels <- TwoAFCSideNames(vessels)
        Ensure2AFCLayout()
        ApplyTwoAFCLayoutLabels(vessels)
        ShowLayoutUI(gLayout2AFC)
        RepositionSimonThumbs(vessels)
        extra <- SetupSimonDisplay(vessels, blockCfg)
    }
    if(mode == "cued" or mode == "choice" or mode == "reversal")
    {
        if(Length(vessels) == 2)
        {
            gParams.responselabels <- TwoAFCSideNames(vessels)
            Ensure2AFCLayout()
            ApplyTwoAFCLayoutLabels(vessels)
            ShowLayoutUI(gLayout2AFC)
        }
    }
    ApplySftStimulus(blockCfg, vessels)
    if(mode == "secretary") { EnsureSecretaryButtons() }
    if(mode == "urns")      { EnsureUrnsButtons() }
    if(mode == "horizon")   { EnsureHorizonButtons() }
    if(mode == "sabart")
    {
        EnsureWaterfall()
        EnsureSabartButtons()
        gSabartSchedule <- BuildSabartSchedule(blockCfg, vessels)
        gScoreHUD.text <- "Traffic: " + gCumulScore
        loop(v, vessels) { Show(v.thumbImg); Show(v.lbl) }
        Draw()
    }

    return(extra)
}


define TeardownMode(blockCfg, vessels, extra)
{
    mode <- blockCfg.response_mode

    if(mode == "gonogo")
    {
        TeardownGonogDisplay(vessels, extra)
        HideLayoutUI(gGoLayout)
    }
    if(mode == "simon")
    {
        TeardownSimonDisplay(extra)
        HideLayoutUI(gLayout2AFC)
        loop(v, vessels)
        {
            Move(v.thumbImg, v.thumbX, v.thumbY)
            tbgW   <- Round(gVideoWidth * 0.125)
            tzoomX <- tbgW / 240.0
            tbgH   <- Round(60 * tzoomX)
            Move(v.lbl, v.thumbX, v.thumbY + Round(tbgH / 2) + 28)
        }
    }
    if(mode == "cued" or mode == "choice" or mode == "reversal")
    {
        if(gLayout2AFCReady == 1) { HideLayoutUI(gLayout2AFC) }
    }
    if(mode == "sabart")
    {
        ParkSabartButtons()
        gScoreHUD.text <- "Score: " + gCumulScore
    }

    if(IsHeadingGame(mode) == 1)
    {
        loop(v, vessels) { Show(v.thumbImg); Show(v.lbl) }
        if(mode == "secretary" or mode == "urns" or mode == "horizon")
        {
            Move(gHeadingBg, gOffscreenX, gHeadDispY)
        }
        Draw()
    } else {
        ## Park all response options after the block so the next instructions
        ## screen does not show Biological alone (or leftover kilo thumbs).
        HideAllResponseOptions(vessels)
    }
}


## One trial. Returns a result list for LogTrial, or [] if the mode logged itself.
define RunModeTrial(blockCfg, vessels, noiseImgs, dispY, fbY, offscreenX, dataFile, trialNum)
{
    mode   <- blockCfg.response_mode
    result <- []

    if(mode == "gonogo")
    {
        result <- RunGonogTrial(blockCfg, vessels, noiseImgs, dispY, fbY, offscreenX)
    }
    if(mode == "simon")
    {
        result <- RunSimonTrial(blockCfg, vessels, noiseImgs, dispY, fbY, offscreenX)
    }
    if(mode == "cued")
    {
        trialResult <- RunCuedTrial(blockCfg, vessels, noiseImgs, gHeadDispY, gNbDispY, fbY, offscreenX)
        LogCuedTrial(dataFile, blockCfg, trialNum, trialResult, vessels)
        result <- []
    }
    if(mode == "bandit")
    {
        trialResult <- RunBanditTrial(blockCfg, vessels, dispY, fbY)
        LogBanditTrial(dataFile, blockCfg, trialNum, trialResult, vessels)
        result <- []
    }
    if(mode == "secretary")
    {
        contacts    <- BuildSecretaryContacts(blockCfg, vessels)
        trialResult <- RunSecretaryRound(blockCfg, contacts, noiseImgs, dispY, fbY, offscreenX, gSecretaryBtns, vessels, dataFile, trialNum)
        LogSecretaryTrial(dataFile, blockCfg, trialNum, trialResult)
        result <- []
    }
    if(mode == "urns")
    {
        trialResult <- RunUrnsRound(blockCfg, gUrnsBtns, dataFile, trialNum)
        LogUrnsTrial(dataFile, blockCfg, trialNum, trialResult)
        result <- []
    }
    if(mode == "horizon")
    {
        RunHorizonGame(blockCfg, gHorizonBtns, dataFile, trialNum)
        result <- []
    }
    if(mode == "sabart")
    {
        trialResult <- RunSabartTrial(blockCfg, vessels, dispY, fbY, trialNum)
        LogSabartTrial(dataFile, blockCfg, trialNum, trialResult, vessels)
        result <- []
    }
    if(mode == "choice")
    {
        result <- RunTrial(blockCfg, vessels, noiseImgs, dispY, fbY, offscreenX)
    }
    ## Unknown modes fall through to choice-style RunTrial.
    ## handled == 0 means no branch above set result or logged its own trial.
    handled <- 0
    if(mode == "gonogo" or mode == "simon" or mode == "choice")   { handled <- 1 }
    if(mode == "cued"   or mode == "bandit" or mode == "secretary") { handled <- 1 }
    if(mode == "urns"   or mode == "horizon" or mode == "sabart")   { handled <- 1 }
    if(handled == 0)
    {
        result <- RunTrial(blockCfg, vessels, noiseImgs, dispY, fbY, offscreenX)
    }

    return(result)
}


define ApplyAdaptLevel(blockCfg, level)
{
    if(blockCfg.channel == "visual")
    {
        gCurrentJitter <- level
        blockCfg.signal_params.jitter_sd <- level
    } else {
        gCurrentAudGain <- level
    }
}


define StoreAdaptCalibration(blockCfg, levels, lastPass)
{
    hiIdx <- lastPass - blockCfg.adapt_hi_steps
    if(hiIdx < 1) { hiIdx <- 1 }
    loVal <- Nth(levels, lastPass)
    hiVal <- Nth(levels, hiIdx)
    if(blockCfg.channel == "visual")
    {
        gVisJitterLo   <- loVal
        gVisJitterHi   <- hiVal
        gVisCalibrated <- 1
    } else {
        gAudGainLo     <- loVal
        gAudGainHi     <- hiVal
        gAudCalibrated <- 1
    }
    Print("SFT calib " + blockCfg.channel + " hi=" + hiVal + " lo=" + loVal)
}


define ShowAdaptResult(blockCfg, levels, lastPass)
{
    hiIdx <- lastPass - blockCfg.adapt_hi_steps
    if(hiIdx < 1) { hiIdx <- 1 }
    loVal <- Nth(levels, lastPass)
    hiVal <- Nth(levels, hiIdx)
    kind <- blockCfg.channel
    msg <- "<h3=center>Calibration done (" + kind + ")</h3>Easy (hi) level: <b>" + hiVal + "</b><li>Hard (lo) level: <b>" + loVal + "</b> (last 10-trial window at or above 80%)<li>These levels will be used in the remaining blocks."
    tbW <- Round(gVideoWidth * 0.55)
    tbH <- Round(gVideoHeight * 0.40)
    tbX <- Round((gVideoWidth - tbW) / 2)
    tbY <- Round(gVideoHeight * 0.20)
    tb <- EasyTextBox(msg, tbX, tbY, gWin, 16, tbW, tbH)
    SetProperty(tb, "FORMATTED", 1)
    AddObject(gClickLbl, gWin)
    Move(gClickLbl, Round(gVideoWidth / 2), Round(tbY + tbH + 30))
    Draw()
    WaitForClickOnTarget([gClickLbl], [1])
    RemoveObject(tb, gWin)
    RemoveObject(gClickLbl, gWin)
    Draw()
}


## ============================================================
## STAIRCASE LIBRARY FUNCTIONS
## (Kaernbach 1991 weighted up-down; intended for future Staircase.pbl)
## ============================================================

## SCInit — create a staircase object.
## Kaernbach (1991) weighted up-down convention:
##   invert=0 (audio): correct -> level -= stepDown (quieter/harder), error -> level += stepUp
##   invert=1 (visual): correct -> level += stepDown (noisier/harder), error -> level -= stepUp
##   convergence at P(correct) = stepUp / (stepUp + stepDown)
define SCInit(startLevel, stepUp, stepDown, minLevel, maxLevel, invert)
{
    sc <- MakeCustomObject("staircase")
    sc.level      <- startLevel
    sc.stepUp     <- stepUp
    sc.stepDown   <- stepDown
    sc.minLevel   <- minLevel
    sc.maxLevel   <- maxLevel
    sc.invert     <- invert
    sc.nTrials    <- 0
    sc.nCorrect   <- 0
    sc.nReversals <- 0
    sc.lastDir    <- 0
    sc.reversals  <- []
    sc.levels     <- []
    sc.corrects   <- []
    sc.rts        <- []
    sc.stuck      <- 0
    sc.stuckAt    <- ""
    return(sc)
}


## Returns 1 if the last stuckWindow trials have all been at the same boundary.
define SCIsStuck(sc, stuckWindow)
{
    result <- 0
    n      <- sc.nTrials
    if(n >= stuckWindow)
    {
        start   <- n - stuckWindow + 1
        recent  <- SubList(sc.levels, start, n)
        atFloor <- 1
        atCeil  <- 1
        loop(lev, recent)
        {
            if(lev > sc.minLevel) { atFloor <- 0 }
            if(lev < sc.maxLevel) { atCeil  <- 0 }
        }
        if(atFloor == 1) { result <- 1 }
        if(atCeil  == 1) { result <- 1 }
    }
    return(result)
}


## Update staircase after one trial.
## correct : 1 if correct, 0 if error
## rt      : response time ms (0 if not tracking RT)
## Returns updated sc — caller must store: sc <- SCUpdate(sc, correct, rt)
define SCUpdate(sc, correct, rt)
{
    sc.nTrials  <- sc.nTrials + 1
    sc.nCorrect <- sc.nCorrect + correct
    PushOnEnd(sc.levels,   sc.level)
    PushOnEnd(sc.corrects, correct)
    PushOnEnd(sc.rts,      rt)

    oldLevel <- sc.level
    newDir   <- 1
    if(sc.invert == 0)
    {
        ## Standard (audio): correct -> easier (lower), error -> harder (higher)
        if(correct == 1)
        {
            sc.level <- sc.level - sc.stepDown
            if(sc.level < sc.minLevel) { sc.level <- sc.minLevel }
            newDir <- -1
        } else {
            sc.level <- sc.level + sc.stepUp
            if(sc.level > sc.maxLevel) { sc.level <- sc.maxLevel }
        }
    } else {
        ## Inverted (visual): correct -> harder (higher jitter), error -> easier (lower jitter)
        if(correct == 1)
        {
            sc.level <- sc.level + sc.stepDown
            if(sc.level > sc.maxLevel) { sc.level <- sc.maxLevel }
            newDir <- 1
        } else {
            sc.level <- sc.level - sc.stepUp
            if(sc.level < sc.minLevel) { sc.level <- sc.minLevel }
            newDir <- -1
        }
    }

    if(sc.lastDir != 0 and newDir != sc.lastDir)
    {
        sc.nReversals <- sc.nReversals + 1
        PushOnEnd(sc.reversals, oldLevel)
    }
    sc.lastDir <- newDir
    return(sc)
}


## Estimate threshold as mean of reversal points, skipping the first skipFirst.
define SCEstimate(sc, skipFirst)
{
    revs <- sc.reversals
    n    <- Length(revs)
    est  <- sc.level
    if(n > 0)
    {
        start <- skipFirst + 1
        if(start > n) { start <- 1 }
        used <- SubList(revs, start, n)
        est  <- Mean(used)
    }
    return(est)
}


## Derive Kaernbach step sizes from the level range.
## Returns [stepUp, stepDown, valid, warning].
## targetP: desired convergence accuracy (e.g. 0.75, 0.90).
## stepDivisor: range/stepDivisor = stepUp. 20 is a good default.
define SCStepsFromRange(minLevel, maxLevel, targetP, stepDivisor)
{
    rangeWidth <- maxLevel - minLevel
    stepUp     <- Round(rangeWidth / stepDivisor * 1000) / 1000.0
    stepDown   <- Round(stepUp * (1.0 - targetP) / targetP * 1000) / 1000.0
    valid      <- 1
    warning    <- ""
    if(targetP <= 0)
    {
        valid   <- 0
        warning <- "WARNING: targetP=" + targetP + " <= 0"
    }
    if(targetP >= 1.0)
    {
        valid   <- 0
        warning <- "WARNING: targetP=" + targetP + " >= 1.0"
    }
    return([stepUp, stepDown, valid, warning])
}


## ============================================================
## Kaernbach staircase adaptive calibration.
## Replaces the step-down ladder (RunAdaptiveBlock).
##
## Config fields (with defaults):
##   sc_target_p      (0.75)    convergence accuracy
##   sc_step_divisor  (20)      range/divisor = stepUp
##   sc_min_level     (0)       floor (jitter_sd or audio gain)
##   sc_max_level     (68)      ceiling
##   sc_start_level   (34)      starting level (midpoint)
##   sc_stop_reversals (12)     stop after this many reversals
##   sc_skip_first    (4)       reversals to skip when averaging
##   sc_stuck_window  (20)      declare stuck if last N at boundary
##   adapt_hi_steps   (2)       hi = est - hi_steps*stepDown
##
## After completion, StoreAdaptCalibration uses the threshold estimate
## and the hi_steps offset — same as before.
## ============================================================
define RunAdaptiveBlock(blockCfg, vessels, noiseImgs, dispY, fbY, offscreenX, dataFile)
{
    ## Parameters — sc_* fields always set by ParseBlock; fall back to adapt_levels range
    targetP       <- blockCfg.sc_target_p
    stepDivisor   <- blockCfg.sc_step_divisor
    stopReversals <- blockCfg.sc_stop_reversals
    skipFirst     <- blockCfg.sc_skip_first
    stuckWindow   <- blockCfg.sc_stuck_window
    maxTrials     <- blockCfg.sc_max_trials

    ## Derive min/max from adapt_levels if not explicitly set via sc_ JSON fields.
    ## Staircase level = the difficulty parameter fed to ApplyAdaptLevel.
    ## Visual: jitter_sd; correct -> more jitter (harder), invert=1. Audio: gain; correct -> quieter (harder), invert=0.
    ## Audio:  gain;      correct -> less gain (harder).   minLevel=0.10, maxLevel=1.0.
    ## Audio adapt_levels list is descending (1.0..0.10), so first=max, last=min.
    nLev     <- Length(blockCfg.adapt_levels)
    minLevel <- blockCfg.sc_min_level
    maxLevel <- blockCfg.sc_max_level
    if(blockCfg.sc_min_level == blockCfg.sc_max_level)
    {
        if(blockCfg.channel == "audio")
        {
            minLevel <- Nth(blockCfg.adapt_levels, nLev)
            maxLevel <- Nth(blockCfg.adapt_levels, 1)
        } else {
            minLevel <- Nth(blockCfg.adapt_levels, 1)
            maxLevel <- Nth(blockCfg.adapt_levels, nLev)
        }
    }
    startLevel <- blockCfg.sc_start_level
    if(startLevel == 0)
    {
        startLevel <- minLevel + (maxLevel - minLevel) / 2.0
    }

    stepsData <- SCStepsFromRange(minLevel, maxLevel, targetP, stepDivisor)
    stepUp    <- Nth(stepsData, 1)
    stepDown  <- Nth(stepsData, 2)

    ## Visual: higher jitter = harder, so invert=1. Audio: lower gain = harder, invert=0.
    scInvert <- 0
    if(blockCfg.channel == "visual") { scInvert <- 1 }
    sc <- SCInit(startLevel, stepUp, stepDown, minLevel, maxLevel, scInvert)

    gCurrentChannel <- blockCfg.channel
    if(blockCfg.channel == "audio")  { gCurrentJitter  <- 0   }
    if(blockCfg.channel == "visual") { gCurrentAudGain <- 1.0 }

    ApplyAdaptLevel(blockCfg, sc.level)
    Draw()

    ## Build vessel id list and run-length deck.
    ## Deck [1,1,1,1,2,2,3] shuffled; each value = how many consecutive trials
    ## to show the current vessel before switching. Max run = 3.
    vesselIds  <- []
    loop(v, vessels) { PushOnEnd(vesselIds, v.id) }
    nVesselIds  <- Length(vesselIds)
    runDeck     <- Shuffle([1, 1, 1, 1, 2, 2, 3])
    deckIdx     <- 1
    curVesselIdx <- 1
    trialsLeft  <- Nth(runDeck, deckIdx)

    trialNum <- 1
    done     <- 0

    while(done == 0)
    {
        ## Advance deck when current run exhausted; switch vessel.
        if(trialsLeft == 0)
        {
            deckIdx <- deckIdx + 1
            if(deckIdx > Length(runDeck))
            {
                runDeck <- Shuffle(runDeck)
                deckIdx <- 1
            }
            trialsLeft   <- Nth(runDeck, deckIdx)
            curVesselIdx <- Mod(curVesselIdx, nVesselIds) + 1
        }
        trialsLeft <- trialsLeft - 1
        blockCfg.forced_vessel_id <- Nth(vesselIds, curVesselIdx)
        trialResult <- RunTrial(blockCfg, vessels, noiseImgs, dispY, fbY, offscreenX)
        blockCfg.forced_vessel_id <- 0
        correct     <- Nth(trialResult, 4)
        rt          <- Nth(trialResult, 3)
        LogTrial(dataFile, blockCfg, trialNum, trialResult, vessels)

        sc <- SCUpdate(sc, correct, rt)
        ApplyAdaptLevel(blockCfg, sc.level)

        if(sc.nReversals >= stopReversals) { done <- 1 }
        if(maxTrials > 0 and trialNum >= maxTrials) { done <- 1 }
        if(SCIsStuck(sc, stuckWindow) == 1)
        {
            sc.stuck   <- 1
            sc.stuckAt <- sc.level
            done <- 1
        }
        trialNum <- trialNum + 1
    }

    est <- SCEstimate(sc, skipFirst)
    StoreAdaptCalibrationSC(blockCfg, est, stepDown)
    ShowAdaptResultSC(blockCfg, est, stepDown, sc)
}


define StoreAdaptCalibrationSC(blockCfg, est, stepDown)
{
    loVal <- est
    ## Hi (easy) is pinned to a fixed trivially-easy level, not derived from the threshold.
    ## sc_hi_level in JSON overrides; defaults: visual=2 jitter_sd, audio=1.0 (full gain).
    hiVal <- 2.0
    if(blockCfg.channel == "audio") { hiVal <- 1.0 }
    if(blockCfg.sc_hi_level >= 0) { hiVal <- blockCfg.sc_hi_level }
    if(blockCfg.channel == "visual")
    {
        gVisJitterLo   <- loVal
        gVisJitterHi   <- hiVal
        gVisCalibrated <- 1
    } else {
        gAudGainLo     <- loVal
        gAudGainHi     <- hiVal
        gAudCalibrated <- 1
    }
    Print("SFT calib " + blockCfg.channel + " hi=" + hiVal + " lo=" + loVal +
          " (staircase est=" + est + ")")
}


define ShowAdaptResultSC(blockCfg, est, stepDown, sc)
{
    loVal <- est
    hiVal <- 2.0
    if(blockCfg.channel == "audio") { hiVal <- 1.0 }
    if(blockCfg.sc_hi_level >= 0) { hiVal <- blockCfg.sc_hi_level }
    kind  <- blockCfg.channel

    stuckNote <- ""
    if(sc.stuck == 1) { stuckNote <- "<li><i>Note: staircase hit boundary — estimate may be less reliable.</i>" }

    msg <- "<h3=center>Calibration done (" + kind + ")</h3>" +
           "Easy (hi) level: <b>" + Round(hiVal * 10) / 10.0 + "</b><li>" +
           "Hard (lo) level: <b>" + Round(loVal * 10) / 10.0 + "</b> (staircase threshold estimate)<li>" +
           "Trials: " + sc.nTrials + " &nbsp; Reversals: " + sc.nReversals +
           stuckNote +
           "<li>These levels will be used in the remaining blocks."

    tbW <- Round(gVideoWidth * 0.55)
    tbH <- Round(gVideoHeight * 0.45)
    tbX <- Round((gVideoWidth - tbW) / 2)
    tbY <- Round(gVideoHeight * 0.18)
    tb  <- EasyTextBox(msg, tbX, tbY, gWin, 16, tbW, tbH)
    SetProperty(tb, "FORMATTED", 1)
    AddObject(gClickLbl, gWin)
    Move(gClickLbl, Round(gVideoWidth / 2), Round(tbY + tbH + 30))
    Draw()
    WaitForClickOnTarget([gClickLbl], [1])
    RemoveObject(tb, gWin)
    RemoveObject(gClickLbl, gWin)
    Draw()
}


## Show YES/NO UI, optionally play vessel at gain (isSignal=1) or nothing (isSignal=0).
## Clip is gated to gTaskStimMs when set (>0); response may come after offset.
define MOLAskDetected(vessel, gain, isSignal, phaseLbl)
{
    btnFont  <- MakeFont(gPEBLBaseFont, 1, 28, MakeColor("white"), MakeColor("black"), 0)
    infoFont <- MakeFont(gPEBLBaseFont, 0, 20, MakeColor("white"), MakeColor("black"), 0)
    yesCol   <- MakeColorRGB(40, 160, 60)
    noCol    <- MakeColorRGB(160, 50, 40)
    btnW     <- Round(gVideoWidth * 0.18)
    btnH     <- 64
    gap      <- Round(gVideoWidth * 0.12)
    cy       <- Round(gVideoHeight * 0.75)
    cx       <- Round(gVideoWidth / 2)

    yesBtn  <- Rectangle(cx - gap, cy, btnW, btnH, yesCol, 1)
    noBtn   <- Rectangle(cx + gap, cy, btnW, btnH, noCol,  1)
    yesLbl  <- MakeLabel("YES — I hear it", btnFont)
    noLbl   <- MakeLabel("NO — silence",    btnFont)
    infoLbl <- MakeLabel("Listening for: " + vessel.name + "   " + phaseLbl, infoFont)
    AddObject(yesBtn,  gWin)
    AddObject(noBtn,   gWin)
    AddObject(yesLbl,  gWin)
    AddObject(noLbl,   gWin)
    AddObject(infoLbl, gWin)
    Move(yesLbl,  cx - gap, cy)
    Move(noLbl,   cx + gap, cy)
    Move(infoLbl, cx, gDispY - gPanelHalfH - 50)

    if(isSignal == 1)
    {
        SetSoundLevel(vessel.snd, gain)
        SetPlayRepeats(vessel.snd, -1)
        PlayBackground(vessel.snd)
    }
    Draw()

    resp <- 0
    if(gTaskStimMs > 0 and isSignal == 1)
    {
        resp <- WaitForClickOnTargetWithTimeout([yesBtn, noBtn], [1, 0], gTaskStimMs)
        if(isSignal == 1) { Stop(vessel.snd) }
        if(resp == "<timeout>")
        {
            Draw()
            resp <- WaitForClickOnTarget([yesBtn, noBtn], [1, 0])
        }
    } else {
        resp <- WaitForClickOnTarget([yesBtn, noBtn], [1, 0])
        if(isSignal == 1) { Stop(vessel.snd) }
    }

    RemoveObject(yesBtn,  gWin)
    RemoveObject(noBtn,   gWin)
    RemoveObject(yesLbl,  gWin)
    RemoveObject(noLbl,   gWin)
    RemoveObject(infoLbl, gWin)
    Draw()

    return(resp)
}


## Present one signal trial and one catch (silent) trial in random order at a given gain.
## Returns 1 if participant correctly detected signal AND correctly rejected catch, else 0.
## Catch trial uses gain=0 (silence). Writes two rows to dataFile.
define MOLPairAtGain(vessel, gain, phase, blockCfg, dataFile, trialNum)
{
    ## Randomise order: signalFirst=1 → signal then catch; 0 → catch then signal
    signalFirst <- RandomDiscrete(2) - 1
    hitSignal   <- 0
    rejectCatch <- 0

    if(signalFirst == 1)
    {
        hitSignal   <- MOLAskDetected(vessel, gain, 1, phase + " [signal]")
        FilePrint(dataFile, blockCfg.id + "," + vessel.id + "," + vessel.name + "," +
                  trialNum + "," + phase + ",signal," + gain + "," + hitSignal)
        trialNum <- trialNum + 1
        Wait(blockCfg.isi)
        catchResp   <- MOLAskDetected(vessel, 0, 0, phase + " [catch]")
        rejectCatch <- 1 - catchResp
        FilePrint(dataFile, blockCfg.id + "," + vessel.id + "," + vessel.name + "," +
                  trialNum + "," + phase + ",catch,0," + catchResp)
        trialNum <- trialNum + 1
        Wait(blockCfg.isi)
    } else {
        catchResp   <- MOLAskDetected(vessel, 0, 0, phase + " [catch]")
        rejectCatch <- 1 - catchResp
        FilePrint(dataFile, blockCfg.id + "," + vessel.id + "," + vessel.name + "," +
                  trialNum + "," + phase + ",catch,0," + catchResp)
        trialNum <- trialNum + 1
        Wait(blockCfg.isi)
        hitSignal   <- MOLAskDetected(vessel, gain, 1, phase + " [signal]")
        FilePrint(dataFile, blockCfg.id + "," + vessel.id + "," + vessel.name + "," +
                  trialNum + "," + phase + ",signal," + gain + "," + hitSignal)
        trialNum <- trialNum + 1
        Wait(blockCfg.isi)
    }

    bothCorrect <- 0
    if(hitSignal == 1 and rejectCatch == 1) { bothCorrect <- 1 }
    return([bothCorrect, trialNum])
}


## Descending MOL for one vessel using a pre-built level list (high→low).
## At each level: signal + catch pair in random order.
## Stops on first level where either response is wrong.
## Returns last-correctly-detected gain (rough threshold) and updated trialNum.
define MOLDescend(vessel, levels, phase, blockCfg, dataFile, trialNum)
{
    nLevels  <- Length(levels)
    lastYes  <- Nth(levels, 1)
    thresh   <- Nth(levels, nLevels)
    detected <- 1
    lIdx     <- 1

    while(lIdx <= nLevels and detected == 1)
    {
        gain     <- Nth(levels, lIdx)
        r        <- MOLPairAtGain(vessel, gain, phase + " (" + lIdx + "/" + nLevels + ")", blockCfg, dataFile, trialNum)
        detected <- Nth(r, 1)
        trialNum <- Nth(r, 2)
        if(detected == 1) { lastYes <- gain }
        lIdx <- lIdx + 1
    }
    ## If missed at some level, thresh = last heard before miss. If never missed, thresh = lastYes (minimum tested).
    thresh <- lastYes
    return([thresh, trialNum])
}


## Ascending MOL for one vessel using fine steps.
## At each level: signal + catch pair. Needs molReps consecutive correct pairs to confirm.
## Returns confirmed gain and updated trialNum.
define MOLAscend(vessel, startGain, fineStep, molReps, phase, blockCfg, dataFile, trialNum)
{
    gain    <- startGain
    yesRun  <- 0
    done    <- 0
    maxGain <- 1.0
    result  <- startGain

    while(done == 0)
    {
        r        <- MOLPairAtGain(vessel, gain, phase, blockCfg, dataFile, trialNum)
        detected <- Nth(r, 1)
        trialNum <- Nth(r, 2)
        if(detected == 1)
        {
            yesRun <- yesRun + 1
            if(yesRun >= molReps)
            {
                result <- gain
                done   <- 1
            }
        } else {
            yesRun <- 0
            gain   <- gain * fineStep
            if(gain > maxGain)
            {
                gain   <- maxGain
                result <- maxGain
                done   <- 1
            }
        }
    }
    return([result, trialNum])
}


## Method-of-limits audio calibration per vessel, no interleaving.
## Sequence per vessel: coarse-descend → fine-ascend → fine-descend → fine-ascend.
## Final lo = confirmed ascending threshold × fineStep^mol_lo_offset (above threshold).
define RunMOLBlock(blockCfg, vessels, noiseImgs, dispY, offscreenX, dataFile)
{
    gCurrentChannel <- "audio"
    gCurrentAudGain <- 1.0

    molLevels       <- blockCfg.mol_levels
    fineStep        <- blockCfg.mol_fine_step
    fineStartFactor <- blockCfg.mol_fine_start_factor
    molReps         <- blockCfg.mol_reps
    loOffset        <- blockCfg.mol_lo_offset
    maxGain         <- 1.0

    loGains  <- []
    trialNum <- 1

    loop(vessel, vessels)
    {
        ## Round 1: coarse descend — bracket the threshold
        r1 <- MOLDescend(vessel, molLevels, "descend-coarse", blockCfg, dataFile, trialNum)
        roughThresh <- Nth(r1, 1)
        trialNum    <- Nth(r1, 2)

        ## Round 2: fine ascend from one coarse step below threshold
        ## roughThresh is last-heard level; start from one step below it
        startGain <- roughThresh / fineStep
        r2 <- MOLAscend(vessel, startGain, fineStep, molReps, "ascend-fine", blockCfg, dataFile, trialNum)
        loGain   <- Nth(r2, 1)
        trialNum <- Nth(r2, 2)

        ## Apply lo_offset steps above confirmed threshold
        offsetMult <- 1.0
        i <- 1
        while(i <= loOffset)
        {
            offsetMult <- offsetMult * fineStep
            i <- i + 1
        }
        loGain <- loGain * offsetMult
        if(loGain > maxGain) { loGain <- maxGain }

        PushOnEnd(loGains, loGain)
    }

    ## Store per-vessel lo gains indexed by vessel.id (1-based)
    gAudGainLoPerVessel <- loGains
    gAudGainHi          <- 1.0
    gAudCalibrated      <- 1
    gAudMOLCalibrated   <- 1

    ## Show results
    resultFont <- MakeFont(gPEBLBaseFont, 1, 22, MakeColor("white"), MakeColor("black"), 0)
    clickLbl   <- MakeLabel("Click to continue", resultFont)
    msgObjs    <- []
    mIdx <- 1
    loop(vessel, vessels)
    {
        loG <- Nth(loGains, mIdx)
        msg <- MakeLabel(vessel.name + " lo level: " + Round(loG * 1000) / 1000.0, resultFont)
        AddObject(msg, gWin)
        Move(msg, Round(gVideoWidth / 2), Round(gVideoHeight * 0.40) + (mIdx - 1) * 36)
        PushOnEnd(msgObjs, msg)
        mIdx <- mIdx + 1
    }
    AddObject(clickLbl, gWin)
    Move(clickLbl, Round(gVideoWidth / 2), Round(gVideoHeight * 0.65))
    Draw()
    WaitForClickOnTarget([clickLbl], [1])
    loop(m, msgObjs) { RemoveObject(m, gWin) }
    RemoveObject(clickLbl, gWin)
    Draw()
}


## Exact vessel schedule from vessel_counts (vessel-list order), then Shuffle.
## Returns [] when counts are absent / mismatched so callers fall back to PickVessel.
## Example: vessels [Kilo-A, Biological, Kilo-B] + counts [5, 10, 5] → 20 ids, shuffled.
define BuildVesselIdSchedule(blockCfg, vessels)
{
    ids <- []
    nV  <- Length(vessels)
    if(blockCfg.has_vessel_counts == 1 and Length(blockCfg.vessel_counts) == nV)
    {
        i <- 1
        loop(cnt, blockCfg.vessel_counts)
        {
            v <- Nth(vessels, i)
            j <- 1
            while(j <= cnt)
            {
                PushOnEnd(ids, v.id)
                j <- j + 1
            }
            i <- i + 1
        }
        ids <- Shuffle(ids)
    }
    return(ids)
}


## Exact noise-profile index schedule from noise_profiles[].count, then Shuffle.
## Returns [] when profiles are absent. Length must equal nCases (caller validates).
define BuildNoiseProfileSchedule(blockCfg, nCases)
{
    idxs <- []
    if(blockCfg.has_noise_profiles == 1)
    {
        pIdx <- 1
        loop(prof, blockCfg.noise_profiles)
        {
            j <- 1
            while(j <= prof.count)
            {
                PushOnEnd(idxs, pIdx)
                j <- j + 1
            }
            pIdx <- pIdx + 1
        }
        idxs <- Shuffle(idxs)
        if(Length(idxs) != nCases)
        {
            SignalFatalError("noise_profiles schedule length " + Length(idxs) + " != nCases " + nCases + " (block " + blockCfg.id + ")")
        }
    }
    return(idxs)
}


## Build a fixed base set of trial cases.
## Length = sum(vessel_counts) when counts are set, else blockCfg.trials
## (or sum of noise_profiles counts when that alone defines N).
## Each case stores vessel_id, template_idx, and the already-generated sig so
## ShuffleRepeat replays the identical stimulus (not a fresh jitter draw).
## Multi-template vessels cycle templates round-robin (balanced, not random).
## Optional noise_profiles assign per-case signal_params (override block-level).
## Random-gen classes (template kind "random") are slots in that cycle — not a
## separate outlier_p draw. Call after SeedRNG for reproducibility.
define BuildTrialCaseList(blockCfg, vessels)
{
    schedule <- BuildVesselIdSchedule(blockCfg, vessels)
    useSchedule <- 0
    n <- blockCfg.trials
    if(Length(schedule) > 0)
    {
        useSchedule <- 1
        n <- Length(schedule)
        blockCfg.trials <- n
    }

    noiseSched <- BuildNoiseProfileSchedule(blockCfg, n)
    useNoise <- 0
    if(Length(noiseSched) > 0) { useNoise <- 1 }

    ## Round-robin template cursors (1-based) per vessel object.
    loop(v, vessels)
    {
        v.tmpl_rr <- 1
    }

    cases <- []
    i <- 1
    while(i <= n)
    {
        if(useSchedule == 1)
        {
            vid <- Nth(schedule, i)
        } else {
            vid <- PickVessel(blockCfg, vessels)
        }
        v   <- GetVessel(vid, vessels)
        tIdx <- 0
        if(v.n_templates > 0)
        {
            tIdx <- v.tmpl_rr
            v.tmpl_rr <- v.tmpl_rr + 1
            if(v.tmpl_rr > v.n_templates) { v.tmpl_rr <- 1 }
        }
        v.forced_template_idx <- tIdx

        params <- blockCfg.signal_params
        pIdx <- 0
        if(useNoise == 1)
        {
            pIdx <- Nth(noiseSched, i)
            params <- Nth(blockCfg.noise_profiles, pIdx)
        }

        sig <- GenerateSignal(vid, blockCfg.signal_mode, params, vessels)
        c <- MakeCustomObject("trialcase")
        c.instance_id <- i
        c.vessel_id <- vid
        c.template_idx <- tIdx
        c.template_name <- gLastActiveTemplate
        ## Pre-jitter prototype for CSV base_sig (forced_sig is jittered actual).
        c.base_sig <- CopyList(v.active_sig)
        c.sig <- CopyList(sig)
        c.jitter_sd <- params.jitter_sd
        c.noise_profile_idx <- pIdx
        c.signal_params <- CopySignalParams(params)
        PushOnEnd(cases, c)
        i <- i + 1
    }
    return(cases)
}


## Apply a pre-built case for the next RunTrial (forced vessel + template + sig).
## Also applies per-case noise profile to signal_params / gCurrentJitter when set.
define ApplyTrialCase(blockCfg, vessels, caseObj)
{
    blockCfg.instance_id <- caseObj.instance_id
    blockCfg.forced_vessel_id <- caseObj.vessel_id
    blockCfg.forced_template_idx <- caseObj.template_idx
    blockCfg.has_forced_sig <- 1
    blockCfg.forced_sig <- caseObj.sig
    v <- GetVessel(caseObj.vessel_id, vessels)
    v.forced_template_idx <- caseObj.template_idx
    v.active_template <- caseObj.template_name
    gLastActiveTemplate <- caseObj.template_name
    if(PropertyExists(caseObj, "base_sig"))
    {
        v.active_sig <- CopyList(caseObj.base_sig)
    } else {
        ## Legacy cases built before base_sig was stored: recover fixed template.
        if(caseObj.template_idx > 0 and caseObj.template_idx <= v.n_templates)
        {
            tKind <- Nth(v.template_kinds, caseObj.template_idx)
            if(tKind != "random")
            {
                bs <- Nth(v.templates, caseObj.template_idx)
                if(Length(bs) > 0) { v.active_sig <- CopyList(bs) }
            }
        }
    }

    if(PropertyExists(caseObj, "signal_params"))
    {
        blockCfg.signal_params <- CopySignalParams(caseObj.signal_params)
        gCurrentJitter <- caseObj.jitter_sd
    } else {
        if(PropertyExists(caseObj, "jitter_sd"))
        {
            blockCfg.signal_params.jitter_sd <- caseObj.jitter_sd
            gCurrentJitter <- caseObj.jitter_sd
        }
    }
}


define ClearTrialCaseForce(blockCfg, vessels)
{
    if(blockCfg.forced_vessel_id > 0)
    {
        v <- GetVessel(blockCfg.forced_vessel_id, vessels)
        v.forced_template_idx <- 0
    }
    blockCfg.forced_vessel_id <- 0
    blockCfg.forced_template_idx <- 0
    blockCfg.has_forced_sig <- 0
    blockCfg.forced_sig <- []
    ## Restore block-level noise after a per-case override.
    if(PropertyExists(blockCfg, "default_signal_params"))
    {
        blockCfg.signal_params <- CopySignalParams(blockCfg.default_signal_params)
        gCurrentJitter <- blockCfg.default_signal_params.jitter_sd
    }
}


define RunBlock(blockCfg, vessels, noiseImgs, dispY, fbY, offscreenX, dataFile)
{
    ## Prefer randomseed; seed is an alias parsed into both fields.
    rs <- blockCfg.randomseed
    if(rs == 0) { rs <- blockCfg.seed }
    if(rs != 0) { SeedRNG(rs) }

    gBlockScore <- 0
    gBlockNCorrect <- 0
    gBlockNTrials <- 0
    scoringOn <- 0
    if(blockCfg.scoring == "confidence") { scoringOn <- 1 }
    if(blockCfg.scoring == "outcome") { scoringOn <- 1 }
    if(blockCfg.feedback == "payoff") { scoringOn <- 1 }
    if(scoringOn == 1)
    {
        ## starting_score applies at first scored block (or when feedback is payoff).
        if(blockCfg.feedback == "payoff" or gCumulScore == 0)
        {
            if(blockCfg.starting_score != 0 or blockCfg.feedback == "payoff")
            {
                gCumulScore <- blockCfg.starting_score
            }
        }
        if(blockCfg.feedback != "none")
        {
            gScoreHUD.text <- "Score: " + gCumulScore
            Draw()
        }
    }

    extra <- SetupMode(blockCfg, vessels)

    ruleToShow <- DefaultRuleForMode(blockCfg.response_mode, vessels)
    if(blockCfg.rule_text != "") { ruleToShow <- blockCfg.rule_text }
    if(ruleToShow != "") { SetTaskRule(ruleToShow) }

    if(blockCfg.adaptive == 1)
    {
        RunAdaptiveBlock(blockCfg, vessels, noiseImgs, dispY, fbY, offscreenX, dataFile)
    } else {
    if(blockCfg.adaptive == "mol")
    {
        RunMOLBlock(blockCfg, vessels, noiseImgs, dispY, offscreenX, dataFile)
    } else {
        if(blockCfg.response_mode == "reversal")
        {
            RunReversalBlock(blockCfg, vessels, noiseImgs, dispY, fbY, offscreenX, dataFile)
        } else {
            savedFeedback <- blockCfg.feedback
            trialNum <- 1
            nReps <- blockCfg.repetitions
            if(nReps < 1) { nReps <- 1 }

            ## Case-list path when repetitions > 1 (replay identical stims),
            ## vessel_counts is set (exact class counts + shuffle), OR
            ## noise_profiles is set (per-case signal_params overrides).
            ## Otherwise fall back to per-trial PickVessel (probabilistic).
            useCases <- 0
            if(nReps > 1) { useCases <- 1 }
            if(blockCfg.has_vessel_counts == 1) { useCases <- 1 }
            if(blockCfg.has_noise_profiles == 1) { useCases <- 1 }

            if(useCases == 1)
            {
                ## Ensure restore baseline matches block defaults after ApplySftStimulus.
                blockCfg.default_signal_params <- CopySignalParams(blockCfg.signal_params)
                cases <- BuildTrialCaseList(blockCfg, vessels)
                nBase <- Length(cases)
                ## nReps==1: present each case once in shuffled count order.
                ## nReps>1: ShuffleRepeat the base indices, then replay cases.
                ord <- Sequence(1, nBase, 1)
                if(nReps > 1)
                {
                    ord <- Flatten(ShuffleRepeat(Sequence(1, nBase, 1), nReps))
                }
                loop(idx, ord)
                {
                    if(trialNum <= blockCfg.burn_in)
                    {
                        blockCfg.feedback <- "accuracy"
                    } else {
                        blockCfg.feedback <- savedFeedback
                    }
                    caseObj <- Nth(cases, idx)
                    ApplyTrialCase(blockCfg, vessels, caseObj)
                    trialResult <- RunModeTrial(blockCfg, vessels, noiseImgs, dispY, fbY, offscreenX, dataFile, trialNum)
                    ClearTrialCaseForce(blockCfg, vessels)
                    if(Length(trialResult) > 0)
                    {
                        LogTrial(dataFile, blockCfg, trialNum, trialResult, vessels)
                    }
                    trialNum <- trialNum + 1
                }
            } else {
                while(trialNum <= blockCfg.trials)
                {
                    ## Burn-in: override feedback to accuracy for first burn_in trials
                    if(trialNum <= blockCfg.burn_in)
                    {
                        blockCfg.feedback <- "accuracy"
                    } else {
                        blockCfg.feedback <- savedFeedback
                    }
                    ## One presentation per case when repetitions==1.
                    blockCfg.instance_id <- trialNum
                    trialResult <- RunModeTrial(blockCfg, vessels, noiseImgs, dispY, fbY, offscreenX, dataFile, trialNum)
                    if(Length(trialResult) > 0)
                    {
                        LogTrial(dataFile, blockCfg, trialNum, trialResult, vessels)
                    }
                    trialNum <- trialNum + 1
                }
            }
            blockCfg.feedback <- savedFeedback
        }
    }
    }

    ClearTaskRule()
    ShowBlockScoreSummary(blockCfg)
    TeardownMode(blockCfg, vessels, extra)
}


